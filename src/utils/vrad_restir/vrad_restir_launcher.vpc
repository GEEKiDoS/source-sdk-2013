//-----------------------------------------------------------------------------\n// VRAD_RESTIR_LAUNCHER.VPC\n//-----------------------------------------------------------------------------\n
$Macro SRCDIR "..\.."
$Macro OUTBINDIR "$SRCDIR\..\game\bin"
$Macro OUTBINNAME "vrad_restir"
$Include "$SRCDIR\vpc_scripts\source_exe_con_base.vpc"

// The DLL project lives in this folder too; keep the two build trees apart.
$Configuration	"Debug"
{
	$General
	{
		$OutputDirectory			".\Debug_$OUTBINNAME$_SUBDIRSUFFIX"
		$IntermediateDirectory	".\Debug_$OUTBINNAME$_SUBDIRSUFFIX"
	}
}

$Configuration	"Release"
{
	$General
	{
		$OutputDirectory			".\Release_$OUTBINNAME$_SUBDIRSUFFIX"
		$IntermediateDirectory	".\Release_$OUTBINNAME$_SUBDIRSUFFIX"
	}
}

$Configuration
{
	$Compiler
	{
		$Create/UsePrecompiledHeader "Use Precompiled Header (/Yu)"
		$Create/UsePCHThroughFile "stdafx.h"
		$PrecompiledHeaderFile "$(IntDir)/vrad_restir_launcher.pch"
	}
}

$Project "VRAD ReSTIR (Launcher)"
{
	$Folder "Source Files"
	{
		-$File "$SRCDIR\public\tier0\memoverride.cpp"
		$File "vrad_restir_launcher.cpp"
		$File "stdafx.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader "Create Precompiled Header (/Yc)"
				}
			}
		}
	}
	$Folder "Header Files"
	{
		$File "$SRCDIR\public\tier1\interface.h"
		$File "$SRCDIR\public\ivraddll.h"
		$File "stdafx.h"
	}
}
