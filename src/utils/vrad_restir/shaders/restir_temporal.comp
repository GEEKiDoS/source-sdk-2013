#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#if RESTIR_HW_RAYQUERY
#extension GL_EXT_ray_query : require
#endif
#include "restir_layout.glsl"
#include "restir_common.glsl"
#include "restir_trace.glsl"
#include "restir_lights.glsl"
layout( local_size_x = RESTIR_WORKGROUP_SIZE ) in;

// Bitterli et al. 2020 temporal RIS: re-evaluate the history sample at the current receiver with
// the SAME target function as candidate generation (unshadowed radiance * cosine * visibility),
// clamp the history count without changing the history estimator's W.
void main()
{
	uint index = pc.first + gl_GlobalInvocationID.x;
	if ( index >= pc.first + pc.count )
		return;
	uint faceIndex;
	uint sampleIndex;
	uint slot;
	ResolveReservoir( index, faceIndex, sampleIndex, slot );
	ReSTIRGpuFace face = faces[faceIndex];
	ReSTIRGpuSample sampleRecord = samples[sampleIndex];
	vec3 origin = ShadingOrigin( face, sampleRecord );
	ReSTIRReservoir previous = reservoirsPrev[index];
	float historyCount = min( previous.M, 20.0 * float( pc.candidates ) );
	ReSTIRReservoir candidate = previous;
	float target = 0.0;
	if ( ( previous.flags & RESTIR_RES_VALID ) != 0u )
	{
		candidate = Reevaluate( previous, origin, sampleRecord.normal.xyz );
		if ( candidate.radiance.w > 0.0 && ReservoirVisibility( candidate, origin ) )
		{
			candidate.flags |= RESTIR_RES_VISIBLE;
			target = candidate.radiance.w;
		}
		else
		{
			candidate.radiance.w = 0.0;
		}
	}
	ReSTIRReservoir result = reservoirsCur[index];
	uint rng = SampleSeed( faceIndex, sampleIndex - uint( face.firstSample ), slot, 0x54454D50u );
	ReservoirUpdate( result, candidate, target * previous.W * historyCount, historyCount, rng );
	ReservoirNormalize( result );
	reservoirsCur[index] = result;
}
