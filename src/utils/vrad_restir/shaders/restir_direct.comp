#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#if RESTIR_HW_RAYQUERY
#extension GL_EXT_ray_query : require
#endif
#include "restir_layout.glsl"
#include "restir_common.glsl"
#include "restir_trace.glsl"
#include "restir_lights.glsl"
layout( local_size_x = RESTIR_WORKGROUP_SIZE ) in;

// Point and spot lights are delta sources: their direct light at a sample is one radiance
// evaluation and one shadow ray, with nothing to sample. Like VRAD (lightmap.cpp:1835-1977,
// every light for every sample) this pass evaluates all of them exactly, once per bake.
// Pass 0 (before the iterations): the style-0 base irradiance of each sample, which seeds the
//   bounce feedback (directIrradiance); the sampled sums it is added to start at zero.
// Pass 1 (after the iterations): add the exact sums to both accumulations, scaled by their
//   iteration count so the reconstructed mean is exact direct + mean of the sampled terms.
// Static prop triangles are small diffuse patches without a lightmap. Cache a
// full-source style-0 estimate (selected runtime lights also generate bounce).
void BakePropPatch( uint index )
{
	ReSTIRGpuTriangle tri = triangles[index];
	if ( ( tri.flags & RESTIR_TRI_STATICPROP ) == 0u )
		return;
	vec3 n = SafeNormal( cross( tri.v1.xyz - tri.v0.xyz, tri.v2.xyz - tri.v0.xyz ) );
	vec3 origin = ( tri.v0.xyz + tri.v1.xyz + tri.v2.xyz ) / 3.0 + n * RESTIR_DIST_EPSILON;
	vec3 irradiance = vec3( 0.0 );
	for ( uint i = 0u; i < pc.numLights; ++i )
	{
		ReSTIRGpuLight light = lights[i];
		if ( light.style != 0 )
			continue;
		uint count = light.type == EMIT_SURFACE || light.type == EMIT_SKYAMBIENT ? pc.candidates : 1u;
		uint key = Hash( pc.seed ^ Hash( index ) ^ i );
		for ( uint k = 0u; k < count; ++k )
		{
			vec3 u = vec3( ( float( k ) + 0.5 ) / float( count ), SobolPoint( k, uvec2( key, Hash( key ) ) ) );
			ReSTIRLightSample s;
			if ( SampleLight( i, origin, n, u, s ) && s.radiance.w > 0.0 && s.sourcePdf > 0.0 &&
				LightVisibility( i, origin, s.samplePos.xyz, s.emitterTri, RESTIR_NO_HIT ) )
				irradiance += s.radiance.rgb * max( dot( n, SafeNormal( s.samplePos.xyz - origin ) ), 0.0 ) / ( s.sourcePdf * float( count ) );
		}
	}
	propExitance[index] = vec4( irradiance * materials[tri.material].reflectivity.rgb, 0.0 );
}

// A nearby masked emitter may occupy thousands of triangles; selecting it
// uniformly from a map-wide list gives it only a handful of visits per bounce
// generation. Allocate samples by receiver-dependent power / distance^2.
float SurfacePriority( ReSTIRGpuLight light, vec3 origin, vec3 normal )
{
	vec3 offset = light.origin.xyz - origin;
	float radius = light.attenuation.x;
	if ( light.numTris <= 0 || dot( offset, normal ) < -radius )
		return 0.0;
	float distance = max( length( offset ) - radius, 1.0 );
	// Power is estimated from the material. Use it only for allocation, not
	// a cutoff: even a dark or partially masked emitter gets a sample.
	return clamp( light.intensity.w / ( distance * distance ), 0.0001, 255.0 );
}

void main()
{
	uint index = pc.first + gl_GlobalInvocationID.x;
	if ( index >= pc.first + pc.count )
		return;
	if ( pc.pass == 2u )
	{
		BakePropPatch( index );
		return;
	}
	uint faceIndex;
	uint sampleIndex;
	uint slot;
	ResolveReservoir( index, faceIndex, sampleIndex, slot );
	if ( pc.pass == 0u && slot != 0u )
		return;
	ReSTIRGpuFace face = faces[faceIndex];
	ReSTIRGpuSample sampleRecord = samples[SampleAddress( sampleIndex )];
	vec3 origin = ShadingOrigin( face, sampleRecord );
	int numChannels = pc.pass == 0u ? 1 : face.numChannels;
	precise vec3 full[RESTIR_MAX_CHANNELS];
	precise vec3 receiver[RESTIR_MAX_CHANNELS];
	for ( int channel = 0; channel < RESTIR_MAX_CHANNELS; ++channel )
		full[channel] = receiver[channel] = vec3( 0.0 );
	uint first;
	uint surfaceFirst;
	uint end;
	StyleLights( face.styles[slot], first, surfaceFirst, end );
	for ( uint entry = first; entry < surfaceFirst; ++entry )
	{
		uint lightIndex = uint( styleLights[entry] );
		ReSTIRGpuLight light = lights[lightIndex];
		vec3 radiance = StandardLightRadiance( light, origin, light.origin.xyz );
		vec3 direction = SafeNormal( light.origin.xyz - origin );
		// Same admission as a sampled light: the base normal must face it.
		if ( Luminance( radiance ) * max( dot( sampleRecord.normal.xyz, direction ), 0.0 ) <= 0.0 )
			continue;
		if ( !LightVisibility( lightIndex, origin, light.origin.xyz, RESTIR_NO_HIT, RESTIR_NO_HIT ) )
			continue;
		bool runtimeDirect = ( light.lightFlags & RESTIR_LIGHT_RUNTIME_DIRECT ) != 0;
		for ( int channel = 0; channel < numChannels; ++channel )
		{
			precise vec3 contribution = radiance * max( dot( ChannelNormal( sampleRecord, channel ), direction ), 0.0 );
			full[channel] += contribution;
			if ( !runtimeDirect )
				receiver[channel] += contribution;
		}
	}
	// Direct is invariant across bounce generations. Seed feedback with the
	// whole-bake estimate, then replay it for the reconstructed planes.
	float prioritySum = 0.0;
	for ( uint entry = surfaceFirst; entry < end; ++entry )
		prioritySum += SurfacePriority( lights[styleLights[entry]], origin, sampleRecord.normal.xyz );
	float budget = float( min( pc.candidates * pc.totalIterations, 8192u ) ) / max( prioritySum, 32.0 );
	for ( uint entry = surfaceFirst; entry < end; ++entry )
	{
		uint lightIndex = uint( styleLights[entry] );
		float priority = SurfacePriority( lights[lightIndex], origin, sampleRecord.normal.xyz );
		if ( priority == 0.0 )
			continue;
		uint count = max( 1u, uint( ceil( budget * priority ) ) );
		uint key = SampleStream( faceIndex, sampleIndex - uint( face.firstSample ), slot, lightIndex );
		float shift = float( key >> 8u ) * ( 1.0 / 16777216.0 );
		for ( uint k = 0u; k < count; ++k )
		{
			vec3 u = vec3( fract( Halton( k, 3u ) + shift ), SobolPoint( k, uvec2( Hash( key ), Hash( key ^ 1u ) ) ) );
			ReSTIRLightSample candidate;
			if ( !SampleLight( lightIndex, origin, sampleRecord.normal.xyz, u, candidate ) || candidate.radiance.w <= 0.0 ||
				!LightVisibility( lightIndex, origin, candidate.samplePos.xyz, candidate.emitterTri, RESTIR_NO_HIT ) )
				continue;
			vec3 direction = SafeNormal( candidate.samplePos.xyz - origin );
			vec3 value = candidate.radiance.rgb / ( float( count ) * candidate.sourcePdf );
			for ( int channel = 0; channel < numChannels; ++channel )
			{
				precise vec3 contribution = value * max( dot( ChannelNormal( sampleRecord, channel ), direction ), 0.0 );
				full[channel] += contribution;
				receiver[channel] += contribution; // area lights have no runtime direct counterpart
			}
		}
	}
	if ( pc.pass == 0u )
	{
		directIrradiance[sampleIndex] = vec4( full[0], 1.0 );
		previousIrradiance[sampleIndex] = vec4( 0.0 );
		return;
	}
	bool split = receiverAccumulation.length() > 1;
	uint receiverIndex = ( pc.flags & RESTIR_PC_RECEIVER_PAGE ) != 0u ? index - pc.pageBase.x : index;
	for ( int channel = 0; channel < numChannels; ++channel )
	{
		uint address = AccumulationAddress( index ) + uint( channel );
		vec4 sum = accumulation[address];
		accumulation[address] = vec4( sum.rgb + full[channel] * sum.w, sum.w );
		if ( split )
		{
			uint receiverAddress = receiverIndex * RESTIR_MAX_CHANNELS + uint( channel );
			vec4 receiverSum = receiverAccumulation[receiverAddress];
			receiverAccumulation[receiverAddress] = vec4( receiverSum.rgb + receiver[channel] * receiverSum.w, receiverSum.w );
		}
	}
}
