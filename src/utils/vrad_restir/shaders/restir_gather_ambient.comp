#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#if RESTIR_HW_RAYQUERY
#extension GL_EXT_ray_query : require
#endif
#include "restir_layout.glsl"
#include "restir_common.glsl"
#include "restir_trace.glsl"
#include "restir_lightmap.glsl"
layout( std430, set = 0, binding = 15 ) readonly buffer ServiceIn { ReSTIRGpuAmbientQuery queries[]; };
layout( std430, set = 0, binding = 16 ) buffer ServiceOut { ReSTIRGpuAmbientResult results[]; };
layout( local_size_x = RESTIR_WORKGROUP_SIZE ) in;

// utils/vrad/leaf_ambient_lighting.cpp:139-175. Direct emit_surface additions
// at :177-179 are made by the ambient-cube host after worldlight classification
// (I6); this service deliberately performs ONLY the final lightmap gather.
void main()
{
	uint index = pc.first + gl_GlobalInvocationID.x;
	if ( index >= pc.first + pc.count )
		return;
	vec3 origin = queries[index].position.xyz;
	float totalCosines[6];
	for ( uint box = 0u; box < 6u; ++box )
	{
		totalCosines[box] = 0.0;
		for ( uint slot = 0u; slot < pc.numStyles; ++slot )
			results[index * pc.numStyles + slot].box[box] = vec4( 0.0 );
	}
	for ( uint sampleIndex = 0u; sampleIndex < RESTIR_NUM_ANORMS; ++sampleIndex )
	{
		vec3 direction = anorms[sampleIndex].xyz;
		HitInfo hit;
		bool found = TraceGatherRay( origin, direction, RESTIR_DIST_EPSILON, RESTIR_AMBIENT_LENGTH, hit );
		float cosines[6];
		for ( uint box = 0u; box < 6u; ++box )
		{
			cosines[box] = max( direction[box / 2u] * ( ( box & 1u ) == 0u ? 1.0 : -1.0 ), 0.0 );
			totalCosines[box] += cosines[box];
		}
		if ( found )
		{
			for ( uint slot = 0u; slot < pc.numStyles; ++slot )
			{
				vec3 color = RayAmbientColor( hit, origin, direction, sceneStyles[slot] );
				for ( uint box = 0u; box < 6u; ++box )
					results[index * pc.numStyles + slot].box[box].rgb += color * cosines[box];
			}
		}
	}
	for ( uint box = 0u; box < 6u; ++box )
	{
		for ( uint slot = 0u; slot < pc.numStyles; ++slot )
			results[index * pc.numStyles + slot].box[box].rgb = FiniteRadiance( results[index * pc.numStyles + slot].box[box].rgb / totalCosines[box] );
	}
}
