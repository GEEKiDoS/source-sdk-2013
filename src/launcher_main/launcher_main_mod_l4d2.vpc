$Macro OUTBINNAME "mod_l4d2"

$Conditional "MOD_LAUNCHER" "1"

$Include "launcher_main.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions	"$BASE;L4D2;MOD_APPID=243750" // Replace with your appid if you ship on Steam.
	}
}

$Project "Launcher Main (Mod L4D2)"
{
	$Folder "Resource Files" [$WINDOWS]
	{
		$File	"launcher_main_mod_l4d2.rc"
		$File	"res\mod_l4d2.ico"
	}
}
