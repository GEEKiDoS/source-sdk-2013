//-----------------------------------------------------------------------------
//	GROUPS.VGC
//
//	Group Configurations for all Source(TM) Projects
//-----------------------------------------------------------------------------

///////////////////////
// Group definitions //
///////////////////////

$Group "gamedlls"
{
	"client"
	"server"
}

$Group "game"
{
	"client"
	"launcher_main"
	"gameui_mod"
	"mathlib"
	"matsys_controls"
	"raytrace"
	"server"
	"tier1"
	"vgui_controls"
}

$Group "shaders"
{
	"game_shader_generic_example"
	//"game_shader_generic_std"
	"game_shader_l4d2" [$L4D2]
}

$Group "dx12"
{
	"dx12_shaderconv"
	"unicode"
	"shaderapidx12"
	"nvngx_forwarder_dx12"
	"nativeshaderpack_dx12"
	"stdshader_dx12"
	"tier1"
	"mathlib"
	"launcher_main"
}

// Local hardware smoke harness; utils/shaderapidx12_smoke is kept out of tree, so it is not part of "dx12".
$Group "dx12_smoke"
{
	"shaderapidx12_smoke"
}

// tier0/tier2/vstdlib/bitmap/vtf are prebuilt libraries in this SDK (no project scripts); only
// the buildable dependencies are listed so generation stays warning-free.
$Group "vrad_restir"
{
	"vrad_restir_dll"
	"vrad_restir_launcher"
	"tier1"
	"mathlib"
}

// The merged L4D2 + DX12 tree builds only the L4D2 game DLLs and shader DLL, the DX12 renderer,
// the mod launcher that redirects to it, and the ReSTIR lightmap baker, plus their buildable
// dependencies. Other games and the stock SDK tools (captioncompiler, fgdlib, glview, height2normal,
// motionmapper, phonemeextractor, qc_eyes, serverplugin_empty, tgadiff, vbsp, vice, vrad, vtf2tga,
// vtfdiff, vvis, game_shader_generic_example, shaderapidx12_smoke) keep their scripts in
// projects.vgc but are not selected here.
$Group "everything"
{
	"client"
	"server"
	"game_shader_l4d2" [$L4D2]

	"dx12_shaderconv"
	"unicode"
	"shaderapidx12"
	"nvngx_forwarder_dx12"
	"nativeshaderpack_dx12"
	"stdshader_dx12"
	"launcher_main"
	"gameui_mod"

	"vrad_restir_dll"
	"vrad_restir_launcher"

	"mathlib"
	"matsys_controls"
	"raytrace"
	"tier1"
	"vgui_controls"
}

$Group "dedicated"
{
	"mathlib"
	"server"
	"tier1"
}

