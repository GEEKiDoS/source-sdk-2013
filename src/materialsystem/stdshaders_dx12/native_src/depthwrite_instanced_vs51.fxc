// Native-only instanced twin of hlsl/depthwrite_vs51.fxc for batched opaque shadow casters
// (shaderapidx12 CShaderAPIDX12::FlushShadowCasterBatch). Combo directives and index arithmetic are identical to
// depthwrite_vs51 (static = 8*ONLY_PROJECT_POSITION + 8*COLOR_DEPTH + 16*TREESWAY, dynamic = COMPRESSED_VERTS +
// 2*SKINNING + 4*MORPHING); the backend requests static 0 and dynamic 0..3 only, every other combo is skipped.
// The cModel registers are replaced by per-instance float4 rows (the same registers DX12VSBones.cModel holds,
// translation in .w) read through the vertex-stage root SRV t0 space7 (pipeline kRootInstanceTransforms):
//   rigid:   three rows per instance, cModel[0];
//   SKINNING: 53 * 3 rows per instance, the whole bone palette (only the referenced bones are read).
// No flex, morph, tree sway, texcoord or pixel stage.
#define DX12_LEGACY_VS30 1
#include "dx12_preamble.h"
//	STATIC: "ONLY_PROJECT_POSITION"	"0..0"
//  STATIC: "COLOR_DEPTH"			"0..1"
//  STATIC: "TREESWAY"				"0..2"
//	DYNAMIC: "COMPRESSED_VERTS"		"0..1"
//	DYNAMIC: "SKINNING"				"0..1"
//  DYNAMIC: "MORPHING"				"0..1"
//  SKIP: $COLOR_DEPTH || $TREESWAY || $MORPHING
#include "common_vs_fxc.h"

StructuredBuffer<float4> g_InstanceModelRows : register( t0, space7 );

struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if SKINNING
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#endif
	uint instance : SV_InstanceID;
};
struct VS_OUTPUT
{
	float4 vProjPos : SV_Position;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; no pixel stage)
};

VS_OUTPUT main( const DX12_VS_INPUT i )
{
	// mul4x3( v, cModel[n] ) == float3( dot( v, reg0 ), dot( v, reg1 ), dot( v, reg2 ) ) (common_fxc.h).
#if SKINNING
	// SkinPosition's three-bone blend (common_vs_fxc.h) over this instance's palette.
	// 53 = DX12VSBones.cModel[53] (shaderapidx12 kCasterPaletteBones asserts the same size).
	const uint palette = i.instance * ( 53u * 3u );
#if COMPRESSED_VERTS
	const float4 boneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	const float4 boneWeights = i.vBoneWeights;
#endif
	const int3 bones = D3DCOLORtoUBYTE4( i.vBoneIndices ).xyz;
	float3 weights = DecompressBoneWeights( boneWeights ).xyz;
	weights[2] = 1 - ( weights[0] + weights[1] );
	const uint3 rows = palette + uint3( bones ) * 3u;
	const float4 row0 = g_InstanceModelRows[rows.x] * weights[0] + g_InstanceModelRows[rows.y] * weights[1] + g_InstanceModelRows[rows.z] * weights[2];
	const float4 row1 = g_InstanceModelRows[rows.x + 1u] * weights[0] + g_InstanceModelRows[rows.y + 1u] * weights[1] + g_InstanceModelRows[rows.z + 1u] * weights[2];
	const float4 row2 = g_InstanceModelRows[rows.x + 2u] * weights[0] + g_InstanceModelRows[rows.y + 2u] * weights[1] + g_InstanceModelRows[rows.z + 2u] * weights[2];
#else
	const uint row = i.instance * 3u;
	const float4 row0 = g_InstanceModelRows[row], row1 = g_InstanceModelRows[row + 1u], row2 = g_InstanceModelRows[row + 2u];
#endif
	const float3 vWorldPos = float3( dot( i.vPos, row0 ), dot( i.vPos, row1 ), dot( i.vPos, row2 ) );
	VS_OUTPUT o;
	o.vProjPos = mul( float4( vWorldPos, 1.0f ), cViewProj );
	o.dx12Clip = DX12UserClipDistances( o.vProjPos );
	o.vProjPos = DX12Position( o.vProjPos );
	return o;
}
