// Feature-only detail layout: prelit gamma color, UV, baked gather point,
// authored gather normal/orientation. Card geometry may turn; these do not.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
// DYNAMIC: "DOWATERFOG" "0..1"
#include "common_vs_fxc.h"

struct VS_INPUT
{
	float4 position : POSITION;
	float4 color : COLOR0;
	float2 uv : TEXCOORD0;
	float4 lightingOrigin : TEXCOORD1;
	float4 lightingNormal : TEXCOORD2;
};
struct VS_OUTPUT
{
	float4 position : SV_Position;
	float4 color : COLOR0;
	float2 uv : TEXCOORD0;
	float4 lightingOrigin : TEXCOORD1;
	float4 lightingNormal : TEXCOORD2;
	float4 worldPositionZ : TEXCOORD3;
	float fog : FOG;
	DX12ClipDistances dx12Clip;
};
VS_OUTPUT main( VS_INPUT i )
{
	VS_OUTPUT o = (VS_OUTPUT)0;
	float3 worldPosition = mul4x3( i.position, cModel[0] );
	float4 clipPosition = mul( float4( worldPosition, 1 ), cViewProj );
	o.position = DX12Position( clipPosition );
	o.dx12Clip = DX12UserClipDistances( clipPosition );
	o.color = i.color;
	o.uv = i.uv;
	o.lightingOrigin = i.lightingOrigin;
	o.lightingNormal = i.lightingNormal;
	o.worldPositionZ = float4( worldPosition, dot( float4( worldPosition, 1 ), cViewProjZ ) );
	o.fog = CalcFog( worldPosition, clipPosition, DOWATERFOG );
	return o;
}
