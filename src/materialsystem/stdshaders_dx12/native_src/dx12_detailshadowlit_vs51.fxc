// Feature-only detail layout: prelit gamma color, UV, baked gather point,
// authored gather normal/orientation. Card geometry may turn; these do not.
// SHADOWLIT=1 (the lit material) gathers the runtime direct light once per sprite here, at the gather point all four
// card vertices share, and hands the pixel stage a flat interpolant; the sprite's projected origin stands in for the
// pixel position (local-light tile, dither rotation). SHADOWLIT=0 (the caster cutout material) stays resource-free.
#define DX12_LEGACY_VS20 1
// STATIC: "SHADOWLIT" "0..1"
// DYNAMIC: "DOWATERFOG" "0..1"
// DYNAMIC: "SHADOWQUALITY" "0..3"
// SKIP: ( $SHADOWLIT == 0 ) && ( $SHADOWQUALITY != 0 )
#if SHADOWLIT
#define DX12_SHADOWMAPS 1
#endif
#include "dx12_preamble.h"
#include "common_vs_fxc.h"

struct VS_INPUT
{
	float4 position : POSITION;
	float4 color : COLOR0;
	float2 uv : TEXCOORD0;
	float4 lightingOrigin : TEXCOORD1;
	float4 lightingNormal : TEXCOORD2;
};
struct VS_OUTPUT
{
	float4 position : SV_Position;
	float4 color : COLOR0;
	float2 uv : TEXCOORD0;
	nointerpolation float3 direct : TEXCOORD1;
	nointerpolation float3 eyePosition : TEXCOORD2;
	float4 worldPositionZ : TEXCOORD3;
	float fog : FOG;
	DX12ClipDistances dx12Clip;
};
VS_OUTPUT main( VS_INPUT i )
{
	VS_OUTPUT o = (VS_OUTPUT)0;
	float3 worldPosition = mul4x3( i.position, cModel[0] );
	float4 clipPosition = mul( float4( worldPosition, 1 ), cViewProj );
	o.position = DX12Position( clipPosition );
	o.dx12Clip = DX12UserClipDistances( clipPosition );
	o.color = i.color;
	o.uv = i.uv;
#if SHADOWLIT
	// Origins behind the eye have no projection: that vertex's own (any visible pixel of the card is as good a tile
	// as another). Clamped to the lighting viewport so an off-screen origin keeps a valid tile.
	float4 originClip = mul( float4( i.lightingOrigin.xyz, 1 ), cViewProj );
	if ( originClip.w <= 0.0 ) originClip = clipPosition;
	float2 ndc = originClip.xy / originClip.w;
	float2 pixel = cShadowViewport.xy + float2( ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5 ) / cShadowViewport.zw;
	pixel = clamp( pixel, cShadowViewport.xy, cShadowViewport.xy + 1.0 / cShadowViewport.zw - 1.0 );
	o.direct = ShadowMap_DetailDirect( i.lightingOrigin.xyz, i.lightingNormal.xyz, pixel );
#endif
	o.eyePosition = cEyePos;
	o.worldPositionZ = float4( worldPosition, dot( float4( worldPosition, 1 ), cViewProjZ ) );
	o.fog = CalcFog( worldPosition, clipPosition, DOWATERFOG );
	return o;
}
