// Native SM5.1 PBR model pixel shader (studio models and static props): VertexLitGeneric / Skin inputs shaded
// with the PBR lobes. Composition follows hlsl/vertexlit_and_unlit_generic_bump_shadowmap_ps51.fxc: engine
// ambient cube, draw-local cLightInfo lights, and under ENHANCED the selected direct gather
// (ShadowMap_BeginReceiverRelative + ShadowMap_SetBakedProp(SV_PrimitiveID) + PBR_GatherDirect); then the projected
// spots, the parallax-corrected IBL, emission and fog.
//
// TANGENT=1 carries the vertex tangent (normal maps); TANGENT=0 has no tangent stream and no normal map, and
// takes its anisotropy frame from derivatives. ALPHATEST=0 compiles the engine alpha-test kill away
// (DX12_EARLY_DEPTH); ALPHATEST=1 keeps it through DX12FinishPixel, driven by the engine alpha-test state.
#define DX12_NATIVE_PS 1
#if ENHANCED
#define DX12_SHADOWMAPS 1
#endif
#if !ALPHATEST
#define DX12_EARLY_DEPTH 1
#endif
#include "dx12_preamble.h"
// STATIC: "TANGENT" "0..1"
// STATIC: "ENHANCED" "0..1"
// STATIC: "ALPHATEST" "0..1"
// STATIC: "INFECTED" "0..1"
// VERTEXCOLOR: pbr_model_vs51's static of the same name (the vertex color is interpolated only with $vertexcolor).
// STATIC: "VERTEXCOLOR" "0..1"
// SKIP: $INFECTED && $VERTEXCOLOR
// LIGHTPASS: 0 the single pass; 1 the baked/material pass and 2 the additive realtime pass of the two-pass forward
// split (pbr_helper.cpp DrawPBR, drawn like Source's flashlight pass), ENHANCED only. Pass 1 keeps the probe/ambient,
// static vertex light, environment, emission and every G-buffer target; pass 2 adds only the engine local lights,
// PBR_GatherDirect with its folded local ambient, and the projected lights, depth EQUAL over pass 1, through the same
// fog transmission. Pass 2 never alpha tests: the depth pass 1 left already decided coverage.
// STATIC: "LIGHTPASS" "0..2"
// SKIP: ( $ENHANCED == 0 ) && ( $LIGHTPASS != 0 )
// SKIP: ( $LIGHTPASS == 2 ) && ( $ALPHATEST == 1 )
// DYNAMIC: "PIXELFOGTYPE" "0..2"
// DYNAMIC: "SHADOWQUALITY" "0..3"
// SKIP: ( $ENHANCED == 0 ) && ( $SHADOWQUALITY != 0 )
// LOCAL_LIGHTS: pbr_model_vs51's combo of the same name (the paired stages must agree); 0 drops the engine light loop.
// DYNAMIC: "LOCAL_LIGHTS" "0..1"
// The TANGENT combo name collides with the TANGENT vertex semantic: capture the value, then release the macro.
#if TANGENT
#define PBR_HAS_TANGENT 1
#else
#define PBR_HAS_TANGENT 0
#endif
#undef TANGENT
#include "common_ps_fxc.h"
#define PBR_MODEL_LOCAL_SELECTION 1
#include "pbr_lighting.hlsli"
#include "pbr_forward_screenspace.hlsli"
#if ENHANCED
#define PBR_PROBE_QUAD 1
#include "pbr_probe.hlsli"
#endif

Texture2D BaseTexture : register( t0 );
SamplerState BaseSampler : register( s0 );
Texture2D BumpTexture : register( t1 );
SamplerState BumpSampler : register( s1 );
TextureCube EnvmapTexture : register( t2 );
SamplerState EnvmapSampler : register( s2 );
Texture2D DetailTexture : register( t3 );
SamplerState DetailSampler : register( s3 );
Texture2D EnvmapMaskTexture : register( t4 );
SamplerState EnvmapMaskSampler : register( s4 );
Texture2D MraoTexture : register( t5 );
SamplerState MraoSampler : register( s5 );
Texture2D SpecularTexture : register( t6 );
SamplerState SpecularSampler : register( s6 );
Texture2D EmissionTexture : register( t7 );
SamplerState EmissionSampler : register( s7 );
Texture2D ThicknessTexture : register( t8 );
SamplerState ThicknessSampler : register( s8 );
Texture2D PhongExponentTexture : register( t9 );
SamplerState PhongExponentSampler : register( s9 );
Texture2D SelfIllumMaskTexture : register( t10 );
SamplerState SelfIllumMaskSampler : register( s10 );
#if INFECTED
// INFECTED: palette (sRGB), wound cutout atlas and burn map (sRGB).
Texture2D GradientTexture : register( t11 );
SamplerState GradientSampler : register( s11 );
Texture2D WoundTexture : register( t12 );
SamplerState WoundSampler : register( s12 );
Texture2D BurnTexture : register( t13 );
SamplerState BurnSampler : register( s13 );

// infected_ps20b.fxc InfectedFresnel: three-point Fresnel whose front-facing endpoint is itself scaled by the mask.
float PBR_InfectedFresnel( float nDotV, float specularMask )
{
	float fresnel = 1.0 - nDotV;
	fresnel *= fresnel;
	return fresnel <= 0.5 ? lerp( specularMask * g_L4D2PhongRanges.x, g_L4D2PhongRanges.y, 2.0 * fresnel ) :
		lerp( g_L4D2PhongRanges.y, g_L4D2PhongRanges.z, 2.0 * fresnel - 1.0 );
}

float3 PBR_SrgbToLinear3( float3 c )
{
	return float3( SrgbGammaToLinear( c.r ), SrgbGammaToLinear( c.g ), SrgbGammaToLinear( c.b ) );
}
#endif

// Exact mirror of the paired vertex output (same types, order and interpolation).
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float fog : FOG;
	float4 baseBumpUV : TEXCOORD0;
	float2 detailUV : TEXCOORD1;
#if LOCAL_LIGHTS
	float4 lightAtten : TEXCOORD2;
#endif
	float projPosZ : TEXCOORD3;
	float3 toEye : TEXCOORD4;
	float3 worldNormal : TEXCOORD5;
#if PBR_HAS_TANGENT
	float4 worldTangent : TEXCOORD6;
#else
	float3 staticLight : TEXCOORD6;
#endif
#if VERTEXCOLOR
	float4 vertexColor : TEXCOORD7;
#endif
#if INFECTED
	float4 woundUV : TEXCOORD8;
	float woundCull : TEXCOORD9;
#endif
#if ENHANCED
	uint primitiveId : SV_PrimitiveID;
#endif
};

// Engine-selected local ambient (r_model_local_lights): the lights the selection left out, folded into an ambient cube,
// unless the prop's baked direct already carries them.
#if ENHANCED
float3 PBR_FoldedLocalAmbient( PBRSurface s, float3 N, ShadowMapDirect direct )
{
	if ( g_ModelLocalAmbient[0].w == 0.0 || direct.bakedLocalDirect != 0 )
		return 0.0;
	float3 n2 = N * N;
	float3 folded = n2.x * ( N.x >= 0.0 ? g_ModelLocalAmbient[0].rgb : g_ModelLocalAmbient[1].rgb ) +
		n2.y * ( N.y >= 0.0 ? g_ModelLocalAmbient[2].rgb : g_ModelLocalAmbient[3].rgb ) +
		n2.z * ( N.z >= 0.0 ? g_ModelLocalAmbient[4].rgb : g_ModelLocalAmbient[5].rgb );
	return s.diffuseColor * s.ao * folded;
}
#endif

PBR_PSOut main( DX12_PS_INPUT i )
{
	// pbr_model_vs51 interpolates no world position (see its output struct): eye - toEye rebuilds it.
	float3 P = g_PbrModelEyePos.xyz - i.toEye;
	const float projPosZ = i.projPosZ;
#if VERTEXCOLOR
	const float4 vertexColor = i.vertexColor;
#else
	const float4 vertexColor = float4( 1.0, 1.0, 1.0, 1.0 );
#endif
#if ENHANCED && LIGHTPASS != 1
	// Derivatives occur here, before any divergent work, on the camera-relative -toEye (world positions far from the
	// origin are too coarse to differentiate). The primitive identity is a pure value carrier.
	ShadowMapReceiver receiver = ShadowMap_BeginReceiverRelative( P, -i.toEye, i.worldNormal, i.svPos.xy );
	ShadowMap_SetBakedProp( receiver, i.primitiveId );
#endif
	float2 baseUV = i.baseBumpUV.xy;
	uint phongBits = uint( g_Misc.z );

	float4 base = BaseTexture.Sample( BaseSampler, baseUV );
	float4 detail = float4( 1.0, 1.0, 1.0, 1.0 );
	if ( g_Flags1.z != 0.0 )
	{
		detail = DetailTexture.Sample( DetailSampler, i.detailUV ) * float4( g_PbrDetail.rgb, 1.0 );
		const int detailMode = int( g_L4D2World.x + 0.5 );
		if ( detailMode == 0 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * detail.rgb, g_PbrDetail.w );
		else if ( detailMode == 1 )
			base.rgb += g_PbrDetail.w * detail.rgb;
		else if ( detailMode == 2 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * detail.a );
		else if ( detailMode == 3 )
			base = lerp( base, detail, g_PbrDetail.w );
		else if ( detailMode == 4 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * ( 1.0 - base.a ) );
		else if ( detailMode == 7 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * lerp( detail.r, detail.a, base.a ), g_PbrDetail.w );
		else if ( detailMode == 8 )
			base = lerp( base, base * detail, g_PbrDetail.w );
		else if ( detailMode == 9 )
			base.a = lerp( base.a, base.a * detail.a, g_PbrDetail.w );
	}

	float3 vertexNormal = normalize( i.worldNormal );
	float3 N = vertexNormal;
	float normalAlpha = 1.0;
	float3 frameT = float3( 0.0, 0.0, 0.0 );
#if PBR_HAS_TANGENT
	float3 tangent = normalize( i.worldTangent.xyz );
	frameT = tangent;
	if ( g_Flags0.y != 0.0 )
	{
		float4 bumpTexel = BumpTexture.Sample( BumpSampler, i.baseBumpUV.zw );
		float3 tangentNormal = normalize( bumpTexel.xyz * 2.0 - 1.0 );
		float3 binormal = cross( vertexNormal, tangent ) * i.worldTangent.w;
		N = normalize( tangentNormal.x * tangent + tangentNormal.y * binormal + tangentNormal.z * vertexNormal );
		normalAlpha = bumpTexel.a;
	}
#else
	[branch] if ( g_Options.w != 0.0 )
		frameT = PBR_DerivativeTangent( vertexNormal, -i.toEye, baseUV );
#endif
	float3 V = normalize( i.toEye );

	// Environment mask with the legacy channel semantics: $envmapmask rgb, 1 - base alpha ($basealphaenvmapmask), normal map alpha.
	float3 envMask = float3( 1.0, 1.0, 1.0 );
	if ( g_Flags1.y == 1.0 )
		envMask = EnvmapMaskTexture.Sample( EnvmapMaskSampler, baseUV ).rgb;
	else if ( g_Flags1.y == 2.0 )
		envMask = base.a;
	else if ( g_Flags1.y == 3.0 )
		envMask = normalAlpha;
	if ( ( phongBits & 4u ) != 0 )
		envMask = base.a;
	float3 surface = g_Surface.xyz;
	if ( g_Flags0.x != 0.0 )
		surface *= MraoTexture.Sample( MraoSampler, baseUV ).rgb;
	// Legacy-replacement materials without explicit PBR roughness or Phong take it from the environment mask: a reflection mask is
	// a gloss map, so roughness = 1 - mask, and the mask no longer scales the reflection itself ($envmaptint does).
	const bool glossFromMask = g_PbrFlags2.y != 0.0;
	if ( glossFromMask )
		surface.y = 1.0 - saturate( dot( envMask, float3( 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0 ) ) );
	float3 modColor = g_L4D2Controls.x != 0.0 ? lerp( float3( 1.0, 1.0, 1.0 ), g_BaseTint.rgb, base.a ) : g_BaseTint.rgb;
	float3 baseColor = base.rgb * modColor * vertexColor.rgb;
	float3 specularF0 = g_SpecularColor.rgb;
	if ( g_Flags0.z != 0.0 )
		specularF0 = SpecularTexture.Sample( SpecularSampler, baseUV ).rgb;
	if ( ( phongBits & 1u ) != 0 )
	{
		// Legacy Phong mask and Fresnel range. $basemapluminancephongmask replaces the base-alpha mask.
		float phongMask = ( phongBits & 4u ) != 0 ? ( g_L4D2Model.x != 0.0 ? dot( base.rgb, float3( 0.299, 0.587, 0.114 ) ) : base.a ) : normalAlpha;
		if ( ( phongBits & 2u ) != 0 )
		{
			float4 phongMap = PhongExponentTexture.Sample( PhongExponentSampler, baseUV );
			// Legacy skin/l4d2 Phong uses exponent = 1 + 149 * R unless $phongexponent overrides it.
			float exponent = g_L4D2PhongRanges.w > 0.0 ? g_L4D2PhongRanges.w : 1.0 + 149.0 * phongMap.r;
			surface.y = sqrt( sqrt( 2.0 / ( exponent + 2.0 ) ) );
			// Legacy $phongalbedotint tints the specular colour only; it does not remove diffuse albedo.
			if ( g_L4D2Model.w != 0.0 )
				specularF0 = lerp( specularF0, baseColor, saturate( phongMap.g ) );
		}
		// Legacy $shinyblood (bit 8, l4d2_phong_ps20b.fxc SHINYBLOOD): full mask, the front-facing Fresnel endpoint scaled
		// by the red-over-green blood mask, and $phongexponent scaled by the inverse-luminance blood term (g_L4D2World.z
		// is $shinybloodexponent).
		float fresnelMin = g_L4D2PhongRanges.x;
		if ( ( phongBits & 8u ) != 0 )
		{
			phongMask = 1.0;
			fresnelMin *= saturate( base.r - 1.1 * base.g );
			const float bloodExponent = g_L4D2PhongRanges.w * pow( saturate( 1.0 - dot( base.rgb, float3( 0.3, 0.59, 0.11 ) ) ) + 0.5, g_L4D2World.z );
			if ( bloodExponent > 0.0 )
				surface.y = sqrt( sqrt( 2.0 / ( bloodExponent + 2.0 ) ) );
		}
		// Legacy $phongboost is represented as bounded reflectance, not a post-GGX intensity multiplier.
		specularF0 *= phongMask * g_L4D2Phong.rgb * max( g_L4D2Phong.w, 0.0 );
		float fresnel = pow( 1.0 - saturate( dot( normalize( i.toEye ), N ) ), max( g_L4D2PhongRanges.z, 0.0 ) );
		specularF0 *= lerp( fresnelMin, g_L4D2PhongRanges.y, fresnel );
		specularF0 = saturate( specularF0 );
	}
#if INFECTED
	// infected_ps20b.fxc material terms; the lighting below stays the ordinary PBR model lighting. The base texture is
	// read raw: with variation it is a mask/luminance sheet, without it gamma-coded albedo decoded here as the original.
	const float2 woundUV1 = saturate( i.woundUV.xy ) * g_PbrInfectedWoundUV1.xy + g_PbrInfectedWoundUV1.zw;
	const float2 woundUV2 = saturate( i.woundUV.zw ) * g_PbrInfectedWoundUV2.xy + g_PbrInfectedWoundUV2.zw;
	const float wound = g_PbrInfectedBlood.w != 0.0 ?
		max( WoundTexture.Sample( WoundSampler, woundUV1 ).r, WoundTexture.Sample( WoundSampler, woundUV2 ).r ) : 0.0;
	float3 infectedAlbedo;
	float infectedSpecularMask, infectedExponent, eyeMask = 0.0;
	if ( g_PbrInfectedGrad.w != 0.0 )
	{
		const float4 atlas = BaseTexture.Sample( BaseSampler, baseUV * 0.5 + g_PbrInfectedPalette.xy );
		const float3 masks = float3( atlas.rg, base.b ) * 2.0 - 1.0;
		const float skinMask = saturate( masks.z ), clothingMask = saturate( -masks.z ), detailMask = saturate( masks.x );
		const float luminance = base.a * base.a;
		const float3 skin = GradientTexture.Sample( GradientSampler, float2( base.a, g_PbrInfectedPalette.z ) ).rgb;
		const float3 clothing = GradientTexture.Sample( GradientSampler, float2( base.a, g_PbrInfectedPalette.w ) ).rgb;
		infectedAlbedo = lerp( lerp( luminance.xxx, skin, skinMask ), clothing, clothingMask );
		infectedSpecularMask = saturate( -masks.x );
		float skinExponent = g_PbrInfectedSpecPowers.y;
		// Detail and burn deliberately use opposite coordinate orders (detailUV is the original's .zw).
		const float4 detailSample = DetailTexture.Sample( DetailSampler, i.detailUV.yx );
		if ( g_PbrInfectedFeatures.z != 0.0 )
		{
			infectedAlbedo = lerp( infectedAlbedo, 2.0 * detailSample.rgb * luminance, detailMask );
			infectedSpecularMask = saturate( lerp( infectedSpecularMask, detailSample.a, detailMask ) );
			skinExponent = lerp( g_PbrInfectedSpecPowers.y, g_PbrInfectedSpecPowers.x, detailMask );
		}
		float blood = saturate( ( saturate( masks.y ) + wound - g_PbrInfectedGrad.x ) / ( g_PbrInfectedGrad.y - g_PbrInfectedGrad.x ) );
		blood = blood * blood * ( 3.0 - 2.0 * blood );
		infectedAlbedo *= lerp( float3( 1.0, 1.0, 1.0 ), g_PbrInfectedBlood.rgb, blood );
		infectedExponent = lerp( lerp( g_PbrInfectedSpecPowers.z, skinExponent, skinMask ), g_PbrInfectedSpecPowers.w, blood );
		if ( g_PbrInfectedFeatures.z != 0.0 )
			infectedSpecularMask = lerp( infectedSpecularMask, g_PbrInfectedEyeGlow.w, detailSample.a * blood );
		const float4 burn = BurnTexture.Sample( BurnSampler, i.detailUV.xy );
		if ( g_PbrInfectedFeatures.y != 0.0 )
			infectedAlbedo = lerp( infectedAlbedo, burn.rgb,
				saturate( burn.a + 2.0 * g_PbrInfectedFeatures.x - ( skinMask * g_PbrInfectedFeatures.x + 1.0 ) ) );
		if ( g_PbrInfectedFeatures.w != 0.0 )
			eyeMask = saturate( -1.1 * masks.y - 0.1 );
	}
	else
	{
		infectedAlbedo = PBR_SrgbToLinear3( base.rgb );
		infectedSpecularMask = max( base.a, 0.0 );
		infectedExponent = g_PbrInfectedSpecPowers.z;
#if PBR_HAS_TANGENT
		// The original bumped program takes the exponent from the normal map alpha, unscaled.
		if ( g_Flags0.y != 0.0 )
			infectedExponent = normalAlpha;
#endif
		if ( g_PbrInfectedShiny.x != 0.0 )
		{
			infectedSpecularMask = saturate( ( base.r - 1.1 * base.g ) * 10.0 );
			infectedExponent = pow( saturate( 1.0 - dot( base.rgb, float3( 0.3, 0.59, 0.11 ) ) ) + 0.5, g_PbrInfectedShiny.y ) * g_PbrInfectedSpecPowers.z;
		}
		const float woundBlood = wound * g_PbrInfectedEyeGlow.w;
#if PBR_HAS_TANGENT
		if ( g_Flags0.y != 0.0 )
			infectedExponent = lerp( infectedExponent, g_PbrInfectedSpecPowers.w, woundBlood );
#endif
		infectedSpecularMask = max( infectedSpecularMask, woundBlood * dot( base.rgb, float3( 0.3, 0.59, 0.11 ) ) );
		infectedAlbedo *= lerp( float3( 1.0, 1.0, 1.0 ), g_PbrInfectedBlood.rgb, saturate( woundBlood ) );
	}
	baseColor = infectedAlbedo * modColor * vertexColor.rgb;
	// The Phong lobe becomes GGX roughness and a bounded reflectance, as the legacy Phong adapter converts it.
	surface.y = sqrt( sqrt( 2.0 / ( max( infectedExponent, 1.0 ) + 2.0 ) ) );
	specularF0 = saturate( g_SpecularColor.rgb * infectedSpecularMask * g_L4D2Phong.rgb * max( g_L4D2Phong.w, 0.0 ) *
		PBR_InfectedFresnel( saturate( dot( V, N ) ), infectedSpecularMask ) );
#endif
	float thickness = g_Options.z;
	if ( g_SubsurfaceTint.w != 0.0 && ( g_Options.x > 0.0 || g_Options.y > 0.0 ) )
		thickness = ThicknessTexture.Sample( ThicknessSampler, baseUV ).r;
	PBRSurface s = PBR_MakeSurface( N, V, frameT, baseColor, surface.x, surface.y, surface.z, specularF0, thickness, g_Misc.y != 0.0 ? 1 : 0 );

#if ENHANCED && !PBR_DEPTH_PREPASS && LIGHTPASS != 2
	// The probe grid is decoded once per 2x2 quad (Probe_DecodeQuad): its quad operations need every lane of the quad
	// alive, so it runs here, in uniform control flow before the wound clip and the alpha-test kill.
	ProbeSH probe;
	const bool probeDecoded = Probe_DecodeQuad( P, vertexNormal, ( uint( i.svPos.x ) & 1u ) | ( ( uint( i.svPos.y ) & 1u ) << 1u ), probe );
#endif
	float alpha = g_BaseTint.a * vertexColor.a;
#if INFECTED
	// Base alpha is luminance / the specular mask, never coverage.
#else
	if ( g_Flags1.y != 2.0 && g_Flags0.w != 1.0 && ( phongBits & 4u ) == 0 )
		alpha *= base.a;
#endif
	float3 emission = 0.0;
	if ( g_Flags0.w == 1.0 )
	{
		float selfIllum = g_L4D2Controls.w != 0.0 ? SelfIllumMaskTexture.Sample( SelfIllumMaskSampler, baseUV ).r : base.a;
		emission = baseColor * g_EmissionTint.rgb * selfIllum;
	}
	else if ( g_Flags0.w == 2.0 )
		emission = EmissionTexture.Sample( EmissionSampler, baseUV ).rgb * g_EmissionTint.rgb;
#if INFECTED
	emission = eyeMask * g_PbrInfectedEyeGlow.rgb;
	// Wound cutouts, after every implicit-derivative sample: the cutout atlas threshold and the inside of the second
	// (culling) ellipsoid.
	if ( g_PbrInfectedBlood.w != 0.0 )
		clip( min( g_PbrInfectedGrad.z - wound, i.woundCull - 1.0 ) );
#endif
	// Alpha-tested fragments that fail are killed before the light loops (DX12FinishPixel repeats the same test on the
	// unchanged alpha). Every implicit-derivative sample happens above this line.
	DX12AlphaTest( alpha );
#if PBR_DEPTH_PREPASS
	// Preserve the ordinary alpha test and A2C alpha without evaluating the receiver light loops.
	PBR_PSOut coverage = (PBR_PSOut)0;
	coverage.color.a = alpha;
	return coverage;
#elif LIGHTPASS == 2

	// Additive realtime pass: only what the realtime lights add, through this pixel's fog transmission (the colour the
	// fog blends toward was already added by pass 1). The engine alpha-test state is off and ALPHATEST=0: under EQUAL
	// the depth pass 1 left already selected exactly its surviving fragments.
	float3 result = 0.0;
	PBRSpecularSum specularSum = PBR_NoSpecularSum();
#if LOCAL_LIGHTS
	result += PBR_LocalLights( s, P, int( g_EmissionTint.w ), i.lightAtten, specularSum );
#endif
	ShadowMapDirect direct = PBR_GatherDirect( receiver, s, specularSum );
	result += direct.diffuse + direct.specular + PBR_FoldedLocalAmbient( s, N, direct );
	result += PBR_ProjectedSpots( s, P, PBR_RECEIVER_MODEL, specularSum );
	result *= PBR_ForwardAO( i.svPos.xy );
	float3 eyePosition = P + i.toEye;
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, eyePosition, P, projPosZ );
	// S and D in the units pass 1 writes E: only a capturing bracket over an envmapped material uses them.
	const float transmission = PBR_FogTransmission( PIXELFOGTYPE, fogFactor, i.fog );
	const bool ssrPayload = cScreenControl.w != 0 && g_Flags1.x != 0.0;
	return PBR_OutputLight( result * ( LINEAR_LIGHT_SCALE * transmission ),
		ssrPayload ? specularSum.radiance * ( LINEAR_LIGHT_SCALE * transmission ) : 0.0, ssrPayload ? PBR_SpecularDistance( specularSum ) : 0.0 );
#else

	// Ambient. ENHANCED decodes the baked probe grid once per pixel quad at the vertex-normal-biased point (above) and
	// evaluates it for N (and -N / the softened N below); where no probe covers the point, or no grid is bound, the engine
	// ambient cube takes over.
	// Subsurface softens toward the opposite hemisphere; backlight adds that hemisphere.
	// A covered point also drops the static prop vertex lighting (COLOR1): the probes already carry the baked ambient, and
	// the engine's runtime-generated prop colors leak light onto shadowed props (c1m1's conduit_128 pipes, which ship no VHV).
	float3 ambient;
	bool probeCovered = false;
#if ENHANCED
	[branch] if ( probeDecoded )
	{
		probeCovered = true;
		ambient = Probe_Irradiance( probe, N );
		[branch] if ( s.sss != 0.0 || s.back != 0.0 )
			ambient = lerp( ambient, Probe_IrradianceSoft( probe, N ) * s.subsurfaceTint, s.sss ) * ( 1.0 - s.back ) +
				Probe_Irradiance( probe, -N ) * s.backlightTint * s.back;
	}
	else
#endif
	{
		ambient = PBR_AmbientCube( N );
		[branch] if ( s.sss != 0.0 || s.back != 0.0 )
		{
			float3 opposite = PBR_AmbientCube( -N );
			float3 soft = 0.75 * ambient + 0.25 * opposite;
			ambient = lerp( ambient, soft * s.subsurfaceTint, s.sss ) * ( 1.0 - s.back ) + opposite * s.backlightTint * s.back;
		}
	}
	float3 result = s.diffuseColor * s.ao * ambient;
#if !PBR_HAS_TANGENT
	if ( !probeCovered )
		result += s.diffuseColor * s.ao * i.staticLight;
#endif
	PBRSpecularSum specularSum = PBR_NoSpecularSum();
#if LIGHTPASS == 0
#if LOCAL_LIGHTS
	result += PBR_LocalLights( s, P, int( g_EmissionTint.w ), i.lightAtten, specularSum );
#endif
#if ENHANCED
	ShadowMapDirect direct = PBR_GatherDirect( receiver, s, specularSum );
	result += direct.diffuse + direct.specular + PBR_FoldedLocalAmbient( s, N, direct );
#endif
	result += PBR_ProjectedSpots( s, P, PBR_RECEIVER_MODEL, specularSum );
#endif
	if ( int( g_L4D2World.x + 0.5 ) == 5 )
		result += g_PbrDetail.w * detail.rgb;
	else if ( int( g_L4D2World.x + 0.5 ) == 6 )
	{
		float f = g_PbrDetail.w - 0.5;
		float fMult = f >= 0.0 ? 1.0 / max( g_PbrDetail.w, 1e-4 ) : 4.0 * g_PbrDetail.w;
		float fAdd = f >= 0.0 ? 1.0 - fMult : -0.5 * fMult;
		result += saturate( fMult * detail.rgb + fAdd );
	}
	// SSR payload: the environment term as it reaches the scene (E) and the response a sampled scene radiance must be
	// multiplied by to replace it (K), both through this pixel's fog transmission, plus the direct GGX specular (S) in
	// the same units and its luminance-weighted light distance (D). Only an envmapped material in a capturing bracket
	// supplies it; non-envmapped materials write K/valid zero while the backend masks E/D/S stores.
	const bool hasEnvmap = g_Flags1.x != 0.0;
	float3 environment = 0.0, environmentResponse = 0.0;
	if ( hasEnvmap )
	{
		environment = PBR_Environment( EnvmapTexture, EnvmapSampler, s, P, glossFromMask ? float3( 1.0, 1.0, 1.0 ) : envMask, environmentResponse );
		result += environment;
#if !PBR_DEPTH_PREPASS && LIGHTPASS != 2
		// Translucent receivers (car glass) and the viewmodels are drawn after the opaque bracket's SSR: they trace its
		// scene copy themselves (only they see it bound).
		[branch] if ( PBR_ForwardSSREnabled() && any( environmentResponse > PBR_FORWARD_MIN_RESPONSE ) )
		{
			const float4 hit = PBR_ForwardSSR( P, s.N, normalize( i.toEye ), s.roughness, i.svPos.xy );
			result += hit.rgb * environmentResponse * ( hit.a / LINEAR_LIGHT_SCALE ) - hit.a * environment;
		}
#endif
	}

	result += emission;
#if !PBR_DEPTH_PREPASS
	// Viewmodels are drawn after the scene's GTAO apply: their own term darkens them like it darkened the scene.
	result *= PBR_ForwardAO( i.svPos.xy );
#endif

	float3 eyePosition = P + i.toEye;
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, eyePosition, P, projPosZ );
	float4 color = DX12FinishPixel( FinalOutput( float4( result, alpha ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), i.fog );
	float reflectionValid = 0.0, specularDistance = 0.0;
	float3 environmentScene = 0.0, reflectionResponse = 0.0, directSpecular = 0.0;
	[branch] if ( cScreenControl.w != 0 && hasEnvmap )
	{
		float transmission = PBR_FogTransmission( PIXELFOGTYPE, fogFactor, i.fog );
		environmentScene = environment * ( LINEAR_LIGHT_SCALE * transmission );
		reflectionResponse = environmentResponse * transmission;
		reflectionValid = 1.0;
		directSpecular = specularSum.radiance * ( LINEAR_LIGHT_SCALE * transmission );
		specularDistance = PBR_SpecularDistance( specularSum );
	}
#if ENHANCED && LIGHTPASS == 0
	color = ShadowMap_Debug( receiver, direct, color );
	if ( ShadowMap_DebugReplacesColor() ) reflectionValid = 0.0;
#elif LIGHTPASS == 0
	if ( Contact_DebugEnabled() )
	{
		color = Contact_DebugColor( color.a );
		reflectionValid = 0.0;
	}
#endif
	return PBR_Output( color, s, environmentScene, reflectionResponse, reflectionValid, directSpecular, specularDistance );
#endif
}
