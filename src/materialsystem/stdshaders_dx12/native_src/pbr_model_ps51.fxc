// Native SM5.1 PBR model pixel shader (studio models and static props): VertexLitGeneric / Skin inputs shaded
// with the PBR lobes. Composition follows hlsl/vertexlit_and_unlit_generic_bump_shadowmap_ps51.fxc: engine
// ambient cube, draw-local cLightInfo lights, and under ENHANCED the selected direct gather
// (ShadowMap_BeginReceiverRelative + ShadowMap_SetBakedProp(SV_PrimitiveID) + PBR_GatherDirect); then the projected
// spots, the parallax-corrected IBL, emission and fog.
//
// TANGENT=1 carries the vertex tangent (normal maps); TANGENT=0 has no tangent stream and no normal map, and
// takes its anisotropy frame from derivatives. ALPHATEST=0 compiles the engine alpha-test kill away
// (DX12_EARLY_DEPTH); ALPHATEST=1 keeps it through DX12FinishPixel, driven by the engine alpha-test state.
#define DX12_NATIVE_PS 1
#if ENHANCED
#define DX12_SHADOWMAPS 1
#endif
#if !ALPHATEST
#define DX12_EARLY_DEPTH 1
#endif
#include "dx12_preamble.h"
// STATIC: "TANGENT" "0..1"
// STATIC: "ENHANCED" "0..1"
// STATIC: "ALPHATEST" "0..1"
// DYNAMIC: "PIXELFOGTYPE" "0..2"
// DYNAMIC: "SHADOWQUALITY" "0..3"
// SKIP: ( $ENHANCED == 0 ) && ( $SHADOWQUALITY != 0 )
// The TANGENT combo name collides with the TANGENT vertex semantic: capture the value, then release the macro.
#if TANGENT
#define PBR_HAS_TANGENT 1
#else
#define PBR_HAS_TANGENT 0
#endif
#undef TANGENT
#include "common_ps_fxc.h"
#define PBR_MODEL_LOCAL_SELECTION 1
#include "pbr_lighting.hlsli"
#if ENHANCED
#include "pbr_probe.hlsli"
#endif

Texture2D BaseTexture : register( t0 );
SamplerState BaseSampler : register( s0 );
Texture2D BumpTexture : register( t1 );
SamplerState BumpSampler : register( s1 );
TextureCube EnvmapTexture : register( t2 );
SamplerState EnvmapSampler : register( s2 );
Texture2D DetailTexture : register( t3 );
SamplerState DetailSampler : register( s3 );
Texture2D EnvmapMaskTexture : register( t4 );
SamplerState EnvmapMaskSampler : register( s4 );
Texture2D MraoTexture : register( t5 );
SamplerState MraoSampler : register( s5 );
Texture2D SpecularTexture : register( t6 );
SamplerState SpecularSampler : register( s6 );
Texture2D EmissionTexture : register( t7 );
SamplerState EmissionSampler : register( s7 );
Texture2D ThicknessTexture : register( t8 );
SamplerState ThicknessSampler : register( s8 );
Texture2D PhongExponentTexture : register( t9 );
SamplerState PhongExponentSampler : register( s9 );
Texture2D SelfIllumMaskTexture : register( t10 );
SamplerState SelfIllumMaskSampler : register( s10 );

// Exact mirror of the paired vertex output (same types, order and interpolation).
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float fog : FOG;
	float4 baseBumpUV : TEXCOORD0;
	float2 detailUV : TEXCOORD1;
	float4 lightAtten : TEXCOORD2;
	float4 worldPos_projPosZ : TEXCOORD3;
	float3 toEye : TEXCOORD4;
	float3 worldNormal : TEXCOORD5;
#if PBR_HAS_TANGENT
	float4 worldTangent : TEXCOORD6;
#else
	float3 staticLight : TEXCOORD6;
#endif
	float4 vertexColor : TEXCOORD7;
#if ENHANCED
	uint primitiveId : SV_PrimitiveID;
#endif
};

PBR_PSOut main( DX12_PS_INPUT i )
{
	float3 P = i.worldPos_projPosZ.xyz;
#if ENHANCED
	// Derivatives occur here, before any divergent work, on the camera-relative -toEye (world positions far from the
	// origin are too coarse to differentiate). The primitive identity is a pure value carrier.
	ShadowMapReceiver receiver = ShadowMap_BeginReceiverRelative( P, -i.toEye, i.worldNormal, i.svPos.xy );
	ShadowMap_SetBakedProp( receiver, i.primitiveId );
#endif
	float2 baseUV = i.baseBumpUV.xy;
	uint phongBits = uint( g_Misc.z );

	float4 base = BaseTexture.Sample( BaseSampler, baseUV );
	float4 detail = float4( 1.0, 1.0, 1.0, 1.0 );
	if ( g_Flags1.z != 0.0 )
	{
		detail = DetailTexture.Sample( DetailSampler, i.detailUV ) * float4( g_PbrDetail.rgb, 1.0 );
		const int detailMode = int( g_L4D2World.x + 0.5 );
		if ( detailMode == 0 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * detail.rgb, g_PbrDetail.w );
		else if ( detailMode == 1 )
			base.rgb += g_PbrDetail.w * detail.rgb;
		else if ( detailMode == 2 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * detail.a );
		else if ( detailMode == 3 )
			base = lerp( base, detail, g_PbrDetail.w );
		else if ( detailMode == 4 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * ( 1.0 - base.a ) );
		else if ( detailMode == 7 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * lerp( detail.r, detail.a, base.a ), g_PbrDetail.w );
		else if ( detailMode == 8 )
			base = lerp( base, base * detail, g_PbrDetail.w );
		else if ( detailMode == 9 )
			base.a = lerp( base.a, base.a * detail.a, g_PbrDetail.w );
	}

	float3 vertexNormal = normalize( i.worldNormal );
	float3 N = vertexNormal;
	float normalAlpha = 1.0;
	float3 frameT = float3( 0.0, 0.0, 0.0 );
#if PBR_HAS_TANGENT
	float3 tangent = normalize( i.worldTangent.xyz );
	frameT = tangent;
	if ( g_Flags0.y != 0.0 )
	{
		float4 bumpTexel = BumpTexture.Sample( BumpSampler, i.baseBumpUV.zw );
		float3 tangentNormal = normalize( bumpTexel.xyz * 2.0 - 1.0 );
		float3 binormal = cross( vertexNormal, tangent ) * i.worldTangent.w;
		N = normalize( tangentNormal.x * tangent + tangentNormal.y * binormal + tangentNormal.z * vertexNormal );
		normalAlpha = bumpTexel.a;
	}
#else
	[branch] if ( g_Options.w != 0.0 )
		frameT = PBR_DerivativeTangent( vertexNormal, -i.toEye, baseUV );
#endif
	float3 V = normalize( i.toEye );

	// Environment mask with the legacy channel semantics: $envmapmask rgb, 1 - base alpha ($basealphaenvmapmask), normal map alpha.
	float3 envMask = float3( 1.0, 1.0, 1.0 );
	if ( g_Flags1.y == 1.0 )
		envMask = EnvmapMaskTexture.Sample( EnvmapMaskSampler, baseUV ).rgb;
	else if ( g_Flags1.y == 2.0 )
		envMask = base.a;
	else if ( g_Flags1.y == 3.0 )
		envMask = normalAlpha;
	if ( ( phongBits & 4u ) != 0 )
		envMask = base.a;
	float3 surface = g_Surface.xyz;
	if ( g_Flags0.x != 0.0 )
		surface *= MraoTexture.Sample( MraoSampler, baseUV ).rgb;
	// Legacy-replacement materials without explicit PBR roughness or Phong take it from the environment mask: a reflection mask is
	// a gloss map, so roughness = 1 - mask, and the mask no longer scales the reflection itself ($envmaptint does).
	const bool glossFromMask = g_PbrFlags2.y != 0.0;
	if ( glossFromMask )
		surface.y = 1.0 - saturate( dot( envMask, float3( 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0 ) ) );
	float3 modColor = g_L4D2Controls.x != 0.0 ? lerp( float3( 1.0, 1.0, 1.0 ), g_BaseTint.rgb, base.a ) : g_BaseTint.rgb;
	float3 baseColor = base.rgb * modColor * i.vertexColor.rgb;
	float3 specularF0 = g_SpecularColor.rgb;
	if ( g_Flags0.z != 0.0 )
		specularF0 = SpecularTexture.Sample( SpecularSampler, baseUV ).rgb;
	if ( ( phongBits & 1u ) != 0 )
	{
		// Legacy Phong mask and Fresnel range. $basemapluminancephongmask replaces the base-alpha mask.
		float phongMask = ( phongBits & 4u ) != 0 ? ( g_L4D2Model.x != 0.0 ? dot( base.rgb, float3( 0.299, 0.587, 0.114 ) ) : base.a ) : normalAlpha;
		if ( ( phongBits & 2u ) != 0 )
		{
			float4 phongMap = PhongExponentTexture.Sample( PhongExponentSampler, baseUV );
			// Legacy skin/l4d2 Phong uses exponent = 1 + 149 * R unless $phongexponent overrides it.
			float exponent = g_L4D2PhongRanges.w > 0.0 ? g_L4D2PhongRanges.w : 1.0 + 149.0 * phongMap.r;
			surface.y = sqrt( sqrt( 2.0 / ( exponent + 2.0 ) ) );
			// Legacy $phongalbedotint tints the specular colour only; it does not remove diffuse albedo.
			if ( g_L4D2Model.w != 0.0 )
				specularF0 = lerp( specularF0, baseColor, saturate( phongMap.g ) );
		}
		// Legacy $phongboost is represented as bounded reflectance, not a post-GGX intensity multiplier.
		specularF0 *= phongMask * g_L4D2Phong.rgb * max( g_L4D2Phong.w, 0.0 );
		float fresnel = pow( 1.0 - saturate( dot( normalize( i.toEye ), N ) ), max( g_L4D2PhongRanges.z, 0.0 ) );
		specularF0 *= lerp( g_L4D2PhongRanges.x, g_L4D2PhongRanges.y, fresnel );
		specularF0 = saturate( specularF0 );
	}
	float thickness = g_Options.z;
	if ( g_SubsurfaceTint.w != 0.0 && ( g_Options.x > 0.0 || g_Options.y > 0.0 ) )
		thickness = ThicknessTexture.Sample( ThicknessSampler, baseUV ).r;
	PBRSurface s = PBR_MakeSurface( N, V, frameT, baseColor, surface.x, surface.y, surface.z, specularF0, thickness, g_Misc.y != 0.0 ? 1 : 0 );

	float alpha = g_BaseTint.a * i.vertexColor.a;
	if ( g_Flags1.y != 2.0 && g_Flags0.w != 1.0 && ( phongBits & 4u ) == 0 )
		alpha *= base.a;
	float3 emission = 0.0;
	if ( g_Flags0.w == 1.0 )
	{
		float selfIllum = g_L4D2Controls.w != 0.0 ? SelfIllumMaskTexture.Sample( SelfIllumMaskSampler, baseUV ).r : base.a;
		emission = baseColor * g_EmissionTint.rgb * selfIllum;
	}
	else if ( g_Flags0.w == 2.0 )
		emission = EmissionTexture.Sample( EmissionSampler, baseUV ).rgb * g_EmissionTint.rgb;
	// Alpha-tested fragments that fail are killed before the light loops (DX12FinishPixel repeats the same test on the
	// unchanged alpha). Every implicit-derivative sample happens above this line.
	DX12AlphaTest( alpha );
#if PBR_DEPTH_PREPASS
	// Preserve the ordinary alpha test and A2C alpha without evaluating the receiver light loops.
	PBR_PSOut coverage = (PBR_PSOut)0;
	coverage.color.a = alpha;
	return coverage;
#else

	// Ambient. ENHANCED decodes the baked probe grid once at the vertex-normal-biased point and evaluates it for N (and -N / the
	// softened N below); where no probe covers the point, or no grid is bound, the engine ambient cube takes over.
	// Subsurface softens toward the opposite hemisphere; backlight adds that hemisphere.
	float3 ambient;
#if ENHANCED
	ProbeSH probe;
	[branch] if ( Probe_Decode( P, vertexNormal, probe ) )
	{
		ambient = Probe_Irradiance( probe, N );
		[branch] if ( s.sss != 0.0 || s.back != 0.0 )
			ambient = lerp( ambient, Probe_IrradianceSoft( probe, N ) * s.subsurfaceTint, s.sss ) * ( 1.0 - s.back ) +
				Probe_Irradiance( probe, -N ) * s.backlightTint * s.back;
	}
	else
#endif
	{
		ambient = PBR_AmbientCube( N );
		[branch] if ( s.sss != 0.0 || s.back != 0.0 )
		{
			float3 opposite = PBR_AmbientCube( -N );
			float3 soft = 0.75 * ambient + 0.25 * opposite;
			ambient = lerp( ambient, soft * s.subsurfaceTint, s.sss ) * ( 1.0 - s.back ) + opposite * s.backlightTint * s.back;
		}
	}
	float3 result = s.diffuseColor * s.ao * ambient;
#if !PBR_HAS_TANGENT
	result += s.diffuseColor * s.ao * i.staticLight;
#endif
	PBRSpecularSum specularSum = PBR_NoSpecularSum();
	result += PBR_LocalLights( s, P, int( g_EmissionTint.w ), i.lightAtten, specularSum );
#if ENHANCED
	ShadowMapDirect direct = PBR_GatherDirect( receiver, s, specularSum );
	result += direct.diffuse + direct.specular;
	if ( g_ModelLocalAmbient[0].w != 0.0 && direct.bakedLocalDirect == 0 )
	{
		float3 n2 = N * N;
		float3 folded = n2.x * ( N.x >= 0.0 ? g_ModelLocalAmbient[0].rgb : g_ModelLocalAmbient[1].rgb ) +
			n2.y * ( N.y >= 0.0 ? g_ModelLocalAmbient[2].rgb : g_ModelLocalAmbient[3].rgb ) +
			n2.z * ( N.z >= 0.0 ? g_ModelLocalAmbient[4].rgb : g_ModelLocalAmbient[5].rgb );
		result += s.diffuseColor * s.ao * folded;
	}
#endif
	result += PBR_ProjectedSpots( s, P, PBR_RECEIVER_MODEL, specularSum );
	if ( int( g_L4D2World.x + 0.5 ) == 5 )
		result += g_PbrDetail.w * detail.rgb;
	else if ( int( g_L4D2World.x + 0.5 ) == 6 )
	{
		float f = g_PbrDetail.w - 0.5;
		float fMult = f >= 0.0 ? 1.0 / max( g_PbrDetail.w, 1e-4 ) : 4.0 * g_PbrDetail.w;
		float fAdd = f >= 0.0 ? 1.0 - fMult : -0.5 * fMult;
		result += saturate( fMult * detail.rgb + fAdd );
	}
	// SSR payload: the environment term as it reaches the scene (E) and the response a sampled scene radiance must be
	// multiplied by to replace it (K), both through this pixel's fog transmission, plus the direct GGX specular (S) in
	// the same units and its luminance-weighted light distance (D). Only an envmapped material in a capturing bracket
	// supplies it; non-envmapped materials write K/valid zero while the backend masks E/D/S stores.
	const bool hasEnvmap = g_Flags1.x != 0.0;
	float3 environment = 0.0, environmentResponse = 0.0;
	if ( hasEnvmap )
	{
		environment = PBR_Environment( EnvmapTexture, EnvmapSampler, s, P, glossFromMask ? float3( 1.0, 1.0, 1.0 ) : envMask, environmentResponse );
		result += environment;
	}

	result += emission;

	float3 eyePosition = P + i.toEye;
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, eyePosition, P, i.worldPos_projPosZ.w );
	float4 color = DX12FinishPixel( FinalOutput( float4( result, alpha ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), i.fog );
	float reflectionValid = 0.0, specularDistance = 0.0;
	float3 environmentScene = 0.0, reflectionResponse = 0.0, directSpecular = 0.0;
	[branch] if ( cScreenControl.w != 0 && hasEnvmap )
	{
		float transmission = PBR_FogTransmission( PIXELFOGTYPE, fogFactor, i.fog );
		environmentScene = environment * ( LINEAR_LIGHT_SCALE * transmission );
		reflectionResponse = environmentResponse * transmission;
		reflectionValid = 1.0;
		directSpecular = specularSum.radiance * ( LINEAR_LIGHT_SCALE * transmission );
		specularDistance = PBR_SpecularDistance( specularSum );
	}
#if ENHANCED
	color = ShadowMap_Debug( receiver, direct, color );
	if ( ShadowMap_DebugReplacesColor() ) reflectionValid = 0.0;
#endif
	return PBR_Output( color, s, environmentScene, reflectionResponse, reflectionValid, directSpecular, specularDistance );
#endif
}
