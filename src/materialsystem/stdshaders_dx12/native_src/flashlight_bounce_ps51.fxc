// STATIC: "MSAA" "0..1"
#define DX12_NATIVE_PS 1
#include "dx12_preamble.h"
#ifdef HDRTYPE
#undef HDRTYPE
#endif
#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"
#include "scene_fog.hlsli"
#include "screenspace_view.hlsli"
#include "viewmodel_depth.hlsli"
#include "pbr_oct.hlsli"
#if MSAA
#define SCENE Texture2DMS
#define FETCH( t ) t.Load( p, sampleIndex )
#else
#define SCENE Texture2D
#define FETCH( t ) t.Load( int3( p, 0 ) )
#endif
SCENE<float> rawDepth : register( t0 );
SCENE<float2> normals : register( t1 );
SCENE<uint2> stencil : register( t2 );
SCENE<float4> albedo : register( t3 );

struct BounceOutput
{
	float4 source : SV_Target0;
	float4 multiplier : SV_Target1;
};
// Six deterministic taps over a perspective-correct segment. Only an observed front surface can
// occlude; missing/off-screen samples and compressed hand depth are not world blockers.
float BounceVisibility( float3 P, float3 N, float3 light, uint sampleId )
{
	float4 a = mul( cScreenWorldToClip, float4( P + 2 * N, 1 ) );
	float4 b = mul( cScreenWorldToClip, float4( light, 1 ) );
	if ( min( a.w, b.w ) < 1 || cScreenDepth.z == 0 )
		return 1;
	float4 start = float4( a.xy / a.w, a.z / a.w, rcp( a.w ) );
	float4 end = float4( b.xy / b.w, b.z / b.w, rcp( b.w ) );
	float visibility = 1;
	[unroll] for ( int i = 1; i <= 6; ++i )
	{
		float4 tap = lerp( start, end, i / 7.0 );
		if ( any( abs( tap.xy ) >= 1 ) )
			break;
		int2 p = int2( cScreenViewport.xy + ( tap.xy * float2( 0.5, -0.5 ) + 0.5 ) * cScreenViewport.zw );
#if MSAA
		float deviceZ = rawDepth.Load( p, sampleId );
#else
		float deviceZ = rawDepth.Load( int3( p, 0 ) );
#endif
		if ( deviceZ < DX12_VIEWMODEL_DEPTH_MAX || deviceZ >= tap.z )
			continue;
		float gap = rcp( tap.w ) - cScreenDepth.z / ( deviceZ - cScreenDepth.y );
		// Finite depth thickness avoids painting distant background surfaces with foreground silhouettes.
		visibility = min( visibility, 1 - smoothstep( 1, 4, gap ) * ( 1 - smoothstep( 24, 48, gap ) ) );
	}
	return visibility;
}

[earlydepthstencil] BounceOutput main( float4 sv : SV_Position, nointerpolation float4 light : TEXCOORD0, nointerpolation float4 color : TEXCOORD1, nointerpolation float3 hitCenter : TEXCOORD2, nointerpolation float3 hitNormal : TEXCOORD3
#if MSAA
    ,
    uint sampleIndex : SV_SampleIndex
#endif
)
{
	int2 p = int2( sv.xy );
	float depth = FETCH( rawDepth );
	bool vm = light.w != 0;
	float2 pixel = p + 0.5;
#if MSAA
	pixel += GetRenderTargetSamplePosition( sampleIndex );
#endif
	float2 local = ( pixel - cScreenViewport.xy ) / cScreenViewport.zw;
	float z = vm ? depth / DX12_VIEWMODEL_DEPTH_MAX : depth;
	float4 world = mul( cScreenClipToWorld, float4( local * float2( 2, -2 ) + float2( -1, 1 ), z, 1 ) );
	float3 P = world.xyz / world.w;
	float3 n = cross( ddy( P ), ddx( P ) );
	n *= rsqrt( max( dot( n, n ), 1e-12 ) );
	n = faceforward( n, P - cScreenEyeLength.xyz, n );
	if ( depth >= cScreenDepth.x || ( depth < DX12_VIEWMODEL_DEPTH_MAX ) != vm )
		discard;
	float3 delta = light.xyz - P;
	float d2 = dot( delta, delta );
	if ( d2 >= 40000 )
		discard;
	bool pbr = ( FETCH( stencil ).y & 128 ) != 0;
	if ( pbr )
		n = PBR_UnpackNormal( FETCH( normals ) );
	float atten = saturate( 1 - d2 / 40000 );
	float facing = saturate( dot( n, delta ) * rsqrt( max( 1e-6, d2 ) ) );
	float plane = smoothstep( -8, -2, dot( hitNormal, P - hitCenter ) );
	if ( plane * facing <= 0 )
		discard;
#if MSAA
	uint traceSample = sampleIndex;
#else
	uint traceSample = 0;
#endif
	float3 rgb = color.rgb * ( plane * facing * atten * atten * BounceVisibility( P, n, light.xyz, traceSample ) );
	if ( color.w && distance( P, hitCenter ) < 8 )
		rgb = 4 * color.rgb;
	float clipZ = z / world.w;
	float fog = SceneFog( clipZ, P, cScreenEyeLength.xyz, cScreenControl.x != 0, int( cScreenControl.z ), cScreenContactParams, cScreenContactDepth );
	BounceOutput result;
	rgb *= 1 - fog;
	float4 material = pbr ? FETCH( albedo ) : 0;
	// Dual-source blending reads destination RGB only for opaque non-writers.
	result.source = float4( rgb * material.rgb, 0 );
	float3 gain = material.a > 0 ? 0 : min( rgb / ( 0.20 * cScreenEyeLength.w ), 0.35 );
	result.multiplier = float4( 1 + gain, 1 );
	return result;
}
