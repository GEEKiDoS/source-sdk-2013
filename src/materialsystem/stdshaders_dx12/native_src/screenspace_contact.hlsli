// Screen-space contact visibility generated by the Bend wavefront compute pass: the sun's mask and up to four local
// lights' masks (screenspace_dx12.cpp RunContactShadowPasses).
#ifndef SCREENSPACE_CONTACT_HLSLI
#define SCREENSPACE_CONTACT_HLSLI
#include "screenspace_view.hlsli"

// Viewport-local visibility for the current world or viewmodel receiver layer. Private prepass depth is compute-only.
Texture2D<float> g_ScreenContactShadow : register( t0, space6 );
Texture2D<float> g_ScreenLocalContact0 : register( t8, space6 );
Texture2D<float> g_ScreenLocalContact1 : register( t9, space6 );
Texture2D<float> g_ScreenLocalContact2 : register( t10, space6 );
Texture2D<float> g_ScreenLocalContact3 : register( t11, space6 );

static float g_ContactDebugVisibility = 1.0;

bool Contact_DebugEnabled()
{
	return cScreenContactControl.w != 0u;
}

float4 Contact_DebugColor( float alpha )
{
	return float4( g_ContactDebugVisibility.xxx, alpha );
}

// Viewport-local pixel of this receiver scope, or false outside it (and with contacts off).
bool Contact_Pixel( float2 svPositionXY, out int2 pixel )
{
	pixel = int2( floor( svPositionXY - cScreenViewport.xy ) );
	return ( cScreenContactControl.x == 1u || cScreenContactControl.x == 2u ) &&
		all( pixel >= int2( 0, 0 ) ) && all( pixel < int2( cScreenViewport.zw ) );
}

float DX12_SunContactVisibility( float2 svPositionXY )
{
	int2 pixel;
	[branch] if ( cScreenContactParams.w == 0.0 || !Contact_Pixel( svPositionXY, pixel ) )
		return 1.0;
	float visibility = saturate( g_ScreenContactShadow.Load( int3( pixel, 0 ) ) );
	if ( Contact_DebugEnabled() )
		g_ContactDebugVisibility = min( g_ContactDebugVisibility, visibility );
	return visibility;
}

// lightId: RuntimeShadowLightGpu::lightId. Lights without a mask this frame are unoccluded.
float DX12_LocalContactVisibility( float2 svPositionXY, uint lightId )
{
	const uint key = lightId + 1u;
	const uint4 match = uint4( cScreenContactLights == key.xxxx );
	int2 pixel;
	[branch] if ( !any( match ) || !Contact_Pixel( svPositionXY, pixel ) )
		return 1.0;
	float visibility;
	[branch] if ( match.x ) visibility = g_ScreenLocalContact0.Load( int3( pixel, 0 ) );
	else if ( match.y ) visibility = g_ScreenLocalContact1.Load( int3( pixel, 0 ) );
	else if ( match.z ) visibility = g_ScreenLocalContact2.Load( int3( pixel, 0 ) );
	else visibility = g_ScreenLocalContact3.Load( int3( pixel, 0 ) );
	visibility = saturate( visibility );
	if ( Contact_DebugEnabled() )
		g_ContactDebugVisibility = min( g_ContactDebugVisibility, visibility );
	return visibility;
}

#endif // SCREENSPACE_CONTACT_HLSLI
