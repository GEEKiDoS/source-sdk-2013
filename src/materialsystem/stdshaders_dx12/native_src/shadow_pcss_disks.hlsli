// Sun PCSS sample budget: the SHADOWQUALITY dynamic combo of the PBR receivers (r_shadowmap_filter_quality) selects
// Low 8/8, Medium 8/16, High 16/32 or Extra 32/64 blocker/filter taps. Shaders without the combo keep High, the
// original budget. Equal-weight Vogel disks: blocker sample zero is the center (detects even a one-texel blocker),
// blocker point k = 1..n-1 at radius sqrt((k-.5)/(n-1)); filter point k = 0..n-1 at sqrt((k+.5)/n); angles advance by
// the golden angle 2.39996323. The receiver's dither rotates both patterns (shadow_dither.hlsli).
#ifndef DX12_SHADOW_PCSS_DISKS_HLSLI
#define DX12_SHADOW_PCSS_DISKS_HLSLI
#ifndef SHADOWQUALITY
#define SHADOWQUALITY 2
#endif
// Low and Medium skip the screen-space contact ray toward the sun (it costs more than their PCSS kernel; local-light
// and projected contact rays are unaffected). High and Extra, and every shader without the combo, keep it.
#define DX12_SUN_CONTACT_SHADOWS ( SHADOWQUALITY >= 2 )
#if SHADOWQUALITY == 0 // Low: 8 blocker / 8 filter taps
#define DX12_SUN_PCSS_BLOCKER_TAPS 8
#define DX12_SUN_PCSS_FILTER_TAPS 8
static const float2 g_ShadowBlockerDisk[DX12_SUN_PCSS_BLOCKER_TAPS] =
{
