// Enhanced-only replacement of WorldVertexTransition.vsh; original transforms and blend alpha.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
// DYNAMIC: "DOWATERFOG" "0..1"
#include "common_vs_fxc.h"
cbuffer WorldVertexTransitionEditorMaterial : register(b2, space1)
{
    float4 cEditorBaseTransform[2]; // @legacy vs:c0
    float4 cEditorBase2Transform[2]; // @legacy vs:c2
};
struct VS_INPUT { float4 position : POSITION; float3 normal : NORMAL; float4 color : COLOR0; float4 uv : TEXCOORD0; float2 baseLightmapUV : TEXCOORD1; };
struct VS_OUTPUT
{
    float4 position : SV_Position;
    float4 color : COLOR0;
    float2 uv0 : TEXCOORD0;
    float2 uv1 : TEXCOORD1;
    centroid float2 baseLightmapUV : TEXCOORD2;
    float4 worldPositionZ : TEXCOORD3;
    float3 worldNormal : TEXCOORD4;
    float fog : FOG;
    DX12ClipDistances dx12Clip;
};
VS_OUTPUT main(VS_INPUT i)
{
    VS_OUTPUT o = (VS_OUTPUT)0;
    float3 world = mul4x3(i.position, cModel[0]);
    float4 clip = mul(float4(world, 1), cViewProj);
    o.position = DX12Position(clip);
    o.dx12Clip = DX12UserClipDistances(clip);
    o.worldPositionZ = float4(world, dot(float4(world, 1), cViewProjZ));
    o.fog = CalcFog(world, clip, DOWATERFOG);
    o.color = i.color;
    o.uv0 = float2(dot(i.uv, cEditorBaseTransform[0]), dot(i.uv, cEditorBaseTransform[1]));
    o.uv1 = float2(dot(i.uv, cEditorBase2Transform[0]), dot(i.uv, cEditorBase2Transform[1]));
    o.baseLightmapUV = i.baseLightmapUV;
    o.worldNormal = normalize(mul(i.normal, (float3x3)cModel[0]));
    return o;
}
