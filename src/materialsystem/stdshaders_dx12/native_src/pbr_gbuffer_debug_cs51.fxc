// Native SM5.1 PBR G-buffer debug view: world-space normals, F0 or roughness of the opaque PBR scene pass. A pixel shows
// PBR data only while stencil bit 0x80 is set (README "PBR G-buffer contract"); the rest is black.
// Compute contract: constants in b0 space1, resources in space 0 (README "Compute shaders").
// STATIC: "MSAA" "0..1"
#include "pbr_oct.hlsli"

cbuffer PBRGBufferDebug : register( b0, space1 )
{
	uint4 g_Params; // x mode (0 normals, 1 F0, 2 roughness), y/z viewport width/height
};
#if MSAA
Texture2DMS<float2> gNormals : register( t0, space0 );
Texture2DMS<float4> gSpecular : register( t1, space0 );
Texture2DMS<float> gSceneDepth : register( t2, space0 );
Texture2DMS<uint2> gStencil : register( t3, space0 );
#else
Texture2D<float2> gNormals : register( t0, space0 );
Texture2D<float4> gSpecular : register( t1, space0 );
Texture2D<float> gSceneDepth : register( t2, space0 );
Texture2D<uint2> gStencil : register( t3, space0 );
#endif
RWTexture2D<float4> gOutput : register( u0, space0 );

[numthreads( 8, 8, 1 )]
void main( uint3 id : SV_DispatchThreadID )
{
	if ( id.x >= g_Params.y || id.y >= g_Params.z ) return;
	int2 p = int2( id.xy );
#if MSAA
	float2 normal = gNormals.Load( p, 0 );
	float4 spec = gSpecular.Load( p, 0 );
	uint stencil = gStencil.Load( p, 0 ).y;
#else
	float2 normal = gNormals.Load( int3( p, 0 ) );
	float4 spec = gSpecular.Load( int3( p, 0 ) );
	uint stencil = gStencil.Load( int3( p, 0 ) ).y;
#endif
	bool valid = ( stencil & 0x80 ) != 0;
	float3 color = 0.0;
	if ( valid )
	{
		if ( g_Params.x == 0 ) color = PBR_UnpackNormal( normal ) * 0.5 + 0.5;
		else if ( g_Params.x == 1 ) color = spec.rgb;
		else color = spec.a;
	}
	gOutput[id.xy] = float4( color, 1.0 );
}
