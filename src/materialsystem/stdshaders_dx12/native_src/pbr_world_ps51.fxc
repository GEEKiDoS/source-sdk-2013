// Native SM5.1 PBR world (brush) pixel shader: LightmappedGeneric / WorldVertexTransition inputs shaded with the
// PBR lobes. The BSP lightmap is the diffuse irradiance carrier (1 flat plane or the 3 bumped planes, copied
// from hlsl/lightmappedgeneric_ps51.fxc) and is multiplied by diffuseColor once; it never contributes specular.
//
// Compiled three ways from this source, like every lightmap consumer:
//   pbr_world_ps51          native lightmap, no selected direct (maps without an enhanced bake);
//   pbr_world_highres_ps51  PBR_WORLD_HIGHRES: on enhanced maps the backend swaps the ordinary logical for this
//                           twin (this file's HIGHLIGHT_SAMPLERS role + the *_highres_* name). The highres atlas
//                           replaces the native RGB of owned faces (HighresLightmap_NativeScalePlane), and
//                           PBR_GatherDirect adds the sun / resident local lights over the baked-face domain
//                           (signed (Vrt - Vbaked) * weight delta on baked-direct faces, Burley full terms
//                           elsewhere, specular always). Mirrors hlsl/lightmappedgeneric_highres_ps51.fxc:
//                           ShadowMap_BeginReceiverRelative + bakedSunVisibility + ShadowMap_SetBakedFace.
//   pbr_world_highres_earlydepth_ps51  forced-early-depth twin (no discard, [earlydepthstencil]) for draws
//                           without alpha test; keeps the failure report, see README "Forced early-depth receiver twins".
//
// ALPHATEST=0 compiles the engine alpha-test kill away (DX12_EARLY_DEPTH); ALPHATEST=1 keeps it through
// DX12FinishPixel, driven by the engine alpha-test state (also honours alpha-to-coverage).
// HIGHLIGHT_SAMPLERS: 8
#define DX12_NATIVE_PS 1
#if PBR_WORLD_HIGHRES
#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
#define HIGHRES_LIGHTMAP_BICUBIC 1
#endif
#if !ALPHATEST
#define DX12_EARLY_DEPTH 1
#endif
#include "dx12_preamble.h"
// STATIC: "LAYERED" "0..1"
// STATIC: "NMS" "0..1"
// STATIC: "L4N" "0..1"
// STATIC: "ALPHATEST" "0..1"
// LIGHTPASS: 0 the single pass; 1 the baked/material pass and 2 the additive realtime pass of the two-pass forward
// split (pbr_helper.cpp DrawPBR, drawn like Source's flashlight pass). Pass 1 keeps the lightmap, environment, emission
// and every G-buffer target; pass 2 adds only PBR_GatherDirect and the projected lights, depth EQUAL over pass 1,
// through the same fog transmission. Pass 2 never alpha tests: the depth pass 1 left already decided coverage.
// STATIC: "LIGHTPASS" "0..2"
// SKIP: ( $LIGHTPASS == 2 ) && ( $ALPHATEST == 1 )
// DYNAMIC: "PIXELFOGTYPE" "0..2"
// DYNAMIC: "SHADOWQUALITY" "0..3"
#include "common_ps_fxc.h"
#include "pbr_lighting.hlsli"
#include "pbr_forward_screenspace.hlsli"

Texture2D BaseTexture : register( t0 );
SamplerState BaseSampler : register( s0 );
Texture2D BumpTexture : register( t1 );
SamplerState BumpSampler : register( s1 );
TextureCube EnvmapTexture : register( t2 );
SamplerState EnvmapSampler : register( s2 );
Texture2D LightmapTexture : register( t3 );
SamplerState LightmapSampler : register( s3 );
Texture2D DetailTexture : register( t4 );
SamplerState DetailSampler : register( s4 );
Texture2D EnvmapMaskTexture : register( t5 );
SamplerState EnvmapMaskSampler : register( s5 );
// MRAO, specular, emission and thickness are base-UV data textures read through one sampler: a ps_5_1 may
// declare at most 16 sampler objects across all register spaces and the highres twin already spends four
// (HlightLinear, the shadow comparison sampler and the two projected-light samplers).
Texture2D MraoTexture : register( t6 );
SamplerState DataSampler : register( s6 );
Texture2D SpecularTexture : register( t7 );
Texture2D EmissionTexture : register( t8 );
Texture2D ThicknessTexture : register( t9 );
Texture2D Base2Texture : register( t10 );
SamplerState Base2Sampler : register( s10 );
Texture2D Bump2Texture : register( t11 );
SamplerState Bump2Sampler : register( s11 );
Texture2D BlendModulateTexture : register( t12 );
SamplerState BlendModulateSampler : register( s12 );
Texture2D BumpMaskTexture : register( t13 );
SamplerState BumpMaskSampler : register( s13 );

// Exact mirror of the paired vertex output (same types, order and interpolation).
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float fog : FOG;
	float4 baseBumpUV : TEXCOORD0;
	float4 detailBlendUV : TEXCOORD1;
	centroid float4 lightmapUV : TEXCOORD2;
	float4 worldPos_projPosZ : TEXCOORD3;
	float3 toEye : TEXCOORD4;
	float3 tangentS : TEXCOORD5;
	float3 tangentT : TEXCOORD6;
	float3 worldNormal : TEXCOORD7;
#if LAYERED
	float layerBlend : TEXCOORD8;
#endif
	float4 vertexColor : TEXCOORD9;
	float2 rawUV : TEXCOORD10;
	nointerpolation float2 lightmapVertexUV : TEXCOORD11;
};

// One lightmap plane (0 flat, 1..3 bumped) in decoded linear units.
#if PBR_WORLD_HIGHRES
float3 PBR_WorldLightmapPlane( HlightReceiver r, uint plane, float2 uv )
{
	// Derivatives precede the owner-dependent branch. Highres RGB replaces the native sample completely;
	// native-only owners retain exactly the original gradients and scale.
	float2 dx = ddx( uv ), dy = ddy( uv );
	[branch] if ( cHlightRoute.x == 0 || r.nativeOnly != 0 )
		return LightmapTexture.SampleGrad( LightmapSampler, uv, dx, dy ).rgb * LIGHT_MAP_SCALE;
	return HighresLightmap_RGB( r, plane );
}
#define LIGHTMAP_PLANE( plane, uv ) PBR_WorldLightmapPlane( hlr, plane, uv )
#else
#define LIGHTMAP_PLANE( plane, uv ) ( LightmapTexture.Sample( LightmapSampler, uv ).rgb * LIGHT_MAP_SCALE )
#endif

#if defined( DX12_EARLY_DEPTH )
[earlydepthstencil]
#endif
PBR_PSOut main( DX12_PS_INPUT i )
{
	float3 P = i.worldPos_projPosZ.xyz;
	float2 baseUV = i.baseBumpUV.xy;
	float2 bumpUV = i.baseBumpUV.zw;
	bool hasBump = g_Flags0.y != 0.0;
	bool hasDetail = g_Flags1.z != 0.0;
	bool flatDiffuse = g_PbrFlags2.x != 0.0; // $nodiffusebumplighting
	PBRNMSInput nmsInput = (PBRNMSInput)0;
#if NMS
	nmsInput.enabled = hasBump && g_Flags0.y != 2.0 ? 1.0 : 0.0;
	nmsInput.uv = baseUV;
	nmsInput.toEye = i.toEye;
	[branch] if ( nmsInput.enabled != 0.0 )
	{
		nmsInput.uvDx = ddx( baseUV );
		nmsInput.uvDy = ddy( baseUV );
		nmsInput.positionDx = ddx( P );
		nmsInput.positionDy = ddy( P );
		nmsInput.tangent = normalize( i.tangentS );
		nmsInput.binormal = normalize( i.tangentT );
	}
#endif
#if PBR_WORLD_HIGHRES
#if LIGHTPASS != 1
	// Derivative receiver setup is kept before any material-dependent branch.
	ShadowMapReceiver receiver = ShadowMap_BeginReceiverRelative( P, -i.toEye, i.worldNormal, i.svPos.xy );
#endif
	HlightReceiver hlr = HighresLightmap_Begin( i.lightmapUV.xy, i.lightmapVertexUV );
#if LIGHTPASS != 1
	ShadowMap_SetBakedSun( receiver, hlr.sun, hlr.sunDilated );
	ShadowMap_SetBakedFace( receiver, hlr.faceId, hlr.q, hlr.localVisibilityEligible, hlr.bakedDirectEligible, hlr.unbakedLocalRange );
#endif
#endif
	// The highres receiver setup above intentionally precedes material sampling. Bump and base coordinates are
	// already captured in nmsInput so its derivatives remain valid across the later uniform branches.

	float4 base = BaseTexture.Sample( BaseSampler, baseUV );
	// hlsl/lightmappedgeneric_ps51.fxc reads the first normal map on the base coordinates; $bumptransform places the second one.
	float4 bumpTexel = float4( 0.5, 0.5, 1.0, 1.0 );
	if ( hasBump )
		bumpTexel = BumpTexture.Sample( BumpSampler, baseUV );
	float opacity = base.a;       // alpha and self illumination follow the first layer
	float blendedAlpha = base.a;  // $basealphaenvmapmask follows the blended layers
	float bumpMaskFactor = 1.0;   // $bumpmask alpha scales the reflection
#if LAYERED
	// Blend factor of the second layer: the vertex alpha, a constant half with $maskedblending.
	const bool maskedBlending = g_PbrBlend.x != 0.0;
	float blend = maskedBlending ? 0.5 : i.layerBlend;
	if ( g_PbrFlags2.z != 0.0 )
	{
		// $blendmodulatetexture refines the blend (not under self illumination or height fog); with $maskedblending its green
		// channel is the blend itself.
		if ( g_Misc.w != 0.0 && g_Flags0.w != 1.0 && PIXELFOGTYPE != PIXEL_FOG_TYPE_HEIGHT )
		{
			float4 modulate = BlendModulateTexture.Sample( BlendModulateSampler, i.detailBlendUV.zw );
			blend = maskedBlending ? modulate.g : smoothstep( saturate( modulate.g - modulate.r ), saturate( modulate.g + modulate.r ), blend );
		}
		float4 base2 = Base2Texture.Sample( Base2Sampler, baseUV );
		blendedAlpha = lerp( base.a, base2.a, blend );
		base.rgb = lerp( base.rgb, base2.rgb, blend );
	}
	if ( g_PbrBlend.w != 0.0 )
	{
		// $bumpmask: both normal maps, each on its own transform, add; the static mask normal takes over where its alpha falls.
	#if L4N
		float3 normal1 = PBR_DecodeNormal( BumpTexture.Sample( BumpSampler, bumpUV ) );
		float3 normal2 = PBR_DecodeNormal( Bump2Texture.Sample( Bump2Sampler, PBR_TransformUV( i.rawUV, g_PbrMaskTransform ) ) );
	#else
		float3 normal1 = BumpTexture.Sample( BumpSampler, bumpUV ).xyz * 2.0 - 1.0;
		float3 normal2 = Bump2Texture.Sample( Bump2Sampler, PBR_TransformUV( i.rawUV, g_PbrMaskTransform ) ).xyz * 2.0 - 1.0;
	#endif
		float4 mask = BumpMaskTexture.Sample( BumpMaskSampler, baseUV );
		bumpTexel.xyz = lerp( mask.xyz * 2.0 - 1.0, normalize( normal1 + normal2 ), mask.a ) * 0.5 + 0.5;
		bumpMaskFactor = mask.a;
	}
	else if ( g_PbrBlend.z != 0.0 )
	{
		// The second normal map sits on $bumptransform's coordinates (the base ones under a detail texture). A modulate texture with
		// $normalmapalphaenvmapmask blends the mask alpha as well.
		float4 bump2 = Bump2Texture.Sample( Bump2Sampler, hasDetail ? baseUV : bumpUV );
		bumpTexel = g_Misc.w != 0.0 && g_Flags1.y == 3.0 ? lerp( bumpTexel, bump2, blend ) : float4( lerp( bumpTexel.xyz, bump2.xyz, blend ), bumpTexel.a );
	}
#endif
	float4 detail = float4( 1.0, 1.0, 1.0, 1.0 );
	if ( hasDetail )
	{
		detail = DetailTexture.Sample( DetailSampler, i.detailBlendUV.xy ) * float4( g_PbrDetail.rgb, 1.0 );
		const int detailMode = int( g_L4D2World.x + 0.5 );
		if ( detailMode == 0 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * detail.rgb, g_PbrDetail.w );
		else if ( detailMode == 1 )
			base.rgb += g_PbrDetail.w * detail.rgb;
		else if ( detailMode == 2 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * detail.a );
		else if ( detailMode == 3 )
			base = lerp( base, detail, g_PbrDetail.w );
		else if ( detailMode == 4 )
			base.rgb = lerp( base.rgb, detail.rgb, g_PbrDetail.w * ( 1.0 - base.a ) );
		else if ( detailMode == 7 )
			base.rgb *= lerp( float3( 1.0, 1.0, 1.0 ), 2.0 * lerp( detail.r, detail.a, base.a ), g_PbrDetail.w );
		else if ( detailMode == 8 )
			base = lerp( base, base * detail, g_PbrDetail.w );
		else if ( detailMode == 9 )
			base.a = lerp( base.a, base.a * detail.a, g_PbrDetail.w );
		else if ( detailMode == 11 )
			base.rgb *= dot( detail.rgb, 2.0 / 3.0 );
	}
	base.rgb *= i.vertexColor.rgb;

	// Tangent-space shading normal and the three lightmap-plane weights. An ssbump texel holds the weights
	// itself; a normal map weights the planes by (saturate(n . basis))^2, normalized.
	float3 tangentNormal = float3( 0.0, 0.0, 1.0 );
	float3 planeWeights = float3( 0.0, 0.0, 0.0 );
	if ( hasBump )
	{
		if ( g_Flags0.y == 2.0 )
		{
			planeWeights = bumpTexel.xyz;
			tangentNormal = normalize( bumpBasis[0] * bumpTexel.x + bumpBasis[1] * bumpTexel.y + bumpBasis[2] * bumpTexel.z );
		}
		else
		{
			#if L4N
			tangentNormal = PBR_DecodeNormal( bumpTexel );
			#else
			tangentNormal = normalize( bumpTexel.xyz * 2.0 - 1.0 );
			#endif
			planeWeights = saturate( float3( dot( tangentNormal, bumpBasis[0] ), dot( tangentNormal, bumpBasis[1] ), dot( tangentNormal, bumpBasis[2] ) ) );
			planeWeights *= planeWeights;
			planeWeights /= max( planeWeights.x + planeWeights.y + planeWeights.z, 1e-4 );
		}
	}
	if ( int( g_L4D2World.x + 0.5 ) == 10 && hasBump )
		planeWeights *= 2.0 * detail.rgb;

	// A plane with weight exactly zero contributes exactly zero (its RGB is finite), so its fetch is skipped;
	// the remaining fetches stay independent and the weighted sum retains the stored plane order.
	float3 lightmap = float3( 0.0, 0.0, 0.0 );
#if LIGHTPASS != 2
	float2 lightmapUV = i.lightmapUV.xy;
	float2 planeStep = i.lightmapUV.zw;
	if ( hasBump && !flatDiffuse )
	{
#if PBR_WORLD_HIGHRES
		// Derivatives precede the owner-dependent branch. Highres RGB replaces the native samples completely;
		// native-only owners retain exactly the original gradients and scale.
		float2 uvDx = ddx( lightmapUV ), uvDy = ddy( lightmapUV ), stepDx = ddx( planeStep ), stepDy = ddy( planeStep );
		[branch] if ( cHlightRoute.x == 0 || hlr.nativeOnly != 0 )
		{
			[branch] if ( planeWeights.x > 0.0 ) lightmap += planeWeights.x * LightmapTexture.SampleGrad( LightmapSampler, lightmapUV + planeStep, uvDx + stepDx, uvDy + stepDy ).rgb;
			[branch] if ( planeWeights.y > 0.0 ) lightmap += planeWeights.y * LightmapTexture.SampleGrad( LightmapSampler, lightmapUV + 2.0 * planeStep, uvDx + 2.0 * stepDx, uvDy + 2.0 * stepDy ).rgb;
			[branch] if ( planeWeights.z > 0.0 ) lightmap += planeWeights.z * LightmapTexture.SampleGrad( LightmapSampler, lightmapUV + 3.0 * planeStep, uvDx + 3.0 * stepDx, uvDy + 3.0 * stepDy ).rgb;
			lightmap *= LIGHT_MAP_SCALE;
		}
		else lightmap = HighresLightmap_BumpedRGB( hlr, planeWeights );
#else
		[branch] if ( planeWeights.x > 0.0 ) lightmap += planeWeights.x * LIGHTMAP_PLANE( 1, lightmapUV + planeStep );
		[branch] if ( planeWeights.y > 0.0 ) lightmap += planeWeights.y * LIGHTMAP_PLANE( 2, lightmapUV + 2.0 * planeStep );
		[branch] if ( planeWeights.z > 0.0 ) lightmap += planeWeights.z * LIGHTMAP_PLANE( 3, lightmapUV + 3.0 * planeStep );
#endif
	}
	else
		lightmap = LIGHTMAP_PLANE( 0, lightmapUV );
	if ( g_Flags0.y == 2.0 )
		lightmap *= g_L4D2Controls.z;
#endif

	float3 vertexNormal = normalize( i.worldNormal );
	float3 N = vertexNormal;
	if ( hasBump )
		N = normalize( tangentNormal.x * i.tangentS + tangentNormal.y * i.tangentT + tangentNormal.z * vertexNormal );
	float3 V = normalize( i.toEye );
	// The NMS ray rises from the base surface plane; the bumped normal is what the trace integrates.
	nmsInput.normal = vertexNormal;

	// Environment mask with the legacy channel semantics: $envmapmask rgb on $envmapmasktransform (independent of the base
	// transform; the sampler is shared with the second normal map, so a material with one has no texture mask), 1 - blended
	// base alpha ($basealphaenvmapmask), normal map alpha; $bumpmask alpha scales any of them.
	float3 envMask = float3( 1.0, 1.0, 1.0 );
	if ( g_Flags1.y == 1.0 )
	{
		if ( g_PbrBlend.z == 0.0 )
			envMask = EnvmapMaskTexture.Sample( EnvmapMaskSampler, PBR_TransformUV( i.rawUV, g_PbrMaskTransform ) ).rgb;
	}
	else if ( g_Flags1.y == 2.0 )
		envMask = 1.0 - blendedAlpha;
	else if ( g_Flags1.y == 3.0 )
		envMask = bumpTexel.a;
	envMask *= bumpMaskFactor;

	float3 surface = g_Surface.xyz;
#if L4N
	float mraoAlpha = 1.0;
	if ( g_Flags0.x != 0.0 )
	{
		float4 mrao = MraoTexture.Sample( DataSampler, baseUV );
		surface *= mrao.rgb;
		mraoAlpha = mrao.a;
	}
#else
	if ( g_Flags0.x != 0.0 )
		surface *= MraoTexture.Sample( DataSampler, baseUV ).rgb;
#endif
	// Legacy-replacement materials without explicit PBR roughness take it from the environment mask: a reflection mask is a gloss
	// map, so roughness = 1 - mask, and the mask no longer scales the reflection itself ($envmaptint does).
	const bool glossFromMask = g_PbrFlags2.y != 0.0;
	if ( glossFromMask )
		surface.y = 1.0 - saturate( dot( envMask, float3( 1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0 ) ) );
	float3 specularF0 = g_SpecularColor.rgb;
	if ( g_Flags0.z != 0.0 )
		specularF0 = SpecularTexture.Sample( DataSampler, baseUV ).rgb;
	float thickness = g_Options.z;
	if ( g_SubsurfaceTint.w != 0.0 && ( g_Options.x > 0.0 || g_Options.y > 0.0 ) )
		thickness = ThicknessTexture.Sample( DataSampler, baseUV ).r;

#if L4N
	float3 modColor = g_L4D2Controls.x != 0.0 ? lerp( float3( 1.0, 1.0, 1.0 ), g_BaseTint.rgb, mraoAlpha ) : g_BaseTint.rgb;
#else
	float3 modColor = g_L4D2Controls.x != 0.0 ? lerp( float3( 1.0, 1.0, 1.0 ), g_BaseTint.rgb, blendedAlpha ) : g_BaseTint.rgb;
#endif
	float3 baseColor = base.rgb * modColor;
	PBRSurface s = PBR_MakeSurface( flatDiffuse ? vertexNormal : N, V, i.tangentS, baseColor, surface.x, surface.y, surface.z, specularF0, thickness, 0 );
	// Reflections, projected lights and the G-buffer use the normal map even when the diffuse is flat.
	PBRSurface sBump = s;
	sBump.N = N;
	sBump.NdotV = max( dot( N, V ), 1e-4 );
#if PBR_WORLD_HIGHRES
	// Baked-direct deltas must use the stored reconstruction of the bumped planes (legacy ShadowMap_ShadeBumped), with
	// the same scale the lightmap gets: an ssbump material's $SSBumpMathFix multiplies the reconstructed lightmap (above),
	// and a delta without it removed up to 1/0.577 of the light's baked share, more than the whole lightmap (c1m3's
	// cinder-block walls went pitch black in realtime shadows).
	const float lightmapScale = g_Flags0.y == 2.0 ? g_L4D2Controls.z : 1.0;
	if ( hasBump && !flatDiffuse )
		PBR_SetBumpedBasis( s, mul( bumpBasis[0], float3x3( i.tangentS, i.tangentT, i.worldNormal ) ),
			mul( bumpBasis[1], float3x3( i.tangentS, i.tangentT, i.worldNormal ) ),
			mul( bumpBasis[2], float3x3( i.tangentS, i.tangentT, i.worldNormal ) ), planeWeights * lightmapScale );
	else if ( lightmapScale != 1.0 )
		PBR_SetBumpedBasis( s, s.N, s.N, s.N, float3( lightmapScale, 0.0, 0.0 ) );
#endif

	float alpha = g_BaseTint.a;
	if ( g_Flags1.y != 2.0 && g_Flags0.w != 1.0 )
		alpha *= opacity;
	alpha *= i.vertexColor.a;
	// hlsl/lightmappedgeneric_ps51.fxc applies the modulation alpha ($alpha) twice, as the vertex color alpha and inside c12.w with
	// $alpha2 (alpha *= vertexColor.a * g_flAlpha2), so a legacy-replacement material is as transparent as the legacy shader draws it.
	alpha *= lerp( 1.0, g_BaseTint.a, g_PbrFlags2.w ) * g_PbrBlend.y;
	float3 emission = 0.0;
	if ( g_Flags0.w == 1.0 )
		emission = baseColor * g_EmissionTint.rgb * opacity;
	else if ( g_Flags0.w == 2.0 )
		emission = EmissionTexture.Sample( DataSampler, baseUV ).rgb * g_EmissionTint.rgb;
#if L4N
	emission *= pow( saturate( 1.0 - dot( N, V ) ), max( g_L4D2World.w, 0.0 ) );
#endif
	// Alpha-tested fragments that fail are killed before the light loops (DX12FinishPixel repeats the same test on the
	// unchanged alpha). Every implicit-derivative sample happens above this line.
	DX12AlphaTest( alpha );
#if PBR_DEPTH_PREPASS
	// The ordinary vertex program and alpha expression are unchanged. Dead-code elimination removes all
	// material/lighting work not feeding coverage; RTV0 alpha is retained for alpha-to-coverage.
	PBR_PSOut coverage = (PBR_PSOut)0;
	coverage.color.a = alpha;
	return coverage;
#elif LIGHTPASS == 2

	// Additive realtime pass: only what the realtime lights add, through this pixel's fog transmission (the colour the
	// fog blends toward was already added by pass 1). The engine alpha-test state is off and ALPHATEST=0: under EQUAL
	// the depth pass 1 left already selected exactly its surviving fragments.
	float3 result = 0.0;
	PBRSpecularSum specularSum = PBR_NoSpecularSum();
#if PBR_WORLD_HIGHRES
	[branch] if ( hlr.valid != 0 )
	{
		ShadowMapDirect direct = PBR_GatherDirect( receiver, s, specularSum, nmsInput, BumpTexture, BumpSampler );
		result += direct.diffuse + direct.specular;
	}
#endif
	result += PBR_ProjectedSpots( sBump, P, PBR_RECEIVER_WORLD, specularSum );
	float3 eyePosition = P + i.toEye;
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, eyePosition, P, i.worldPos_projPosZ.w );
	// S and D in the units pass 1 writes E: only a capturing bracket over an envmapped material uses them.
	const float transmission = PBR_FogTransmission( PIXELFOGTYPE, fogFactor, i.fog );
	const bool ssrPayload = cScreenControl.w != 0 && g_Flags1.x != 0.0;
#if PBR_WORLD_HIGHRES
	HighresLightmap_Report();
#endif
	return PBR_OutputLight( result * ( LINEAR_LIGHT_SCALE * transmission ),
		ssrPayload ? specularSum.radiance * ( LINEAR_LIGHT_SCALE * transmission ) : 0.0, ssrPayload ? PBR_SpecularDistance( specularSum ) : 0.0 );
#else

	// Baked lightmap diffuse; backlight reuses the front value (a lightmap holds no back-facing term).
	float3 result = s.diffuseColor * s.ao * lightmap * ( ( 1.0 - s.back ) + s.backlightTint * s.back );
	PBRSpecularSum specularSum = PBR_NoSpecularSum();
#if PBR_WORLD_HIGHRES && LIGHTPASS == 0
	// Unknown/neutral owners add no selected direct. Only debug views need their diagnostic gather.
	ShadowMapDirect direct = ShadowMap_NoDirect();
	direct = PBR_GatherDirect( receiver, s, specularSum, nmsInput, BumpTexture, BumpSampler );
	result += ( direct.diffuse + direct.specular ) * float( hlr.valid );
	if ( hlr.valid == 0 ) specularSum = PBR_NoSpecularSum(); // the gather is the first specular contributor
#endif
	// SSR payload: the environment term as it reaches the scene (E) and the response a sampled scene radiance must be
	// multiplied by to replace it (K), both through this pixel's fog transmission, plus the direct GGX specular (S) in
	// the same units and its luminance-weighted light distance (D). Only an envmapped material in a capturing bracket
	// supplies it; non-envmapped materials write K/valid zero while the backend masks E/D/S stores.
	const bool hasEnvmap = g_Flags1.x != 0.0;
	float3 environment = 0.0, environmentResponse = 0.0;
	float forwardConfidence = 0.0;
	if ( hasEnvmap )
	{
		environment = PBR_Environment( EnvmapTexture, EnvmapSampler, sBump, P, glossFromMask ? float3( 1.0, 1.0, 1.0 ) : envMask, environmentResponse );
		result += environment;
#if !PBR_DEPTH_PREPASS && LIGHTPASS == 0
		// Translucent receivers (windows) trace the opaque bracket's SSR scene themselves; only they see it bound.
		[branch] if ( PBR_ForwardSSREnabled() && any( environmentResponse > 0.0 ) )
		{
			const float4 hit = PBR_ForwardSSR( P, sBump.N, V, sBump.roughness, i.svPos.xy );
			result += hit.rgb * environmentResponse * ( hit.a / LINEAR_LIGHT_SCALE ) - hit.a * environment;
			forwardConfidence = hit.a;
		}
#endif
	}
#if LIGHTPASS == 0
	result += PBR_ProjectedSpots( sBump, P, PBR_RECEIVER_WORLD, specularSum );
#endif

	if ( int( g_L4D2World.x + 0.5 ) == 5 )
		result += g_PbrDetail.w * detail.rgb;
	else if ( int( g_L4D2World.x + 0.5 ) == 6 )
	{
		float f = g_PbrDetail.w - 0.5;
		float fMult = f >= 0.0 ? 1.0 / max( g_PbrDetail.w, 1e-4 ) : 4.0 * g_PbrDetail.w;
		float fAdd = f >= 0.0 ? 1.0 - fMult : -0.5 * fMult;
		result += saturate( fMult * detail.rgb + fAdd );
	}
	result += emission;

	float3 eyePosition = P + i.toEye;
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, eyePosition, P, i.worldPos_projPosZ.w );
	float4 color = DX12FinishPixel( FinalOutput( float4( result, alpha ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), i.fog );
	color.rgb = PBR_ForwardSSRDebug( color.rgb, environmentResponse, forwardConfidence );
	float reflectionValid = 0.0, specularDistance = 0.0;
	float3 environmentScene = 0.0, reflectionResponse = 0.0, directSpecular = 0.0;
	[branch] if ( cScreenControl.w != 0 && hasEnvmap )
	{
		float transmission = PBR_FogTransmission( PIXELFOGTYPE, fogFactor, i.fog );
		environmentScene = environment * ( LINEAR_LIGHT_SCALE * transmission );
		reflectionResponse = environmentResponse * transmission;
		reflectionValid = 1.0;
		directSpecular = specularSum.radiance * ( LINEAR_LIGHT_SCALE * transmission );
		specularDistance = PBR_SpecularDistance( specularSum );
	}
#if PBR_WORLD_HIGHRES && LIGHTPASS == 0
	color = HighresLightmap_Finish( ShadowMap_Debug( receiver, direct, color ) );
	if ( ShadowMap_DebugReplacesColor() ) reflectionValid = 0.0;
#elif PBR_WORLD_HIGHRES
	color = HighresLightmap_Finish( color );
#elif LIGHTPASS == 0
	if ( Contact_DebugEnabled() )
	{
		color = Contact_DebugColor( color.a );
		reflectionValid = 0.0;
	}
#endif
	return PBR_Output( color, sBump, environmentScene, reflectionResponse, reflectionValid, directSpecular, specularDistance );
#endif
}
