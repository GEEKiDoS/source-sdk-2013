// Native SM5.1 XeGTAO depth prefilter.
// STATIC: "MSAA" "0..1"
#include "gtao_common.hlsli"

#if MSAA
Texture2DMS<float> gSceneDepth : register( t0, space0 );
#else
Texture2D<float> gSceneDepth : register( t0, space0 );
#endif
RWTexture2D<float> gDepthMip0 : register( u0, space0 );
RWTexture2D<float> gDepthMip1 : register( u1, space0 );
RWTexture2D<float> gDepthMip2 : register( u2, space0 );
RWTexture2D<float> gDepthMip3 : register( u3, space0 );
RWTexture2D<float> gDepthMip4 : register( u4, space0 );
groupshared float gScratchDepths[8][8];

float LoadSceneDepth( int2 p )
{
	int2 lo = gSceneOrigin;
	int2 hi = gSceneOrigin + int2( max( gViewportSize.x * gDepthScale.x - 1.0, 0.0 ), max( gViewportSize.y * gDepthScale.y - 1.0, 0.0 ) );
	p = clamp( p, lo, hi );
#if MSAA
	return gSceneDepth.Load( p, 0 );
#else
	return gSceneDepth.Load( int3( p, 0 ) );
#endif
}

[numthreads( 8, 8, 1 )]
void main( uint3 dispatchID : SV_DispatchThreadID, uint3 groupID : SV_GroupThreadID )
{
	uint2 base = dispatchID.xy;
	uint2 pix = base * 2;
	float2 sceneScale = gDepthScale;
	int2 p0 = gSceneOrigin + int2( ( ( float2( pix ) + 0.5 ) * sceneScale ) );
	int2 p1 = gSceneOrigin + int2( ( ( float2( pix + uint2( 1, 0 ) ) + 0.5 ) * sceneScale ) );
	int2 p2 = gSceneOrigin + int2( ( ( float2( pix + uint2( 0, 1 ) ) + 0.5 ) * sceneScale ) );
	int2 p3 = gSceneOrigin + int2( ( ( float2( pix + uint2( 1, 1 ) ) + 0.5 ) * sceneScale ) );
	float d0 = clamp( ViewDepth( LoadSceneDepth( p0 ) ), 0.0, 65504.0 );
	float d1 = clamp( ViewDepth( LoadSceneDepth( p1 ) ), 0.0, 65504.0 );
	float d2 = clamp( ViewDepth( LoadSceneDepth( p2 ) ), 0.0, 65504.0 );
	float d3 = clamp( ViewDepth( LoadSceneDepth( p3 ) ), 0.0, 65504.0 );
	if ( pix.x < gViewportSize.x && pix.y < gViewportSize.y ) gDepthMip0[pix] = d0;
	if ( pix.x + 1 < gViewportSize.x && pix.y < gViewportSize.y ) gDepthMip0[pix + uint2( 1, 0 )] = d1;
	if ( pix.x < gViewportSize.x && pix.y + 1 < gViewportSize.y ) gDepthMip0[pix + uint2( 0, 1 )] = d2;
	if ( pix.x + 1 < gViewportSize.x && pix.y + 1 < gViewportSize.y ) gDepthMip0[pix + uint2( 1, 1 )] = d3;
	float dm1 = DepthMipFilter( d0, d1, d2, d3 );
	if ( base.x < ( gViewportSize.x + 1 ) / 2 && base.y < ( gViewportSize.y + 1 ) / 2 ) gDepthMip1[base] = dm1;
	gScratchDepths[groupID.x][groupID.y] = dm1;
	GroupMemoryBarrierWithGroupSync();
	if ( ( groupID.x & 1 ) == 0 && ( groupID.y & 1 ) == 0 )
	{
		float dm2 = DepthMipFilter( gScratchDepths[groupID.x][groupID.y], gScratchDepths[groupID.x + 1][groupID.y], gScratchDepths[groupID.x][groupID.y + 1], gScratchDepths[groupID.x + 1][groupID.y + 1] );
		if ( base.x / 2 < ( gViewportSize.x + 3 ) / 4 && base.y / 2 < ( gViewportSize.y + 3 ) / 4 ) gDepthMip2[base / 2] = dm2;
		gScratchDepths[groupID.x][groupID.y] = dm2;
	}
	GroupMemoryBarrierWithGroupSync();
	if ( ( groupID.x & 3 ) == 0 && ( groupID.y & 3 ) == 0 )
	{
		float dm3 = DepthMipFilter( gScratchDepths[groupID.x][groupID.y], gScratchDepths[groupID.x + 2][groupID.y], gScratchDepths[groupID.x][groupID.y + 2], gScratchDepths[groupID.x + 2][groupID.y + 2] );
		if ( base.x / 4 < ( gViewportSize.x + 7 ) / 8 && base.y / 4 < ( gViewportSize.y + 7 ) / 8 ) gDepthMip3[base / 4] = dm3;
		gScratchDepths[groupID.x][groupID.y] = dm3;
	}
	GroupMemoryBarrierWithGroupSync();
	if ( ( groupID.x & 7 ) == 0 && ( groupID.y & 7 ) == 0 )
	{
		float dm4 = DepthMipFilter( gScratchDepths[groupID.x][groupID.y], gScratchDepths[groupID.x + 4][groupID.y], gScratchDepths[groupID.x][groupID.y + 4], gScratchDepths[groupID.x + 4][groupID.y + 4] );
		if ( base.x / 8 < ( gViewportSize.x + 15 ) / 16 && base.y / 8 < ( gViewportSize.y + 15 ) / 16 ) gDepthMip4[base / 8] = dm4;
	}
}
