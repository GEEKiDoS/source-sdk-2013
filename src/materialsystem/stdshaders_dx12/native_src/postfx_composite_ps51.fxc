// Native SM5.1 HDR composite: MagicBloom's layered bloom screened over the Minimal AgX scene, Froyok's lens flare and
// glare added to the HDR scene, and four Source 32^3 LUT lookups.
// DYNAMIC: "CAMERA_MODEL" "0..2"
#define DX12_NATIVE_PS 1
#include "dx12_preamble.h"
#ifdef HDRTYPE
#undef HDRTYPE
#endif
#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

cbuffer PostComposite : register( b1, space1 )
{
	// x scene scale, y bloom exposure / summed layers, z lens flare scale
	float4 gSceneBloomFlare; // @legacy ps:c0
	float4 gDirtPeak; // @legacy ps:c1
	float4 gOutput; // @legacy ps:c2
	float4 gLutWeights; // @legacy ps:c3
	float4 gLutWeight4; // @legacy ps:c4
	float4 gLens; // @legacy ps:c5
	float4 gCamera; // @legacy ps:c6
	float4 gSensor; // @legacy ps:c7
	float4 gAwbParams; // @legacy ps:c8
	float4 gViewRect; // @legacy ps:c9
	float4 gBodycam; // @legacy ps:c10
	float4 gContrast; // @legacy ps:c11
	float4 gFinish; // @legacy ps:c12
	float4 gMotion; // @legacy ps:c13
};
Texture2D<float4> gScene : register( t0 );
Texture2D<float4> gBloom : register( t1 );
Texture2D<float4> gFlare : register( t2 );
Texture2D<float4> gGlare : register( t3 );
Texture2D<float4> gDirt : register( t4 );
Texture3D<float4> gLut0 : register( t5 );
Texture3D<float4> gLut1 : register( t6 );
Texture3D<float4> gLut2 : register( t7 );
Texture3D<float4> gLut3 : register( t8 );
Texture2D<float4> gAwb : register( t9 );
Texture2D<float4> gPrefilter : register( t10 );
// One sampler per texture slot: each takes its texture's filtering (the scene copy is point-sampled 1:1, everything
// else is linear).
SamplerState gSceneSampler : register( s0 );
SamplerState gBloomSampler : register( s1 );
SamplerState gFlareSampler : register( s2 );
SamplerState gGlareSampler : register( s3 );
SamplerState gDirtSampler : register( s4 );
SamplerState gLut0Sampler : register( s5 );
SamplerState gLut1Sampler : register( s6 );
SamplerState gLut2Sampler : register( s7 );
SamplerState gLut3Sampler : register( s8 );
SamplerState gBodycamLinear : register( s10 );
Texture2D<float4> gNoise : register( t11 );
Texture2D<float4> gVignette : register( t12 );
SamplerState gNoiseSampler : register( s11 );
SamplerState gVignetteSampler : register( s12 );
Texture2D<float4> gVelocity : register( t13 );

float4 CompactVelocity( float2 uv )
{
	int2 p = clamp( int2( uv * gMotion.xy ), 0, int2( gMotion.xy ) - 1 );
	return gVelocity.Load( int3( p, 0 ) );
}

#include "agx_curve.hlsli"

// The exact piecewise sRGB decode, the inverse of the _SRGB render-target encode the presentation path applies.
float3 SRGBToLinear( float3 c )
{
	c = saturate( c );
	return lerp( c / 12.92, pow( ( c + 0.055 ) / 1.055, 2.4 ), step( 0.04045, c ) );
}

// Uncharted 2 filmic curve with MagicBloom's constants; BloomTonemap normalises it so linear white 11.2 maps to 1.
float3 Uncharted2( float3 x )
{
	const float A = 0.15, B = 0.50, C = 0.10, D = 0.20, E = 0.02, F = 0.30;
	return ( x * ( A * x + C * B ) + D * E ) / ( x * ( A * x + B ) + D * F ) - E / F;
}
float3 BloomTonemap( float3 c ) { return Uncharted2( c ) / Uncharted2( 11.2.xxx ); }
float3 Screen( float3 a, float3 b ) { return 1.0 - ( 1.0 - a ) * ( 1.0 - b ); }

// Jimenez's interleaved gradient noise, in [0, 1).
float InterleavedGradientNoise( float2 pixel )
{
	return frac( 52.9829189 * frac( dot( pixel, float2( 0.06711056, 0.00583715 ) ) ) );
}
struct PS_INPUT { float4 projPos : SV_Position; float2 vUv0 : TEXCOORD0; };

// Default flare tint of Froyok's lens flare settings.
static const float3 kFlareTint = float3( 1.0, 0.85, 0.7 );

// Bilinear read of one mip. Material samplers of render targets without a mip chain clamp to LOD 0, so mips written
// by compute are fetched directly.
float3 SampleMip( Texture2D<float4> tex, float2 uv, uint mip )
{
	uint width, height, levels;
	tex.GetDimensions( mip, width, height, levels );
	float2 p = uv * float2( width, height ) - 0.5;
	float2 f = frac( p );
	int2 maxCoord = int2( width, height ) - 1;
	int2 i0 = clamp( (int2)floor( p ), 0, maxCoord );
	int2 i1 = clamp( (int2)floor( p ) + 1, 0, maxCoord );
	float3 a = tex.Load( int3( i0.x, i0.y, mip ) ).rgb;
	float3 b = tex.Load( int3( i1.x, i0.y, mip ) ).rgb;
	float3 c = tex.Load( int3( i0.x, i1.y, mip ) ).rgb;
	float3 d = tex.Load( int3( i1.x, i1.y, mip ) ).rgb;
	return lerp( lerp( a, b, f.x ), lerp( c, d, f.x ), f.y );
}

#if CAMERA_MODEL
// Safeguarded Newton solve of the forward Brown-Conrady radius.
float2 LensRay( float2 q, float magnification, float rMax )
{
	q *= gLens.w / magnification;
	[branch] if ( all( gLens.xy == 0 ) )
		return q;
	float radius = length( q );
	float lo = 0.0;
	float hi = rMax;
	float r = min( radius, hi );
	[unroll]
	for ( int i = 0; i < 8; ++i )
	{
		float r2 = r * r;
		float value = r * ( 1.0 + r2 * ( gLens.x + r2 * gLens.y ) ) - radius;
		float slope = 1.0 + r2 * ( 3.0 * gLens.x + r2 * 5.0 * gLens.y );
		lo = value < 0.0 ? r : lo;
		hi = value > 0.0 ? r : hi;
		float nextR = r - value / slope;
		r = nextR < lo || nextR > hi ? 0.5 * ( lo + hi ) : nextR;
	}
	return q * ( r / max( radius, 1e-7 ) );
}

float3 SampleLensScene( float2 uv, float2 sceneSize, out float2 greenRay, out float2 sceneUv )
{
	float2 n = 2.0 * ( uv * sceneSize - gViewRect.xy ) / gViewRect.zw - 1.0;
	float2 q = n * gCamera.xy;
	greenRay = q;
	sceneUv = uv;
	[branch] if ( all( gLens.xyz == 0 ) )
		return gScene.SampleLevel( gSceneSampler, uv, 0 ).rgb;
	float rMax = length( gCamera.xy );
	float2 uvMin = ( gViewRect.xy + 0.5 ) / sceneSize;
	float2 uvMax = ( gViewRect.xy + gViewRect.zw - 0.5 ) / sceneSize;
	float2 uvCenter = ( gViewRect.xy + 0.5 * gViewRect.zw ) / sceneSize;
	float2 rayToUv = 0.5 * gViewRect.zw / ( gCamera.xy * sceneSize );
	greenRay = LensRay( q, 1.0, rMax );
	sceneUv = clamp( uvCenter + greenRay * rayToUv, uvMin, uvMax );
	float3 rgb = SampleMip( gScene, sceneUv, 0 );
	[branch] if ( gLens.z != 0.0 )
	{
		float2 uvR = uvCenter + LensRay( q, 1.0 - 0.5 * gLens.z, rMax ) * rayToUv;
		float2 uvB = uvCenter + LensRay( q, 1.0 + 0.5 * gLens.z, rMax ) * rayToUv;
		rgb.r = SampleMip( gScene, clamp( uvR, uvMin, uvMax ), 0 ).r;
		rgb.b = SampleMip( gScene, clamp( uvB, uvMin, uvMax ), 0 ).b;
	}
	return rgb;
}

float VignetteTransmission( float2 ray )
{
	float cosTheta2 = rcp( 1.0 + dot( ray, ray ) );
	float aperture = gCamera.w > 0.0 ? 1.0 - smoothstep( 0.85 * gCamera.w, gCamera.w, length( ray ) ) : 1.0;
	return lerp( 1.0, cosTheta2 * cosTheta2 * aperture, gCamera.z );
}

float3 SensorNoise( uint2 pixel, uint frame )
{
	uint3 h = pixel.x * 747796405u + pixel.y * 2891336453u + frame * 277803737u + uint3( 1, 997, 1999 );
	h = ( ( h >> ( ( h >> 28 ) + 4 ) ) ^ h ) * 277803737u;
	return float3( ( ( h >> 22 ) ^ h ) >> 8 ) * ( 1.0 / 16777216.0 ) - 0.5;
}

float3 CaptureSensor( float3 radiance, float2 pixel )
{
	// Generic overlapping RGB responses and a calibrated CCM. Its negative lobes recover color in
	// unsaturated signals, but amplify errors once a photosite clips.
	const float3x3 response = float3x3( 0.84, 0.12, 0.04, 0.08, 0.86, 0.06, 0.05, 0.15, 0.80 );
	const float3x3 ccm = float3x3( 1.208, -0.160, -0.048, -0.108, 1.193, -0.085, -0.055, -0.214, 1.269 );
	float3 signal = clamp( mul( response, max( radiance, 0.0 ) ), 0.0, gSensor.y );
	[branch] if ( gSensor.w > 0.0 )
	{
		// Independent read noise plus signal-dependent Poisson shot variance.
		float3 sigma = gSensor.w * sqrt( gSensor.z * gSensor.z + 0.01 * signal );
		signal = clamp( signal + 3.464102 * sigma * SensorNoise( (uint2)pixel, (uint)gAwbParams.y ), 0.0, gSensor.y );
	}
#if CAMERA_MODEL == 2
	return lerp( signal + gSensor.z, mul( ccm, signal + gSensor.z ), gAwbParams.w );
#else
	return mul( ccm, signal + gSensor.z );
#endif
}

float3 BradfordBalance( float3 c, float3 gains )
{
	const float3x3 rgbToXyz = float3x3( 0.4124564, 0.3575761, 0.1804375, 0.2126729, 0.7151522, 0.0721750, 0.0193339, 0.1191920, 0.9503041 );
	const float3x3 xyzToRgb = float3x3( 3.2404542, -1.5371385, -0.4985314, -0.9692660, 1.8760108, 0.0415560, 0.0556434, -0.2040259, 1.0572252 );
	const float3x3 bradford = float3x3( 0.8951, 0.2664, -0.1614, -0.7502, 1.7135, 0.0367, 0.0389, -0.0685, 1.0296 );
	const float3x3 invBradford = float3x3( 0.9869929, -0.1470543, 0.1599627, 0.4323053, 0.5183603, 0.0492912, -0.0085287, 0.0400428, 0.9684867 );
	return mul( mul( xyzToRgb, invBradford ), mul( mul( bradford, rgbToXyz ), c ) * gains );
}

float3 ApplyAwb( float3 c )
{
	[branch] if ( gAwbParams.x <= 0.0 )
		return c;
	return BradfordBalance( c, lerp( 1.0, gAwb.Load( int3( 0, 0, 0 ) ).rgb, gAwbParams.x ) );
}

// Camera JPEG-style shoulder and explicit hard bounds in the Rec.709 container.
float3 CameraEncoded( float3 c )
{
	float3 v = saturate( c / gSensor.y );
	return sqrt( v ) * ( 1.5 - 0.5 * v );
}
#endif

#if CAMERA_MODEL == 2
float3 BodycamLinear( float2 uv, float2 lo, float2 hi )
{
	return gScene.SampleLevel( gBodycamLinear, clamp( uv, lo, hi ), 0 ).rgb;
}


float3 BodycamLinearChroma( float2 uv, float2 offsetR, float2 offsetB, float2 lo, float2 hi )
{
	float3 c = BodycamLinear( uv, lo, hi );
	[branch] if ( gLens.z > 0.0 )
	{
		c.r = BodycamLinear( uv + offsetR, lo, hi ).r;
		c.b = BodycamLinear( uv + offsetB, lo, hi ).b;
	}
	return c;
}

float3 BodycamEdgeOptics( float2 sceneSize, float2 center, float2 outputRay, float3 sourceScale, float field,
	float stretch, float2 uvMin, float2 uvMax, float2 pixel, out float2 sceneUv )
{
	float2 uvScale = outputRay / sceneSize;
	sceneUv = center + uvScale * sourceScale.g;
	float2 offsetR = uvScale * ( sourceScale.r - sourceScale.g );
	float2 offsetB = uvScale * ( sourceScale.b - sourceScale.g );
	float3 c = BodycamLinearChroma( sceneUv, offsetR, offsetB, uvMin, uvMax );
	float band = saturate( ( field - 0.70 ) / 0.30 );
	float halfShortAxis = 0.5 * min( gViewRect.z, gViewRect.w );
	float2 psf = band * band * float2( gLens.x + gLens.y, gLens.x ) * halfShortAxis;
	float2 margin = min( sceneUv - uvMin, uvMax - sceneUv ) * sceneSize -
		max( abs( offsetR ), abs( offsetB ) ) * sceneSize;
	float availablePx = max( 0.0, min( margin.x, margin.y ) );
	psf *= min( 1.0, availablePx / max( psf.x, 1e-5 ) );
	float radiusPx = psf.x;
	[branch] if ( radiusPx > 0.75 )
	{
		float2 dir = normalize( outputRay );
		float2 radial = dir * psf.x / sceneSize;
		float2 tangent = float2( -dir.y, dir.x ) * psf.y / sceneSize;
		float s, t;
		sincos( 6.2831853 * InterleavedGradientNoise( floor( pixel ) ), s, t );
		float2 a = 0.65 * ( t * radial + s * tangent );
		float2 b = 0.65 * ( -s * radial + t * tangent );
		float3 blurred = 0.25 * (
			BodycamLinearChroma( sceneUv + a, offsetR, offsetB, uvMin, uvMax ) +
			BodycamLinearChroma( sceneUv - a, offsetR, offsetB, uvMin, uvMax ) +
			BodycamLinearChroma( sceneUv + b, offsetR, offsetB, uvMin, uvMax ) +
			BodycamLinearChroma( sceneUv - b, offsetR, offsetB, uvMin, uvMax ) );
		c = lerp( c, blurred, 0.78 * smoothstep( 0.75, 2.0, radiusPx ) );
	}

	// Share one prefiltered sample for minification; apply its luma footprint continuously
	// to all channels so the subpixel spectral separation survives the blend.
	float mipBlend = saturate( log2( stretch ) ) * smoothstep( 0.0, 2.0, availablePx );
	[branch] if ( mipBlend > 0.0 )
	{
		float3 prefiltered = SampleMip( gPrefilter, sceneUv, 1 ) / max( gSceneBloomFlare.x, 1e-6 );
		const float3 lumaWeights = float3( 0.2126, 0.7152, 0.0722 );
		c = max( 0.0, c + ( dot( prefiltered, lumaWeights ) - dot( c, lumaWeights ) ) * mipBlend );
	}
	return c;
}

float3 BodycamPictureCurve( float3 c )
{
	// Small black crush, raised midtones and a smooth, bounded shoulder.
	float3 v = saturate( ( c / gSensor.y - 0.006 ) / 0.994 );
	return pow( v, 0.70 ) * ( 1.32 - 0.32 * v );
}

float3 BodycamPupil( float field )
{
	const float3 offsets = gSceneBloomFlare.z * float3( -1.0, 0.0, 1.0 );
	const float3 widths = gBodycam.w * float3( 1.0, 1.04, 1.20 );
	float3 signedDistance = clamp( ( 1.0 + offsets - field ) / widths, -1.0, 1.0 );
	// Integral of a uniform defocus disk across the pupil edge (positive is inside).
	return saturate( 0.5 + ( asin( signedDistance ) + signedDistance * sqrt( saturate( 1.0 - signedDistance * signedDistance ) ) ) / 3.14159265 );
}

float4 BodycamStageOutput( float3 c )
{
	return DX12FinishPixel( FinalOutput( float4( saturate( c / gSensor.y ) * gOutput.x, 1 ),
		0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}

float4 BodycamComposite( PS_INPUT input )
{
	float2 sceneSize;
	gScene.GetDimensions( sceneSize.x, sceneSize.y );
	float2 viewPixel = input.vUv0 * sceneSize - gViewRect.xy;
	float halfShortAxis = 0.5 * min( gViewRect.z, gViewRect.w );
	float2 outputRay = viewPixel - 0.5 * gViewRect.zw;
	// Pixel aspect defines the aperture and edge onset, never the central scene geometry.
	float2 sensor = outputRay / ( halfShortAxis * float2( gDirtPeak.x, 1.0 ) );
	float radius = length( sensor );
	float circle = gCamera.w;
	float field = radius / circle;
	[branch] if ( field >= 1.0 + gSceneBloomFlare.z + 1.20 * gBodycam.w )
		return float4( 0, 0, 0, 1 );
	float3 aperture = 1.0;
	[branch] if ( field > 1.0 - gSceneBloomFlare.z - 1.20 * gBodycam.w )
		aperture = BodycamPupil( field );

	const uint stage = (uint)gOutput.z;
	float3 raw;
	[branch] if ( stage == 4 )
		return BodycamStageOutput( gScene.SampleLevel( gSceneSampler, input.vUv0, 0 ).rgb * gSceneBloomFlare.x );
	const float rho0 = 0.68;
	float2 sceneUv = input.vUv0;
	float sourceScaleG = 1.0;
	[branch] if ( field <= rho0 )
	{
		// Exactly the ordinary composite's point lookup: no CA, reconstruction or zoom.
		raw = gScene.SampleLevel( gSceneSampler, input.vUv0, 0 ).rgb;
	}
	else
	{
		float3 k = -gLens.w - 1.0 + gLens.z * float3( 0.5, 0.0, -0.5 );
		float invBand = rcp( 1.0 - rho0 );
		float band = ( field - rho0 ) * invBand;
		float band2 = band * band;
		float3 bend = k * band2 * band;
		float stretch = 1.0 + k.r * ( band2 * band + 3.0 * field * band2 * invBand );

		// Limit the displacement, not the output. Every color maps to a valid source
		// sample, and only the elliptical pupil controls the black silhouette.
		float2 room = ( 0.5 * gViewRect.zw - 0.5 ) / max( abs( outputRay ), 1e-5 ) - 1.0;
		float headroom = max( 0.0, min( room.x, room.y ) );
		float coverage = headroom / max( headroom + bend.r, 1e-5 );
		float3 sourceScale = 1.0 + coverage * bend;
		sourceScaleG = sourceScale.g;
		float2 uvMin = ( gViewRect.xy + 0.5 ) / sceneSize;
		float2 uvMax = ( gViewRect.xy + gViewRect.zw - 0.5 ) / sceneSize;
		raw = BodycamEdgeOptics( sceneSize, ( gViewRect.xy + 0.5 * gViewRect.zw ) / sceneSize,
			outputRay, sourceScale, field, lerp( 1.0, stretch, coverage ), uvMin, uvMax, input.projPos.xy, sceneUv );
	}
	float2 tanPerRadius = ( 2.0 * outputRay / gViewRect.zw ) * gCamera.xy * sourceScaleG;
	float cosTheta2 = rcp( 1.0 + dot( tanPerRadius, tanPerRadius ) );
	float3 transmission = lerp( 1.0, cosTheta2 * cosTheta2, gCamera.z );
	float3 c = raw * gSceneBloomFlare.x;
	[branch] if ( field > rho0 && ( (uint)gOutput.y & 8 ) == 0 )
	{
		// The mip contains a sum of unit-gain blur levels. Split direct and scattered energy.
		float3 scatter = SampleMip( gBloom, sceneUv, 1 );
		float weight = gDirtPeak.z * smoothstep( rho0, 0.86, field );
		c = c * ( 1.0 - weight * gSceneBloomFlare.w ) + scatter * weight;
	}
	[branch] if ( stage == 1 )
		return BodycamStageOutput( raw * gSceneBloomFlare.x );
	float pupilClear = smoothstep( 0.80, 1.0, min( aperture.r, min( aperture.g, aperture.b ) ) );
	// The defocused stop admixes diffuse, low-chroma light. Keep local luminance,
	// but let the pupil's spectral transmission, not the scene's hue, define the fringe.
	[branch] if ( pupilClear < 1.0 )
	{
		float scatterLuma = dot( c, float3( 0.2126, 0.7152, 0.0722 ) );
		c = lerp( scatterLuma.xxx, c, lerp( 0.20, 1.0, pupilClear ) );
	}
	c = CaptureSensor( c * transmission * aperture, input.projPos.xy );
	[branch] if ( stage == 2 )
		return BodycamStageOutput( c );
	float3 gains = gBodycam.rgb;
	[branch] if ( gAwbParams.x > 0.0 )
	{
		float4 estimate = gAwb.Load( int3( 0, 0, 0 ) );
		gains = lerp( gains, estimate.rgb, estimate.a );
	}
	c = BradfordBalance( c, gains );
	[branch] if ( stage == 3 )
		return BodycamStageOutput( c );
	float luma = dot( max( c, 0 ), float3( 0.2126, 0.7152, 0.0722 ) );
	// Leave the calibrated spectral pupil intact where it blocks light. Saturation and
	// highlight recovery operate on the image interior, not the wavelength-dependent stop.
	float y = luma / gSensor.y;
	// At low signal, chroma has poorer SNR than luma. Compress it without lifting black.
	float chromaSNR = lerp( 0.44, 1.0, smoothstep( 0.07, 0.24, y ) );
	c = lerp( luma.xxx, c, lerp( 1.0, gSceneBloomFlare.y * chromaSNR, pupilClear ) );
	c = lerp( c, gSensor.y * saturate( 1.12 * y ).xxx, pupilClear * gAwbParams.z * smoothstep( 0.46, 0.90, y ) );
	float3 encoded = BodycamPictureCurve( c );
	// Fade the electronic pedestal and dither only at the end of the disk tail.
	float tail = smoothstep( 0.0, 0.015, max( aperture.r, max( aperture.g, aperture.b ) ) );
	encoded *= tail;
	if ( ( (uint)gOutput.y & 1 ) == 0 )
		encoded += tail * ( InterleavedGradientNoise( input.projPos.xy ) - 0.5 ) / 255.0;
	return DX12FinishPixel( FinalOutput( float4( SRGBToLinear( encoded ) * gOutput.x, 1 ),
		0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}
#endif

float4 main( PS_INPUT input ) : SV_Target0
{
#if CAMERA_MODEL == 2
	return BodycamComposite( input );
#else
	float2 uv = input.vUv0;
	uint flags = (uint)gOutput.y;
	float2 sceneUv = uv;
#if CAMERA_MODEL
	float2 sceneSize;
	gScene.GetDimensions( sceneSize.x, sceneSize.y );
	float2 ray;
	float3 scene = SampleLensScene( uv, sceneSize, ray, sceneUv );
	float transmission = VignetteTransmission( ray );
	scene = ( scene * transmission ) * gSceneBloomFlare.x;
#else
	float3 scene = gScene.SampleLevel( gSceneSampler, uv, 0 ).rgb * gSceneBloomFlare.x;
#endif
	// Eligible sharpen views map one scene texel to one pixel. Each pixel's
	// two in-quad neighbors have already read their centers. Exchange before
	// the velocity branch so moving lanes also supply their unblurred colors.
	float3 center = 0, inner = 0;
	[branch] if ( gDirtPeak.w > 0 )
	{
		center = gScene.SampleLevel( gSceneSampler, uv, 0 ).rgb;
		inner = QuadReadAcrossX( center ) + QuadReadAcrossY( center );
	}
	bool moving = false;
	[branch] if ( ( flags & 32 ) != 0 )
	{
		float4 v = CompactVelocity( uv );
		bool weapon = v.w >= 1.5;
		float scale = gMotion.z * ( weapon ? gLutWeight4.y : 1.0 );
		float2 velocity = v.xy * scale;
		float speed = length( velocity );
		velocity *= min( 1.0, gMotion.w / max( speed, 1e-6 ) );
		speed = min( speed, gMotion.w );
		moving = v.w >= 0.5 && speed * max( gMotion.x, gMotion.y ) > 0.5;
		[branch] if ( moving )
		{
			// Keep the center tap and the velocity/layer rejection of the very-low
			// gather. Use the center trajectory instead of building dilated tiles.
			float weight = 1.0;
			float jitter = frac( InterleavedGradientNoise( input.projPos.xy ) + 0.61803399 );
			[unroll] for ( int i = 0; i < 4; ++i )
			{
				if ( i == 2 ) continue;
				float t = ( i + jitter ) * 0.25 - 0.5;
				float2 sampleUv = saturate( uv + t * velocity );
				float4 neighbor = CompactVelocity( sampleUv );
				float w = neighbor.w >= 0.5 && ( neighbor.w >= 1.5 ) == weapon ?
					saturate( length( neighbor.xy * scale ) / max( speed * abs( t ), 1e-5 ) ) : 0;
				scene += w * gScene.SampleLevel( gSceneSampler, sampleUv, 0 ).rgb * gSceneBloomFlare.x;
				weight += w;
			}
			scene /= weight;
		}
	}
	// Sharpen scene detail once, before the nonlinear curve. Bound the correction
	// relative to the center to avoid a bright neighbor ringing into a dark pixel.
	[branch] if ( !moving && gDirtPeak.w > 0 )
	{
		int2 pixel = int2( input.projPos.xy );
		uint w, h;
		gScene.GetDimensions( w, h );
		int2 edge = int2( w, h ) - 1;
		int2 outer = ( pixel & 1 ) * 2 - 1;
		float3 ring = inner + gScene.Load( int3( clamp( pixel + int2( outer.x, 0 ), 0, edge ), 0 ) ).rgb +
			gScene.Load( int3( clamp( pixel + int2( 0, outer.y ), 0, edge ), 0 ) ).rgb;
		float3 detail = clamp( center - 0.25 * ring, -0.5 * center, 0.5 * center );
		scene += detail * gDirtPeak.w * gSceneBloomFlare.x;
	}
	float3 bloomT = 0;
	float base = 0;
	[branch] if ( ( flags & 16 ) != 0 )
	{
		float4 field = gFlare.SampleLevel( gFlareSampler, uv, 0 );
		bloomT = field.rgb;
		base = field.a;
	}
	else if ( ( flags & 8 ) == 0 )
		bloomT = BloomTonemap( max( SampleMip( gBloom, sceneUv, (uint)gSceneBloomFlare.w ), 0 ) * gSceneBloomFlare.y );
	float3 dirt = ( flags & 2 ) != 0 ? gDirt.SampleLevel( gDirtSampler, uv, 0 ).rgb * gDirtPeak.x : 0;
	bloomT = Screen( bloomT, dirt * bloomT );
	// The glare buffer is quarter resolution; four diagonal taps one half-resolution texel apart soften its quads.
#if !CAMERA_MODEL
	float2 sceneSize;
	gScene.GetDimensions( sceneSize.x, sceneSize.y );
#endif
	float2 glareStep = 2.0 / sceneSize;
	float3 glare = 0;
	float3 flare = 0;
	[branch] if ( gSceneBloomFlare.z != 0 )
	{
		glare = 0.25 * ( gGlare.SampleLevel( gGlareSampler, uv + glareStep * float2( -1, 1 ), 0 ).rgb +
			gGlare.SampleLevel( gGlareSampler, uv + glareStep, 0 ).rgb +
			gGlare.SampleLevel( gGlareSampler, uv - glareStep, 0 ).rgb +
			gGlare.SampleLevel( gGlareSampler, uv + glareStep * float2( 1, -1 ), 0 ).rgb );
		flare = gFlare.SampleLevel( gFlareSampler, uv, 0 ).rgb;
	}
	float3 lens = ( flare + glare ) * kFlareTint * gSceneBloomFlare.z;
	uint debugView = (uint)gOutput.z;
	uint lutCount = (uint)gOutput.w;
	float3 c = scene + lens;
#if CAMERA_MODEL
	[branch] if ( gSensor.x > 0.0 )
		c = CaptureSensor( c, input.projPos.xy );
	c = ApplyAwb( c );
#endif
	if ( debugView == 2 ) c = flare * kFlareTint * gSceneBloomFlare.z;
	else if ( debugView == 3 ) c = glare * kFlareTint * gSceneBloomFlare.z;
	else if ( debugView == 4 ) c = dirt;
	float peak = max( gDirtPeak.y, 1e-4 );
	float3 e = AgXEncoded( max( c, 0 ), peak );
#if CAMERA_MODEL
	[branch] if ( gSensor.x > 0.0 && gAwbParams.z > 0.0 )
		e = CameraEncoded( c );
#endif
	if ( debugView == 1 ) e = saturate( bloomT );
	else if ( debugView == 0 || debugView > 4 ) e = Screen( e, saturate( bloomT ) );
	[branch] if ( ( flags & 16 ) != 0 )
	{
		const float3 luma = float3( 0.299, 0.587, 0.114 );
		base = lerp( base, 1.0, dot( saturate( bloomT ), luma ) );
		float radial = smoothstep( gContrast.z, gContrast.w, length( uv * 2 - 1 ) );
		float contrast = lerp( gContrast.x, gContrast.y, radial );
		e += max( ( dot( e, luma ) - base ) * contrast, contrast >= 0 ? 0 : -1 );
	}
	if ( ( flags & 4 ) != 0 && lutCount != 0 )
	{
		float3 lutUv = e * ( 31.0 / 32.0 ) + ( 0.5 / 32.0 );
		float3 corrected = e * gLutWeights.x;
		if ( lutCount > 0 ) corrected += gLut0.SampleLevel( gLut0Sampler, lutUv, 0 ).rgb * gLutWeights.y;
		if ( lutCount > 1 ) corrected += gLut1.SampleLevel( gLut1Sampler, lutUv, 0 ).rgb * gLutWeights.z;
		if ( lutCount > 2 ) corrected += gLut2.SampleLevel( gLut2Sampler, lutUv, 0 ).rgb * gLutWeights.w;
		if ( lutCount > 3 ) corrected += gLut3.SampleLevel( gLut3Sampler, lutUv, 0 ).rgb * gLutWeight4.x;
		e = corrected;
	}
	[branch] if ( ( flags & 16 ) != 0 )
	{
		if ( gFinish.z != 0 )
		{
			float v = gVignette.SampleLevel( gVignetteSampler, uv * ( 31.0 / 32.0 ) + 0.5 / 32.0, 0 ).r;
			e *= lerp( 1.0, saturate( v * 0.55 + 0.46 ), gFinish.z );
		}
		if ( gFinish.x > 0 )
		{
			float n0 = gNoise.SampleLevel( gNoiseSampler, uv * 10.0 + gFinish.y, 0 ).g;
			float n1 = gNoise.SampleLevel( gNoiseSampler, uv.yx * 20.0 - gFinish.y, 0 ).g;
			float n = gNoise.SampleLevel( gNoiseSampler, float2( n0, n1 ), 0 ).g;
			float shadow = pow( 1.0 - saturate( dot( e, float3( 0.2125, 0.7154, 0.0721 ) ) ), 12.0 );
			e += ( n * 0.3 - 0.15 ) * gFinish.x * ( 0.8 * shadow + 0.2 );
		}
	}
	// SDR leaves through an 8-bit swap chain: one code value of noise breaks the smooth bloom and flare gradients into
	// grain instead of bands. The HDR swap chain is FP16 and needs none.
	if ( ( flags & 1 ) == 0 )
		e += ( InterleavedGradientNoise( input.projPos.xy ) - 0.5 ) / 255.0;
	float3 d = SRGBToLinear( e ) * peak;
	d *= gOutput.x;
	return DX12FinishPixel( FinalOutput( float4( d, 1 ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
#endif
}
