// Lit detail cards: the runtime direct light arrives per sprite from dx12_detailshadowlit_vs51 (flat TEXCOORD1, with
// the eye position for pixel fog in TEXCOORD2); this stage only samples the card, cuts it out and applies the prelit
// color, tint and fog.
#define DX12_NATIVE_PS 1
#include "dx12_preamble.h"
// DYNAMIC: "PIXELFOGTYPE" "0..2"
// STATIC: "HDRTYPE" "0..2"
#include "common_ps_fxc.h"

Texture2D g_DetailTexture : register( t0 );
SamplerState g_DetailSampler : register( s0 );
cbuffer DetailShadowLitMaterial : register( b1, space1 )
{
	float4 g_DetailSpriteTint; // @legacy ps:c0
};
struct PS_INPUT
{
	float4 position : SV_Position;
	float4 color : COLOR0;
	float2 uv : TEXCOORD0;
	nointerpolation float3 direct : TEXCOORD1;
	nointerpolation float3 eyePosition : TEXCOORD2;
	float4 worldPositionZ : TEXCOORD3;
	float fog : FOG;
};
float4 main( PS_INPUT i ) : SV_Target0
{
	float4 base = g_DetailTexture.Sample( g_DetailSampler, i.uv );
	float alpha = base.a * i.color.a * g_DetailSpriteTint.a;
	DX12AlphaTest( alpha );
	float3 retained = GammaToLinear( i.color.rgb );
	float3 albedo = base.rgb * g_DetailSpriteTint.rgb;
	float4 lit = float4( max( ( retained + i.direct ) * albedo, 0.0f ), alpha );
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, cPixelFogParams, i.eyePosition,
		i.worldPositionZ.xyz, i.worldPositionZ.w );
	return DX12FinishPixel( FinalOutput( lit, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), i.fog );
}
