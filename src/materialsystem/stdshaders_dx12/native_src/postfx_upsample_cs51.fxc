// Native SM5.1 bloom layer sum (MagicBloom's layered bloom on Froyok's pyramid): a 3x3 tent of the previous, smaller
// level (gSrc2) plus the current downsample level (gSrc) when p0 is nonzero. Every level therefore holds the sum of
// itself and all coarser levels, and the composite averages the levels it reads from mip 1. p0 is 0 for the fine mips
// a lower bloom quality dropped: they only carry the coarser sum up.
#include "postfx_common.hlsli"

[numthreads( 8, 8, 1 )]
void main( uint3 id : SV_DispatchThreadID )
{
	if ( id.x >= dstWidth || id.y >= dstHeight )
		return;
	float2 uv = DstUv( id.xy );
	float2 previousSize;
	gSrc2.GetDimensions( previousSize.x, previousSize.y );
	float2 previousTexel = 1.0 / previousSize;
	float3 c = 0;
	[unroll]
	for ( int y = -1; y <= 1; ++y )
	{
		[unroll]
		for ( int x = -1; x <= 1; ++x )
		{
			float weight = ( 2 - abs( x ) ) * ( 2 - abs( y ) ) / 16.0;
			c += weight * gSrc2.SampleLevel( gLinearClamp, uv + float2( x, y ) * previousTexel, 0 ).rgb;
		}
	}
	[branch] if ( p0 != 0 )
		c += gSrc.SampleLevel( gLinearClamp, uv, 0 ).rgb;
	gDst[id.xy] = float4( c, 1 );
}
