// Sixteen groups reduce disjoint regions for each visible flashlight. Decimate while loading: no full-scene copy.
// STATIC: "MSAA" "0..1"
#include "pbr_oct.hlsli"
#include "viewmodel_depth.hlsli"
#include "flashlight_bounce_reduce.hlsli"

cbuffer BounceMeasure : register( b0, space1 )
{
	row_major float4x4 clipToWorld, worldToClip, worldToLight;
	float4 originFar, colorConst, attn, viewport;
	float4 eyeExposure; // camera origin, linear scene output scale
	float4 settings;    // scale, previous sample valid, depth clear, debug
};
#if MSAA
#define SCENE Texture2DMS
#define FETCH( t, p ) t.Load( p, 0 )
#else
#define SCENE Texture2D
#define FETCH( t, p ) t.Load( int3( p, 0 ) )
#endif
SCENE<float4> hdr : register( t0 );
SCENE<float> depth : register( t1 );
SCENE<float2> normals : register( t2 );
SCENE<uint2> stencil : register( t3 );
Texture2D<float4> cookie : register( t4 );
Texture2D<float4> previous : register( t5 );
RWTexture2D<float4> result : register( u0 );
groupshared float4 colors[256], centers[256];
groupshared float4 directions[256];

float3 WorldAt( int2 pixel, float z )
{
	float2 uv = ( float2( pixel ) + 0.5 - viewport.xy ) / viewport.zw;
	float4 h = mul( clipToWorld, float4( uv * float2( 2, -2 ) + float2( -1, 1 ), z, 1 ) );
	return h.xyz / h.w;
}

// Legacy pixels have no RT1. Pick the closer depth on each axis to avoid normals across silhouettes.
float3 LegacyNormal( int2 p, float z, float3 P, float3 toEye )
{
	int2 lo = int2( viewport.xy ), hi = lo + int2( viewport.zw ) - 1;
	int2 l = max( p - int2( 1, 0 ), lo ), r = min( p + int2( 1, 0 ), hi );
	int2 u = max( p - int2( 0, 1 ), lo ), d = min( p + int2( 0, 1 ), hi );
	float zl = FETCH( depth, l ), zr = FETCH( depth, r ), zu = FETCH( depth, u ), zd = FETCH( depth, d );
	float3 dx = abs( zl - z ) < abs( zr - z ) ? P - WorldAt( l, zl ) : WorldAt( r, zr ) - P;
	float3 dy = abs( zu - z ) < abs( zd - z ) ? P - WorldAt( u, zu ) : WorldAt( d, zd ) - P;
	float3 N = cross( dx, dy );
	return N * ( sign( dot( N, toEye ) ) * rsqrt( max( dot( N, N ), 1e-12 ) ) );
}

[numthreads( 16, 16, 1 )] void main( uint3 tid : SV_GroupThreadID, uint3 group : SV_GroupID, uint lane : SV_GroupIndex )
{
	float4 color = 0, center = 0;
	float3 normal = 0;
	float fluxSum = 0;
	uint cw, ch;
	cookie.GetDimensions( cw, ch );
	for ( uint y = ( group.y * 16 + tid.y ) * 8 + 4; y < viewport.w; y += 512 )
		for ( uint x = ( group.x * 16 + tid.x ) * 8 + 4; x < viewport.z; x += 512 )
		{
			int2 p = int2( viewport.xy ) + int2( x, y );
			float z = FETCH( depth, p );
			if ( z >= settings.z || z < DX12_VIEWMODEL_DEPTH_MAX )
				continue;
			float3 P = WorldAt( p, z );
			float4 q = mul( worldToLight, float4( P, 1 ) );
			if ( q.w <= 0 || any( q.xyz < 0 ) || any( q.xyz > q.w ) )
				continue;
			float3 delta = originFar.xyz - P;
			float d = max( length( delta ), 1 );
			float falloff = saturate( colorConst.w + attn.x / d + attn.y / ( d * d ) ) * saturate( ( originFar.w - d ) / max( 1, 0.4 * originFar.w ) );
			float3 irradiance = colorConst.rgb * falloff * cookie.Load( int3( min( uint2( q.xy / q.w * uint2( cw, ch ) ), uint2( cw, ch ) - 1 ), 0 ) ).rgb;
			float3 N;
			if ( FETCH( stencil, p ).y & 128 )
				N = PBR_UnpackNormal( FETCH( normals, p ) );
			else
				N = LegacyNormal( p, z, P, eyeExposure.xyz - P );
			irradiance *= saturate( dot( N, delta / d ) );
			const float3 luma = float3( 0.2126, 0.7152, 0.0722 );
			float flux = dot( irradiance, luma );
			if ( flux < 0.008 )
				continue;
			// No per-pixel probe term in this compute root. Discount ambient-dominated samples before
			// normalizing, or a large weakly lit periphery dominates the tint of the smaller beam core.
			float w = flux * ( flux / ( flux + 0.18 ) );
			float3 albedo = saturate( FETCH( hdr, p ).rgb / max( eyeExposure.w * irradiance, 0.008 ) );
			color += float4( albedo * w, w );
			center += float4( P * w, 1 );
			normal += N * w;
			fluxSum += w * flux;
		}
	colors[lane] = color;
	centers[lane] = center;
	directions[lane] = float4( normal, fluxSum );
	GroupMemoryBarrierWithGroupSync();
	for ( uint step = 128; step; step >>= 1 )
	{
		if ( lane < step )
		{
			colors[lane] += colors[lane + step];
			centers[lane] += centers[lane + step];
			directions[lane] += directions[lane + step];
		}
		GroupMemoryBarrierWithGroupSync();
	}
	if ( lane != 0 )
		return;
	uint tile = group.y * 4 + group.x;
	result[uint2( tile, 0 )] = colors[0];
	result[uint2( tile, 1 )] = centers[0];
	result[uint2( tile, 2 )] = directions[0];
	if ( tile == 0 )
	{
		BounceLight old = (BounceLight)0;
		if ( settings.y )
			old = ReduceBounce( previous );
		result[uint2( 0, 3 )] = old.positionValid;
		result[uint2( 1, 3 )] = old.colorDebug;
		result[uint2( 2, 3 )] = float4( originFar.xyz, settings.x );
		[unroll] for ( int i = 0; i < 4; ++i ) result[uint2( 3 + i, 3 )] = worldToClip[i];
		result[uint2( 7, 3 )] = settings.w;
		float lightLuma = max( dot( colorConst.rgb, float3( 0.2126, 0.7152, 0.0722 ) ), 0.008 );
		result[uint2( 8, 3 )] = float4( colorConst.rgb / lightLuma * eyeExposure.w, 1 );
	}
}
