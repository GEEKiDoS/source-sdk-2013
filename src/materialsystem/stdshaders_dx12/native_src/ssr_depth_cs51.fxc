// Native SM5.1 SSR depth pass: native scene depth -> positive camera-forward view depth of the viewport (R32F,
// viewport-local). Clear pixels and points behind the camera become SSR_DEPTH_FAR. The composite reads the previous
// frame's output to validate reprojected history. No static combos (index 0).
#include "ssr_common.hlsli"
Texture2D<float> gSceneDepth : register( t0, space0 );
RWTexture2D<float> gViewDepth : register( u0, space0 );

[numthreads( 8, 8, 1 )]
void main( uint3 id : SV_DispatchThreadID )
{
	if ( id.x >= uint( gSSRViewport.z ) || id.y >= uint( gSSRViewport.w ) ) return;
	int2 local = int2( id.xy );
	float depth = gSceneDepth.Load( int3( local + int2( gSSRViewport.xy ), 0 ) );
	float viewDepth = SSR_DEPTH_FAR;
	if ( depth != gSSRLimits.x )
	{
		float d = SSR_ViewDepth( SSR_LocalToWorld( float2( local ) + 0.5, depth ) );
		if ( d > 0.0 ) viewDepth = d;
	}
	gViewDepth[id.xy] = viewDepth;
}
