#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/skin_ps20b.fxc for logical skin_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#define DX12_COMBO_FOLD 1
#include "dx12_preamble.h"
// Feature receivers are lit, non-flashlight, non-preview passes only.
// SKIP: $FLASHLIGHT
//======= Copyright Valve Corporation, All rights reserved. ======
// STATIC: "CONVERT_TO_SRGB"             "0..0"
// STATIC: "FLASHLIGHT"                  "0..1"
// FOLD: "CUBEMAP" "0..1" STATIC slot=0
// FOLD: "SELFILLUM" "0..1" STATIC slot=1
// FOLD: "SELFILLUMFRESNEL" "0..1" STATIC slot=2
// FOLD: "LIGHTWARPTEXTURE" "0..1" STATIC slot=3
// FOLD: "PHONGWARPTEXTURE" "0..1" STATIC slot=4
// FOLD: "WRINKLEMAP" "0..1" STATIC slot=5
// FOLD: "DETAIL_BLEND_MODE" "0..6" STATIC slot=6
// FOLD: "DETAILTEXTURE" "0..1" STATIC slot=7
// FOLD: "RIMLIGHT" "0..1" STATIC slot=8
// FOLD: "FLASHLIGHTDEPTHFILTERMODE" "0..2" STATIC slot=9
// FOLD: "FASTPATH_NOBUMP" "0..1" STATIC slot=10
// FOLD: "BLENDTINTBYBASEALPHA" "0..1" STATIC slot=11
// FOLD: "WRITEWATERFOGTODESTALPHA" "0..1" DYNAMIC slot=12
// FOLD: "PIXELFOGTYPE" "0..2" DYNAMIC slot=13
// FOLD: "NUM_LIGHTS" "0..4" DYNAMIC slot=14
// FOLD: "WRITE_DEPTH_TO_DESTALPHA" "0..1" DYNAMIC slot=15
// FOLD: "FLASHLIGHTSHADOWS" "0..1" DYNAMIC slot=16
// FOLD: "PHONG_USE_EXPONENT_FACTOR" "0..1" DYNAMIC slot=17

#define CUBEMAP ( cComboFold[0].x )
#define SELFILLUM ( cComboFold[0].y )
#define SELFILLUMFRESNEL ( cComboFold[0].z )
#define LIGHTWARPTEXTURE ( cComboFold[0].w )
#define PHONGWARPTEXTURE ( cComboFold[1].x )
#define WRINKLEMAP ( cComboFold[1].y )
#define DETAIL_BLEND_MODE ( cComboFold[1].z )
#define DETAILTEXTURE ( cComboFold[1].w )
#define RIMLIGHT ( cComboFold[2].x )
#define FLASHLIGHTDEPTHFILTERMODE ( cComboFold[2].y )
#define FASTPATH_NOBUMP ( cComboFold[2].z )
#define BLENDTINTBYBASEALPHA ( cComboFold[2].w )
#define WRITEWATERFOGTODESTALPHA ( cComboFold[3].x )
#define PIXELFOGTYPE ( cComboFold[3].y )
#define NUM_LIGHTS ( cComboFold[3].z )
#define WRITE_DEPTH_TO_DESTALPHA ( cComboFold[3].w )
#define FLASHLIGHTSHADOWS ( cComboFold[4].x )
#define PHONG_USE_EXPONENT_FACTOR ( cComboFold[4].y )


// PC ps20b/ps30 ranges are identical. CONVERT_TO_SRGB remains a fixed
// compile-time combo because common_ps_fxc.h selects a sampler declaration.
// Legacy SKIPs depend on folded values and are intentionally absent.

#include "common_flashlight_fxc.h"
#include "shader_constant_register_map.h"


cbuffer skin_ps20b : register( b1, space1 )
{
	float4 g_SelfIllumTint_and_DetailBlendFactor; // @legacy ps:c0
	float4 g_DiffuseModulation; // @legacy ps:c1
	float4 g_EnvmapTint_ShadowTweaks; // @legacy ps:c2
	float4 g_SelfIllumScaleBiasExpBrightness; // @legacy ps:c3
	float4 g_EnvMapFresnel; // @legacy ps:c10
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
	float4 g_FlashlightAttenuationFactors_RimMask; // @legacy ps:c13
	float4 g_FlashlightPos_RimBoost; // @legacy ps:c14
	float4x4 g_FlashlightWorldToTexture; // @legacy ps:c15
	float4 g_FresnelSpecParams; // @legacy ps:c19
	float4 g_SpecularRimParams; // @legacy ps:c26
	float4 g_ShaderControls; // @legacy ps:c27
	float4 cFlashlightColor; // @legacy ps:c28
	float4 cFlashlightScreenScale; // @legacy ps:c31
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


#if FLASHLIGHT

#endif


#define g_FlashlightPos					g_FlashlightPos_RimBoost.xyz
#define g_fRimBoost						g_FlashlightPos_RimBoost.w
#define g_FresnelRanges					g_FresnelSpecParams.xyz
#define g_SpecularBoost					g_FresnelSpecParams.w
#define g_SpecularTint					g_SpecularRimParams.xyz
#define g_RimExponent					g_SpecularRimParams.w
#define g_FlashlightAttenuationFactors	g_FlashlightAttenuationFactors_RimMask
#define g_RimMaskControl				g_FlashlightAttenuationFactors_RimMask.x
#define g_SelfIllumMaskControl			g_EnvMapFresnel.w
#define g_fBaseMapAlphaPhongMask		g_ShaderControls.x
#define g_fTintReplacementControl		g_ShaderControls.z
#define g_fInvertPhongMask				g_ShaderControls.w

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );	// Base map, selfillum in alpha
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D SpecularWarpSampler_Texture : register( t1 );
SamplerState SpecularWarpSampler_Sampler : register( s1 );	// Specular warp sampler
static const DX12Sampler2D SpecularWarpSampler = { SpecularWarpSampler_Texture, SpecularWarpSampler_Sampler };
Texture2D DiffuseWarpSampler_Texture : register( t2 );
SamplerState DiffuseWarpSampler_Sampler : register( s2 );	// Diffuse lighting warp sampler
static const DX12Sampler1D DiffuseWarpSampler = { DiffuseWarpSampler_Texture, DiffuseWarpSampler_Sampler };
Texture2D NormalMapSampler_Texture : register( t3 );
SamplerState NormalMapSampler_Sampler : register( s3 );	// Normal map, specular mask in alpha
static const DX12Sampler2D NormalMapSampler = { NormalMapSampler_Texture, NormalMapSampler_Sampler };
Texture2D ShadowDepthSampler_Texture : register( t4 );
SamplerComparisonState ShadowDepthSampler_Sampler : register( s4 );	// Flashlight shadow depth map
static const DX12ShadowSampler ShadowDepthSampler = { ShadowDepthSampler_Texture, ShadowDepthSampler_Sampler };
Texture2D NormalizeRandRotSampler_Texture : register( t5 );
SamplerState NormalizeRandRotSampler_Sampler : register( s5 );	// Normalization / RandomRotation samplers
static const DX12Sampler2D NormalizeRandRotSampler = { NormalizeRandRotSampler_Texture, NormalizeRandRotSampler_Sampler };
TextureCube NormalizeRandRotSampler_TextureCUBE : register( t5 );
static const DX12SamplerCube NormalizeRandRotSampler_CUBE = { NormalizeRandRotSampler_TextureCUBE, NormalizeRandRotSampler_Sampler };
Texture2D FlashlightSampler_Texture : register( t6 );
SamplerState FlashlightSampler_Sampler : register( s6 );	// Flashlight cookie
static const DX12Sampler2D FlashlightSampler = { FlashlightSampler_Texture, FlashlightSampler_Sampler };
Texture2D SpecExponentSampler_Texture : register( t7 );
SamplerState SpecExponentSampler_Sampler : register( s7 );	// Specular exponent map
static const DX12Sampler2D SpecExponentSampler = { SpecExponentSampler_Texture, SpecExponentSampler_Sampler };
TextureCube EnvmapSampler_Texture : register( t8 );
SamplerState EnvmapSampler_Sampler : register( s8 );	// Cubic environment map
static const DX12SamplerCube EnvmapSampler = { EnvmapSampler_Texture, EnvmapSampler_Sampler };
Texture2D WrinkleSampler_Texture : register( t9 );
SamplerState WrinkleSampler_Sampler : register( s9 );	// Compression base
static const DX12Sampler2D WrinkleSampler = { WrinkleSampler_Texture, WrinkleSampler_Sampler };
Texture2D StretchSampler_Texture : register( t10 );
SamplerState StretchSampler_Sampler : register( s10 );	// Expansion base
static const DX12Sampler2D StretchSampler = { StretchSampler_Texture, StretchSampler_Sampler };
Texture2D NormalWrinkleSampler_Texture : register( t11 );
SamplerState NormalWrinkleSampler_Sampler : register( s11 );	// Compression normal
static const DX12Sampler2D NormalWrinkleSampler = { NormalWrinkleSampler_Texture, NormalWrinkleSampler_Sampler };
Texture2D NormalStretchSampler_Texture : register( t12 );
SamplerState NormalStretchSampler_Sampler : register( s12 );	// Expansion normal
static const DX12Sampler2D NormalStretchSampler = { NormalStretchSampler_Texture, NormalStretchSampler_Sampler };
Texture2D DetailSampler_Texture : register( t13 );
SamplerState DetailSampler_Sampler : register( s13 );	// Detail texture
static const DX12Sampler2D DetailSampler = { DetailSampler_Texture, DetailSampler_Sampler };
Texture2D SelfIllumMaskSampler_Texture : register( t14 );
SamplerState SelfIllumMaskSampler_Sampler : register( s14 );	// Selfillum mask
static const DX12Sampler2D SelfIllumMaskSampler = { SelfIllumMaskSampler_Texture, SelfIllumMaskSampler_Sampler };

struct PS_INPUT
{
	float4 baseTexCoordDetailTexCoord;
	float3 lightAtten;
	float3 worldVertToEyeVectorXYZ_tangentSpaceVertToEyeVectorZ;
	float3x3 tangentSpaceTranspose;
	// second and third rows use TEXCOORD4 and TEXCOORD5.
	float4 worldPos_atten3;
	float4 projPos_fWrinkleWeight;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float4 baseTexCoord : TEXCOORD0;
	float3 lightAtten : TEXCOORD1;
	float3 worldVertToEyeVector : TEXCOORD2;
	float3x3 tangentSpaceTranspose : TEXCOORD3;
	float4 worldPos_atten3 : TEXCOORD6;
	float4 projPos_fWrinkleWeight : TEXCOORD7;
	float3 worldPos : TEXCOORD8;
	float3 worldNormal : TEXCOORD9;
	float2 shadowResponse : TEXCOORD10;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoordDetailTexCoord = dx12In.baseTexCoord;
	l.lightAtten = dx12In.lightAtten;
	l.worldVertToEyeVectorXYZ_tangentSpaceVertToEyeVectorZ = dx12In.worldVertToEyeVector;
	l.tangentSpaceTranspose = dx12In.tangentSpaceTranspose;
	l.worldPos_atten3 = dx12In.worldPos_atten3;
	l.projPos_fWrinkleWeight = dx12In.projPos_fWrinkleWeight;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if !FLASHLIGHT
	ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	bool bWrinkleMap = WRINKLEMAP != 0;
	bool bDoDiffuseWarp = LIGHTWARPTEXTURE != 0;
	bool bDoSpecularWarp = PHONGWARPTEXTURE != 0;
	bool bFlashlight = FLASHLIGHT != 0;
	bool bSelfIllum = SELFILLUM != 0;
	bool bSelfIllumFresnel = SELFILLUMFRESNEL != 0;
	bool bDoRimLighting = RIMLIGHT != 0;
	bool bCubemap = CUBEMAP != 0;
	bool bBlendTintByBaseAlpha = BLENDTINTBYBASEALPHA != 0;
	bool bDetailTexture = DETAILTEXTURE != 0;
	bool bFastPathNoBump = FASTPATH_NOBUMP != 0;
	bool bPhongUseExponentFactor = PHONG_USE_EXPONENT_FACTOR != 0;
	bool bFlashlightShadows = FLASHLIGHTSHADOWS != 0;
	int nFlashlightDepthFilterMode = FLASHLIGHTDEPTHFILTERMODE;
	int nDetailBlendMode = DETAIL_BLEND_MODE;
	int nNumLights = NUM_LIGHTS;
	int nPixelFogType = PIXELFOGTYPE;

	// Unpacking for convenience
	float fWrinkleWeight = i.projPos_fWrinkleWeight.w;
	float3 vProjPos = i.projPos_fWrinkleWeight.xyz;
	float3 vWorldPos = i.worldPos_atten3.xyz;
	float atten3 = i.worldPos_atten3.w;
	float4 vLightAtten = float4( i.lightAtten, atten3 );

	// Shared by the base and normal wrinkle blends, so keep these in main scope.
	float flWrinkleAmount = 0.0f;
	float flStretchAmount = 0.0f;
	float flTextureAmount = 1.0f;
	if ( bWrinkleMap )
	{
		flWrinkleAmount = saturate( -fWrinkleWeight );
		flStretchAmount = saturate( fWrinkleWeight );
		flTextureAmount = 1.0f - flWrinkleAmount - flStretchAmount;
	}

	float4 baseColor = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.baseTexCoordDetailTexCoord.xy );
	if ( bWrinkleMap )
	{
		float4 wrinkleColor = WrinkleSampler.tex.Sample( WrinkleSampler.smp, i.baseTexCoordDetailTexCoord.xy );
		float4 stretchColor = StretchSampler.tex.Sample( StretchSampler.smp, i.baseTexCoordDetailTexCoord.xy );
		// Apply wrinkle blend to only RGB. Alpha comes from the base texture.
		baseColor.rgb = flTextureAmount * baseColor + flWrinkleAmount * wrinkleColor + flStretchAmount * stretchColor;
	}

	// Also consumed by the post-lighting detail blend.
	float4 detailColor = 0;
	if ( bDetailTexture )
	{
		detailColor = DetailSampler.tex.Sample( DetailSampler.smp, i.baseTexCoordDetailTexCoord.zw );
		baseColor = TextureCombine( baseColor, detailColor, nDetailBlendMode, g_SelfIllumTint_and_DetailBlendFactor.w );
	}

	float fogFactor = CalcPixelFogFactor( nPixelFogType, g_FogParams, g_EyePos_SpecExponent.xyz, vWorldPos.xyz, vProjPos.z );
	float3 vEyeDir = normalize( i.worldVertToEyeVectorXYZ_tangentSpaceVertToEyeVectorZ.xyz );
	float3 vRimAmbientCubeColor = PixelShaderAmbientLight( vEyeDir, cAmbientCube );

	float3 worldSpaceNormal, tangentSpaceNormal;
	float fSpecMask = 1.0f;
	float4 normalTexel = NormalMapSampler.tex.Sample( NormalMapSampler.smp, i.baseTexCoordDetailTexCoord.xy );
	if ( bWrinkleMap )
	{
		float4 wrinkleNormal = NormalWrinkleSampler.tex.Sample( NormalWrinkleSampler.smp, i.baseTexCoordDetailTexCoord.xy );
		float4 stretchNormal = NormalStretchSampler.tex.Sample( NormalStretchSampler.smp, i.baseTexCoordDetailTexCoord.xy );
		normalTexel = flTextureAmount * normalTexel + flWrinkleAmount * wrinkleNormal + flStretchAmount * stretchNormal;
	}

	if ( !bFastPathNoBump )
	{
		tangentSpaceNormal = lerp( 2.0f * normalTexel.xyz - 1.0f, float3( 0, 0, 1 ), g_fBaseMapAlphaPhongMask );
		fSpecMask = lerp( normalTexel.a, baseColor.a, g_fBaseMapAlphaPhongMask );
	}
	else
	{
		tangentSpaceNormal = float3( 0, 0, 1 );
		fSpecMask = baseColor.a;
	}

	worldSpaceNormal = normalize( mul( i.tangentSpaceTranspose, tangentSpaceNormal ) );
	float fFresnelRanges = Fresnel( worldSpaceNormal, vEyeDir, g_FresnelRanges );
	float fRimFresnel = Fresnel4( worldSpaceNormal, vEyeDir );
	float3 vReflect = 2 * worldSpaceNormal * dot( worldSpaceNormal, vEyeDir ) - vEyeDir;

	float3 diffuseLighting = float3( 1.0f, 1.0f, 1.0f );
	float3 envMapColor = float3( 0.0f, 0.0f, 0.0f );
	if( !bFlashlight )
	{
		// Summation of diffuse illumination from all local lights
		diffuseLighting = PixelShaderDoLighting(vWorldPos,worldSpaceNormal,float3( 0.0f, 0.0f, 0.0f ),false,true,vLightAtten,cAmbientCube, NormalizeRandRotSampler_CUBE,nNumLights,cLightInfo,true,// These parameters aren't passed by generic shaders:
			false,1.0f,bDoDiffuseWarp,DiffuseWarpSampler );

		if( bCubemap )
		{
			float fEnvMapMask;
			if ( bSelfIllumFresnel )
			{
				// Match the 2.0 version of vertexlitgeneric.
				fEnvMapMask = lerp( baseColor.a, g_fInvertPhongMask, g_EnvmapTint_ShadowTweaks.w );
			}
			else
			{
				fEnvMapMask = lerp( baseColor.a, fSpecMask, g_EnvmapTint_ShadowTweaks.w );
			}

			envMapColor = (ENV_MAP_SCALE *
				lerp( 1, fFresnelRanges, g_EnvMapFresnel.x ) *
				lerp( fEnvMapMask, 1 - fEnvMapMask, g_fInvertPhongMask )) *
				EnvmapSampler.tex.Sample( EnvmapSampler.smp, vReflect ) * g_EnvmapTint_ShadowTweaks.xyz;
		}
	}

	float3 specularLighting = float3( 0.0f, 0.0f, 0.0f );
	float3 rimLighting = float3( 0.0f, 0.0f, 0.0f );
	float3 vSpecularTint = 1;
	float fRimMask = 0;
	float fSpecExp = 1;

	if ( !bFastPathNoBump )
	{
		float4 vSpecExpMap = SpecExponentSampler.tex.Sample( SpecExponentSampler.smp, i.baseTexCoordDetailTexCoord.xy );
		if ( !bFlashlight )
		{
			fRimMask = lerp( 1.0f, vSpecExpMap.a, g_RimMaskControl );
		}

		if ( bPhongUseExponentFactor )
		{
			fSpecExp = 1.0f + g_EyePos_SpecExponent.w * vSpecExpMap.r;
		}
		else
		{
			fSpecExp = (g_EyePos_SpecExponent.w >= 0.0) ? g_EyePos_SpecExponent.w : (1.0f + 149.0f * vSpecExpMap.r);
		}

		// If constant tint is negative, tint with albedo, based upon scalar tint map.
		vSpecularTint = lerp( float3( 1.0f, 1.0f, 1.0f ), baseColor.rgb, vSpecExpMap.g );
		vSpecularTint = (g_SpecularTint.r >= 0.0) ? g_SpecularTint.rgb : vSpecularTint;
	}
	else
	{
		fSpecExp = max( g_EyePos_SpecExponent.w, 0 );
	}

	float3 albedo = baseColor.rgb;
	if ( !bFlashlight )
	{
		// Summation of specular from all local lights besides the flashlight
		PixelShaderDoSpecularLighting( vWorldPos, worldSpaceNormal,
			fSpecExp, vEyeDir, vLightAtten,
			nNumLights, cLightInfo, false, 1.0f, bDoSpecularWarp,
			SpecularWarpSampler, fFresnelRanges, bDoRimLighting, g_RimExponent,

			// Outputs
			specularLighting, rimLighting );
	// Selected direct: decoded linear units, before albedo/output.
#if !FLASHLIGHT
	smd = ShadowMap_GatherDirect( smr, ShadowMap_WithSpecular( ShadowMap_ShadeHalfLambert( worldSpaceNormal, true ), vEyeDir, fSpecExp ) );
	diffuseLighting += smd.diffuse;
	specularLighting += smd.specular * ( bDoSpecularWarp ? fFresnelRanges : 1.0f );
#endif
	}
	else
	{
		#if FLASHLIGHT
			float4 flashlightSpacePosition = mul( float4( vWorldPos, 1.0f ), g_FlashlightWorldToTexture );
			DoSpecularFlashlight( g_FlashlightPos, vWorldPos, flashlightSpacePosition, worldSpaceNormal, g_FlashlightAttenuationFactors.xyz, g_FlashlightAttenuationFactors.w, FlashlightSampler, ShadowDepthSampler, NormalizeRandRotSampler, nFlashlightDepthFilterMode, bFlashlightShadows, true, vProjPos.xy / vProjPos.z, fSpecExp, vEyeDir, bDoSpecularWarp, SpecularWarpSampler, fFresnelRanges, g_EnvmapTint_ShadowTweaks, // These two values are output
				diffuseLighting, specularLighting, cFlashlightColor, cFlashlightScreenScale );
		#endif
	}

	// If we didn't already apply Fresnel to specular warp, modulate the specular.
	if ( !bDoSpecularWarp )
		fSpecMask *= fFresnelRanges;
	specularLighting *= fSpecMask * g_SpecularBoost;

	if ( bBlendTintByBaseAlpha )
	{
		float3 tintedColor = albedo * g_DiffuseModulation.rgb;
		tintedColor = lerp( tintedColor, g_DiffuseModulation.rgb, g_fTintReplacementControl );
		albedo = lerp( albedo, tintedColor, baseColor.a );
	}
	else
	{
		albedo = albedo * g_DiffuseModulation.rgb;
	}

	float3 diffuseComponent = albedo * diffuseLighting;
	if ( bSelfIllum && !bFlashlight )
	{
		if ( bSelfIllumFresnel )
		{
			// Use the vertex normal to fake an internal glow.
			float3 vVertexNormal = normalize( float3( i.tangentSpaceTranspose[0].z, i.tangentSpaceTranspose[1].z, i.tangentSpaceTranspose[2].z ) );
			float flSelfIllumFresnel = (pow( saturate( dot( vVertexNormal.xyz, vEyeDir.xyz ) ), g_SelfIllumScaleBiasExpBrightness.z ) * g_SelfIllumScaleBiasExpBrightness.x) + g_SelfIllumScaleBiasExpBrightness.y;
			diffuseComponent = lerp( diffuseComponent, g_SelfIllumTint_and_DetailBlendFactor.rgb * albedo * g_SelfIllumScaleBiasExpBrightness.w, baseColor.a * saturate( flSelfIllumFresnel ) );
		}
		else
		{
			float3 vSelfIllumMask = SelfIllumMaskSampler.tex.Sample( SelfIllumMaskSampler.smp, i.baseTexCoordDetailTexCoord.xy );
			vSelfIllumMask = lerp( baseColor.aaa, vSelfIllumMask, g_SelfIllumMaskControl );
			diffuseComponent = lerp( diffuseComponent, g_SelfIllumTint_and_DetailBlendFactor.rgb * albedo, vSelfIllumMask );
		}
		diffuseComponent = max( 0.0f, diffuseComponent );
	}

	if ( bDetailTexture )
	{
		diffuseComponent = TextureCombinePostLighting( diffuseComponent, detailColor,
			nDetailBlendMode, g_SelfIllumTint_and_DetailBlendFactor.w );
	}

	if ( bDoRimLighting && !bFlashlight )
	{
		float fRimMultiply = fRimMask * fRimFresnel;
		rimLighting *= fRimMultiply;
		specularLighting = max( specularLighting, rimLighting );
		specularLighting += (vRimAmbientCubeColor * g_fRimBoost) * saturate( fRimMultiply * worldSpaceNormal.z );
	}

	float3 result = specularLighting * vSpecularTint + envMapColor + diffuseComponent;
	float alpha;
	if ( WRITEWATERFOGTODESTALPHA != 0 && nPixelFogType == PIXEL_FOG_TYPE_HEIGHT )
	{
		alpha = fogFactor;
	}
	else
	{
		alpha = g_DiffuseModulation.a;
		if ( !bSelfIllum && !bBlendTintByBaseAlpha )
		{
			alpha = lerp( baseColor.a * alpha, alpha, g_fBaseMapAlphaPhongMask );
		}
	}

	bool bWriteDepthToAlpha = (WRITE_DEPTH_TO_DESTALPHA != 0) && (WRITEWATERFOGTODESTALPHA == 0);
	
#if !FLASHLIGHT
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( float4( result, alpha ), fogFactor, nPixelFogType, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, vProjPos.z ), dx12In.fog );
	return ShadowMap_Debug( smr, smd, dx12Lit0_0 );
	}
#else
	return DX12FinishPixel( FinalOutput( float4( result, alpha ), fogFactor, nPixelFogType, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, vProjPos.z ), dx12In.fog );
#endif

}
