// HIGHLIGHT_SAMPLERS: 8
// Native SM5.1 rewrite of materialsystem/stdshaders/water_ps2x.fxc for logical water_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"				"0..1"	 [= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// STATIC: "BASETEXTURE"					"0..1"
// STATIC: "MULTITEXTURE"					"0..1"
// STATIC: "REFLECT"						"0..1"
// STATIC: "REFRACT"						"0..1"
// STATIC: "ABOVEWATER"						"0..1"
// STATIC: "BLURRY_REFRACT"					"0..1"

// When we turn NORMAL_DECODE_MODE on, this shader only needs 0..1, not 0..2
// STATIC: "NORMAL_DECODE_MODE"				"0..0"

// DYNAMIC: "PIXELFOGTYPE"					"0..2"
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"		"0..1"

// SKIP: $MULTITEXTURE && $BASETEXTURE

#if defined(DX12_LEGACY_PS20)
#	define BLURRY_REFRACT 0
#	define WRITE_DEPTH_TO_DESTALPHA 0
#endif

#include "water_ps2x_helper.h"


Texture2D RefractSampler_Texture : register( t0 );
SamplerState RefractSampler_Sampler : register( s0 );
static const DX12Sampler2D RefractSampler = { RefractSampler_Texture, RefractSampler_Sampler };
#if BASETEXTURE
Texture2D BaseTextureSampler_Texture : register( t1 );
SamplerState BaseTextureSampler_Sampler : register( s1 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
#endif
Texture2D ReflectSampler_Texture : register( t2 );
SamplerState ReflectSampler_Sampler : register( s2 );
static const DX12Sampler2D ReflectSampler = { ReflectSampler_Texture, ReflectSampler_Sampler };
#if BASETEXTURE
Texture2D LightmapSampler_Texture : register( t3 );
SamplerState LightmapSampler_Sampler : register( s3 );
static const DX12Sampler2D LightmapSampler = { LightmapSampler_Texture, LightmapSampler_Sampler };
#endif
Texture2D NormalSampler_Texture : register( t4 );
SamplerState NormalSampler_Sampler : register( s4 );
static const DX12Sampler2D NormalSampler = { NormalSampler_Texture, NormalSampler_Sampler };


cbuffer water_ps2x : register( b1, space1 )
{
	HALF4 vRefractTint; // @legacy ps:c1
	HALF4 vReflectTint; // @legacy ps:c4
	float4 g_ReflectRefractScale; // @legacy ps:c5
	HALF4 g_WaterFogColor; // @legacy ps:c6
	HALF4 g_WaterFogParams; // @legacy ps:c7
	float3 g_EyePos; // @legacy ps:c9
};
#define g_PixelFogParams cPixelFogParams	// engine-owned (DX12PSEngine)


#define g_WaterFogStart			g_WaterFogParams.x
#define g_WaterFogEndMinusStart	g_WaterFogParams.y
#define g_Reflect_OverBright	g_WaterFogParams.z

struct PS_INPUT
{
	float2 vBumpTexCoord;
	half3 vTangentEyeVect;
	float4 vReflectXY_vRefractYX;
	float4 vWorldPos_projPosW;
	float4 vProjPos;
	float screenCoord;
#if MULTITEXTURE
	float4 vExtraBumpTexCoord;
#endif
#if BASETEXTURE
// CENTROID: TEXCOORD6
	HALF4 lightmapTexCoord1And2;
// CENTROID: TEXCOORD7
	HALF4 lightmapTexCoord3;
#endif

	float4 fogFactorW;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vProjPos_POSITION : SV_Position;
#if !defined( _X360 )
	float vFog : FOG;
#endif
	float2 vBumpTexCoord : TEXCOORD0;
	float3 vTangentEyeVect : TEXCOORD1;
	float4 vReflectXY_vRefractYX : TEXCOORD2;
	float4 vWorldPos_projPosW : TEXCOORD3;
	float4 vProjPos : TEXCOORD4;
	float screenCoord : TEXCOORD5;
#if MULTITEXTURE
	centroid  float4 vExtraBumpTexCoord : TEXCOORD6;
#endif
#if BASETEXTURE
	centroid  HALF4 lightmapTexCoord1And2 : TEXCOORD6;
	centroid  HALF4 lightmapTexCoord3 : TEXCOORD7;
#endif
	float4 fogFactorW : COLOR1;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vBumpTexCoord = dx12In.vBumpTexCoord;
	l.vTangentEyeVect = dx12In.vTangentEyeVect;
	l.vReflectXY_vRefractYX = dx12In.vReflectXY_vRefractYX;
	l.vWorldPos_projPosW = dx12In.vWorldPos_projPosW;
	l.vProjPos = dx12In.vProjPos;
	l.screenCoord = dx12In.screenCoord;
#if MULTITEXTURE
#if ( ( MULTITEXTURE ) )
	l.vExtraBumpTexCoord = dx12In.vExtraBumpTexCoord;
#endif
#if ( ( BASETEXTURE ) )
	l.vExtraBumpTexCoord = dx12In.lightmapTexCoord1And2;
#endif
#endif
#if BASETEXTURE
#if ( ( MULTITEXTURE ) )
	l.lightmapTexCoord1And2 = dx12In.vExtraBumpTexCoord;
#endif
#if ( ( BASETEXTURE ) )
	l.lightmapTexCoord1And2 = dx12In.lightmapTexCoord1And2;
#endif
#if ( ( BASETEXTURE ) )
	l.lightmapTexCoord3 = dx12In.lightmapTexCoord3;
#endif
#endif
	l.fogFactorW = dx12In.fogFactorW;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	DrawWater_params_t params;

	params.vBumpTexCoord = i.vBumpTexCoord;
#if MULTITEXTURE
	params.vExtraBumpTexCoord = i.vExtraBumpTexCoord;
#endif
	params.vReflectXY_vRefractYX = i.vReflectXY_vRefractYX;
	params.w = i.vWorldPos_projPosW.w;
	params.vReflectRefractScale = g_ReflectRefractScale;
	params.fReflectOverbright = g_Reflect_OverBright;
	params.vReflectTint = vReflectTint;
	params.vRefractTint = vRefractTint;
	params.vTangentEyeVect = i.vTangentEyeVect;
	params.waterFogColor = g_WaterFogColor;
#if BASETEXTURE
	params.lightmapTexCoord1And2 = i.lightmapTexCoord1And2;
	params.lightmapTexCoord3 = i.lightmapTexCoord3;
#endif
	params.vProjPos = i.vProjPos;
	params.pixelFogParams = g_PixelFogParams;
	params.fWaterFogStart = g_WaterFogStart;
	params.fWaterFogEndMinusStart = g_WaterFogEndMinusStart;
	params.vEyePos = g_EyePos;
	params.vWorldPos = i.vWorldPos_projPosW.xyz;

	float4 result;
	float fogFactor;
	DrawWater( params, 
			   // yay. . can't put sampler in a struct.
#if BASETEXTURE
			   BaseTextureSampler, 
			   LightmapSampler, 
#endif
			   NormalSampler, RefractSampler, ReflectSampler,
			   result, fogFactor );

	return DX12FinishPixel( FinalOutput( float4( result.rgb, 1.0f ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_NONE, (WRITE_DEPTH_TO_DESTALPHA != 0), i.vProjPos.z ), dx12In.vFog );
}

