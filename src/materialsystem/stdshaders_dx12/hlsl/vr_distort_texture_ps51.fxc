// Native SM5.1 rewrite of materialsystem/stdshaders/vr_distort_texture_ps2x.fxc for logical vr_distort_texture_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
// DYNAMIC: "CMBO_USERENDERTARGET" "0..1"

#include "shader_constant_register_map.h"
#include "common_ps_fxc.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D DistortMapTextureSampler_Texture : register( t1 );
SamplerState DistortMapTextureSampler_Sampler : register( s1 );
static const DX12Sampler2D DistortMapTextureSampler = { DistortMapTextureSampler_Texture, DistortMapTextureSampler_Sampler };


struct PS_INPUT
{
	float2 vBaseTexCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vProjPos : SV_Position;
	float2 vBaseTexCoord : TEXCOORD0;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vBaseTexCoord = dx12In.vBaseTexCoord;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float2 vOriginal = i.vBaseTexCoord.xy;

	float4 vRead = DistortMapTextureSampler.tex.Sample( DistortMapTextureSampler.smp, vOriginal );

	float2 vGreen;
	vGreen.r = ( vRead.x + vRead.z ) / 2.0;
	vGreen.g = ( vRead.y + vRead.w ) / 2.0;

	float4 vFinal;
	vFinal.r = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, vRead.xy ).r;
	vFinal.ga = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, vGreen ).ga;
	vFinal.b = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, vRead.zw ).b;
	
	float fBoundsCheck;
	#if ( CMBO_USERENDERTARGET )
	{
		fBoundsCheck = saturate( dot( (vGreen.xy < float2(0.01,0.01)), float2(1,1)) + dot( (vGreen.xy > float2(0.99,0.99)), float2(1,1)) );
	}
	#else
	{
		fBoundsCheck = saturate( dot( (vGreen.xy < float2(0.005,0.005)), float2(1,1)) + dot( (vGreen.xy > float2(0.995,0.995)), float2(1,1))
			+ (vGreen.x > 0.495 && vGreen.x < 0.505 ) );
	}
	#endif

	vFinal.xyz = lerp( vFinal.xyz, float3(0,0,0), fBoundsCheck );

	return DX12FinishPixel( vFinal, 0.0f );
}


