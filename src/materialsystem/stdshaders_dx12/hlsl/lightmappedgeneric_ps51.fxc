// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"	"0..1"
// DYNAMIC: "BICUBIC_LIGHTMAP"           "0..1"

//  SKIP: $SEAMLESS && $RELIEF_MAPPING

//	SKIP: (! $DETAILTEXTURE) && ( $DETAIL_BLEND_MODE != 0 )

//  SKIP: $SEAMLESS && ( $OUTLINE || $SOFTEDGES)
