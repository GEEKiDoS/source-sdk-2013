#if NORMAL_DECODE_MODE == NORM_DECODE_ATI2N_ALPHA
Texture2D AlphaMapSampler2_Texture : register( t10 );
SamplerState AlphaMapSampler2_Sampler : register( s10 );	// alpha
static const DX12Sampler2D AlphaMapSampler2 = { AlphaMapSampler2_Texture, AlphaMapSampler2_Sampler };
#else
