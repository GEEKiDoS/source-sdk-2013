// Native SM5.1 rewrite of materialsystem/stdshaders/lpreview_output_ps2x.fxc for logical lpreview_output_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#define HDRTYPE HDR_TYPE_NONE
#define HDRENABLED 0
#include "common_ps_fxc.h"

Texture2D InputTexture_Texture : register( t0 );
SamplerState InputTexture_Sampler : register( s0 );
static const DX12Sampler2D InputTexture = { InputTexture_Texture, InputTexture_Sampler };
Texture2D Albedo_Texture : register( t1 );
SamplerState Albedo_Sampler : register( s1 );
static const DX12Sampler2D Albedo = { Albedo_Texture, Albedo_Sampler };
Texture2D Flags_Texture : register( t2 );
SamplerState Flags_Sampler : register( s2 );
static const DX12Sampler2D Flags = { Flags_Texture, Flags_Sampler };

struct PS_INPUT
{
	float2 texCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord : TEXCOORD0;
	float2 ZeroTexCoord : TEXCOORD1;
	float2 bloomTexCoord : TEXCOORD2;
	float4 vColor : TEXCOORD3;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.texCoord = dx12In.baseTexCoord;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float3 flags_check=Flags.tex.Sample( Flags.smp, i.texCoord );
	float3 input=InputTexture.tex.Sample( InputTexture.smp, i.texCoord );
	float3 albedo=Albedo.tex.Sample( Albedo.smp, i.texCoord );
	input=lerp(albedo,input,flags_check.r);
	return DX12FinishPixel( FinalOutput( float4(input.xyz,1), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}
