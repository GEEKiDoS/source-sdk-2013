// Native SM5.1 rewrite of materialsystem/stdshaders/sfm_integercombine_ps2x.fxc for logical sfm_integercombine_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D TexSampler0_Texture : register( t0 );
SamplerState TexSampler0_Sampler : register( s0 );
static const DX12Sampler2D TexSampler0 = { TexSampler0_Texture, TexSampler0_Sampler };
Texture2D TexSampler1_Texture : register( t1 );
SamplerState TexSampler1_Sampler : register( s1 );
static const DX12Sampler2D TexSampler1 = { TexSampler1_Texture, TexSampler1_Sampler };

struct PS_INPUT
{
	float2 tc0;
	float2 tc1;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord : TEXCOORD0;
	float2 bloomTexCoord : TEXCOORD1;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.tc0 = dx12In.baseTexCoord;
	l.tc1 = dx12In.bloomTexCoord;
	return l;
}


cbuffer sfm_integercombine_ps2x : register( b1, space1 )
{
	float4 bloomamount; // @legacy ps:c0
};


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	// Just sample the input textures
	float4 c0 = TexSampler0.tex.Sample( TexSampler0.smp, i.tc0 );
	float4 c1 = TexSampler1.tex.Sample( TexSampler1.smp, i.tc1 );

	// Add in bloom and return
	return DX12FinishPixel( FinalOutput( c0 + bloomamount.xxxx * c1, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}

