#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/skin_vs20.fxc for logical skin_vs30 (legacy profile vs30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs30 set.
#define DX12_LEGACY_VS30 1
#include "dx12_preamble.h"
// Feature receivers are lit, non-flashlight, non-preview passes only.
// SKIP: $LIGHTING_PREVIEW != 0
//======= Copyright (c) 1996-2007, Valve Corporation, All rights reserved. ======

//  STATIC: "DECAL"						"0..1"

//  DYNAMIC: "COMPRESSED_VERTS"			"0..1"
//	DYNAMIC: "DOWATERFOG"				"0..1"
//	DYNAMIC: "SKINNING"					"0..1"
//  DYNAMIC: "LIGHTING_PREVIEW"			"0..1"
//  DYNAMIC: "MORPHING"					"0..1"

// If using static control flow on Direct3D, we should use the NUM_LIGHTS=0 combo

#include "common_vs_fxc.h"

static const bool g_bSkinning		= SKINNING ? true : false;
static const int g_FogType			= DOWATERFOG;


cbuffer skin_vs20 : register( b2, space1 )
{
	float4 cBaseTexCoordTransform[2]; // @legacy vs:c48
	float4 cDetailTexCoordTransform[2]; // @legacy vs:c52
	float3 cMorphTargetTextureDim; // @legacy vs:c54
	float4 cMorphSubrect; // @legacy vs:c55
};


#ifdef DX12_LEGACY_VS30
// NOTE: cMorphTargetTextureDim.xy = target dimensions,
//		 cMorphTargetTextureDim.z = 4tuples/morph


Texture2D morphSampler_Texture : register( t0 );
SamplerState morphSampler_Sampler : register( s0 );
static const DX12Sampler2D morphSampler = { morphSampler_Texture, morphSampler_Sampler };
#endif


//-----------------------------------------------------------------------------
// Input vertex format
//-----------------------------------------------------------------------------
struct VS_INPUT
{
	// This is all of the stuff that we ever use.
	float4 vPos;
	float4 vBoneWeights;
	float4 vBoneIndices;
	float4 vNormal;
	float4 vColor;
	float3 vSpecular;
	// make these float2's and stick the [n n 0 1] in the dot math.
	float4 vTexCoord0;
	float4 vTexCoord1;
	float4 vTexCoord2;
	float4 vTexCoord3;
	float3 vTangentS;
	float3 vTangentT;
	float4 vUserData;

	// Position and normal/tangent deltas
	float4 vPosFlex;
	float4 vNormalFlex;

#ifdef DX12_LEGACY_VS30
	float vVertexID;
#endif
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
#if COMPRESSED_VERTS
	uint4 vTangentS : TANGENT;
#else
	float4 vTangentS : TANGENT;
#endif
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
	float4 vColor : COLOR0;
	float4 vSpecular : COLOR1;
	float4 vTexCoord0 : TEXCOORD0;
	float4 vTexCoord1 : TEXCOORD1;
	float4 vTexCoord2 : TEXCOORD2;
	float4 vTexCoord3 : TEXCOORD3;
	float3 vTangentT : BINORMAL;
	float4 vPosFlex : POSITION1;
	float4 vNormalFlex : NORMAL1;
#ifdef DX12_LEGACY_VS30
	float vVertexID : POSITION2;
#endif
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
	l.vColor = i.vColor;
	l.vSpecular = ( i.vSpecular ).xyz;
	l.vTexCoord0 = i.vTexCoord0;
	l.vTexCoord1 = i.vTexCoord1;
	l.vTexCoord2 = i.vTexCoord2;
	l.vTexCoord3 = i.vTexCoord3;
#if COMPRESSED_VERTS
	l.vTangentS = ( (float4)i.vTangentS ).xyz;
#else
	l.vTangentS = ( i.vTangentS ).xyz;
#endif
	l.vTangentT = i.vTangentT;
#if COMPRESSED_VERTS
	l.vUserData = (float4)i.vTangentS;
#else
	l.vUserData = i.vTangentS;
#endif
	l.vPosFlex = i.vPosFlex;
	l.vNormalFlex = i.vNormalFlex;
#ifdef DX12_LEGACY_VS30
	l.vVertexID = i.vVertexID;
#endif
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float4 baseTexCoord : TEXCOORD0; 			// includes detail tex coord
	float3 lightAtten : TEXCOORD1;
	float3 worldVertToEyeVector : TEXCOORD2;
	float3x3 tangentSpaceTranspose : TEXCOORD3;
	float4 worldPos_atten3 : TEXCOORD6;
	float4 projPos_fWrinkleWeight : TEXCOORD7;
	float3 worldPos : TEXCOORD8;
	float3 worldNormal : TEXCOORD9;
	float2 shadowResponse : TEXCOORD10;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
#if !defined( _X360 )    
#endif
	return o;
}


//-----------------------------------------------------------------------------
// Main shader entry point
//-----------------------------------------------------------------------------
VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float4 vPosition = v.vPos;
	float3 vNormal;
	float4 vTangent;
	DecompressVertex_NormalTangent( v.vNormal, v.vUserData, vNormal, vTangent );

#if !defined( DX12_LEGACY_VS30 ) || !MORPHING
	ApplyMorph( v.vPosFlex, v.vNormalFlex, 
		vPosition.xyz, vNormal, vTangent.xyz, o.projPos_fWrinkleWeight.w );
#else
	ApplyMorph( morphSampler, cMorphTargetTextureDim, cMorphSubrect, v.vVertexID, v.vTexCoord2,
		vPosition.xyz, vNormal, vTangent.xyz, o.projPos_fWrinkleWeight.w );
#endif

	// Perform skinning
	float3 worldNormal, worldPos, worldTangentS, worldTangentT;
	SkinPositionNormalAndTangentSpace( g_bSkinning, vPosition, vNormal, vTangent,
		v.vBoneWeights, v.vBoneIndices, worldPos,
		worldNormal, worldTangentS, worldTangentT );

	// Always normalize since flex path is controlled by runtime
	// constant not a shader combo and will always generate the normalization
	worldNormal   = normalize( worldNormal );
	worldTangentS = normalize( worldTangentS );
	worldTangentT = normalize( worldTangentT );

#if defined( DX12_LEGACY_VS30 ) && MORPHING && DECAL
	// Avoid z precision errors
	worldPos += worldNormal * 0.05f * v.vTexCoord2.z;
#endif

	// Transform into projection space
	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.projPos = vProjPos;
	vProjPos.z = dot( float4( worldPos, 1  ), cViewProjZ );

	o.projPos_fWrinkleWeight.xyz = vProjPos.xyz;

#if !defined( _X360 )
	o.fog = CalcFog( worldPos, vProjPos.xyz, g_FogType );
#endif
	// Needed for water fog alpha and diffuse lighting 
	// FIXME: we shouldn't have to compute this all the time.
	o.worldPos_atten3.xyz = worldPos;

	// Needed for specular
	o.worldVertToEyeVector = VSHADER_VECT_SCALE * (cEyePos - worldPos);

	// Compute bumped lighting
	// FIXME: We shouldn't have to compute this for unlit materials
#if defined ( DX12_LEGACY_VS20 ) && ( !USE_STATIC_CONTROL_FLOW )
	o.lightAtten.xyz = float3(0,0,0);
	o.worldPos_atten3.w = 0.0f;
	#if ( NUM_LIGHTS > 0 )
		o.lightAtten.x = GetVertexAttenForLight( worldPos, 0, false );
	#endif
	#if ( NUM_LIGHTS > 1 )
		o.lightAtten.y = GetVertexAttenForLight( worldPos, 1, false );
	#endif
	#if ( NUM_LIGHTS > 2 )
		o.lightAtten.z = GetVertexAttenForLight( worldPos, 2, false );
	#endif
	#if ( NUM_LIGHTS > 3 )
		o.worldPos_atten3.w = GetVertexAttenForLight( worldPos, 3, false );
	#endif
#else
	o.lightAtten.x = GetVertexAttenForLight( worldPos, 0, true );
	o.lightAtten.y = GetVertexAttenForLight( worldPos, 1, true );
	o.lightAtten.z = GetVertexAttenForLight( worldPos, 2, true );
	o.worldPos_atten3.w = GetVertexAttenForLight( worldPos, 3, true );
#endif

	// Base texture coordinate transform
	o.baseTexCoord.x = dot( v.vTexCoord0, cBaseTexCoordTransform[0] );
	o.baseTexCoord.y = dot( v.vTexCoord0, cBaseTexCoordTransform[1] );
	o.baseTexCoord.z = dot( v.vTexCoord0, cDetailTexCoordTransform[0] );
	o.baseTexCoord.w = dot( v.vTexCoord0, cDetailTexCoordTransform[1] );

	// Tangent space transform
	o.tangentSpaceTranspose[0] = float3( worldTangentS.x, worldTangentT.x, worldNormal.x );
	o.tangentSpaceTranspose[1] = float3( worldTangentS.y, worldTangentT.y, worldNormal.y );
	o.tangentSpaceTranspose[2] = float3( worldTangentS.z, worldTangentT.z, worldNormal.z );

	o.worldPos = worldPos;
	o.worldNormal = normalize( worldNormal );
	o.shadowResponse = float2( 0, 1.0f );
	return DX12FinishVertex( o );
}
