#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/pyro_vision_vs20.fxc for logical pyro_vision_vs30 (legacy profile vs30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs30 set.
#define DX12_LEGACY_VS30 1
#include "dx12_preamble.h"
// STATIC: "EFFECT"						"0..3"
// STATIC: "VERTEXCOLOR"				"0..1"
// STATIC: "HALFLAMBERT"				"0..1"
// STATIC: "VERTEX_LIT"					"0..1"
// STATIC: "FULLBRIGHT"					"0..1"
// STATIC: "BASETEXTURE2"				"0..1"
// STATIC: "STRIPES"					"0..1"
// STATIC: "STRIPES_USE_NORMAL2"		"0..1"

// DYNAMIC: "COMPRESSED_VERTS"			"0..1"
// DYNAMIC: "SKINNING"					"0..1"
// DYNAMIC: "DYNAMIC_LIGHT"				"0..1"
// DYNAMIC: "STATIC_LIGHT"				"0..1"

// SKIP: ( STRIPES == 0 ) &&  ( STRIPES_USE_NORMAL2 == 1 )
// SKIP: ( EFFECT == 2 || EFFECT == 3 ) && ( VERTEXCOLOR == 1 || HALFLAMBERT == 1 || VERTEX_LIT == 1 || FULLBRIGHT == 1 || USE_STATIC_CONTROL_FLOW == 1 || BASETEXTURE2 == 1 || STRIPES == 1 || STRIPES_USE_NORMAL2 == 1 )
// SKIP: ( EFFECT == 2 || EFFECT == 3 ) && ( SKINNING == 1 || DYNAMIC_LIGHT == 1 || STATIC_LIGHT == 1 || NUM_LIGHTS != 0 )
// SKIP: ( FULLBRIGHT == 1 ) &&  ( VERTEX_LIT == 0 || DYNAMIC_LIGHT == 1 || STATIC_LIGHT == 1 || NUM_LIGHTS != 0 )


#include "common_vs_fxc.h"


static const bool g_bSkinning		= SKINNING ? true : false;
static const bool g_bHalfLambert	= HALFLAMBERT ? true : false;


cbuffer pyro_vision_vs20 : register( b2, space1 )
{
	float4 cBlendMaskTexCoordTransform[ 2 ]; // @legacy vs:c14
	float4 g_vPyroParms1; // @legacy vs:c48
	float4 g_vPyroParms2; // @legacy vs:c49
};

	#define g_vStripeScale			g_vPyroParms1.xyz
	#define g_flUnused1				g_vPyroParms1.w

#if EFFECT == 0 || EFFECT == 1


	#define g_vCanvasScale			g_vPyroParms2.xyz
	#define g_flUnused2				g_vPyroParms2.w

#endif


struct VS_INPUT
{
	float4 vPos;
	float4 vBoneWeights;
	float4 vBoneIndices;
#if ( VERTEX_LIT == 1 )
	float4 vNormal;
#endif
	float2 vBaseTexCoord;
	float2 vLightmapTexCoord;
	float2 vLightmapTexCoordOffset;
	float3 vTangentS;
	float3 vTangentT;
	float4 vColor;
	float3 vSpecular;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#if ( VERTEX_LIT == 1 )
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
#endif
	float2 vBaseTexCoord : TEXCOORD0;
	float2 vLightmapTexCoord : TEXCOORD1;
	float2 vLightmapTexCoordOffset : TEXCOORD2;
#if COMPRESSED_VERTS
	uint4 vTangentS : TANGENT;
#else
	float3 vTangentS : TANGENT;
#endif
	float3 vTangentT : BINORMAL;
	float4 vColor : COLOR0;
	float4 vSpecular : COLOR1;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
#if ( VERTEX_LIT == 1 )
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
#endif
	l.vBaseTexCoord = i.vBaseTexCoord;
	l.vLightmapTexCoord = i.vLightmapTexCoord;
	l.vLightmapTexCoordOffset = i.vLightmapTexCoordOffset;
#if COMPRESSED_VERTS
	l.vTangentS = ( (float4)i.vTangentS ).xyz;
#else
	l.vTangentS = i.vTangentS;
#endif
	l.vTangentT = i.vTangentT;
	l.vColor = i.vColor;
	l.vSpecular = ( i.vSpecular ).xyz;
	return l;
}


struct VS_OUTPUT
{
	float4 vProjPos : SV_Position; 	
#if EFFECT == 0 || EFFECT == 1
	float4 vBaseAndSeamlessTexCoord : TEXCOORD0;
#if ( STRIPES == 1 )
	float2 vStripeSeamlessTexCoord : TEXCOORD1;
#endif
#if ( VERTEX_LIT == 0 )
	float2 vLightmapBlendTexCoord : TEXCOORD2;
#endif
#if BASETEXTURE2 == 1
	float3 vBlendFactor : TEXCOORD3;
#endif
	float4 worldPos_projPosZ : TEXCOORD4;
	float3 vWorldNormal : TEXCOORD5;
	float4 vVertexColor : COLOR;
#else
	float2 vBaseTexCoord : TEXCOORD0;
#endif
	centroid float2 shadowBaseLightmapUV : TEXCOORD6;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD7;
	float3 highresPosition : TEXCOORD8;
	float3 highresNormal : TEXCOORD9;
	float3 highresTangentS : TEXCOORD10;
	float3 highresTangentT : TEXCOORD11;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.vProjPos );
	o.vProjPos = DX12Position( o.vProjPos );
#if EFFECT == 0 || EFFECT == 1
#if ( STRIPES == 1 )
#endif
#if ( VERTEX_LIT == 0 )
#endif
#if BASETEXTURE2 == 1
#endif
#else
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT	o = (VS_OUTPUT)0;

#if EFFECT == 0 || EFFECT == 1

	float4 vObjPosition = v.vPos;

#if ( VERTEX_LIT == 1 )
	float3 vObjNormal;
	DecompressVertex_Normal( v.vNormal, vObjNormal );
#else
	float3 vObjNormal = float3( 0.0, 0.0, 1.0 );
#endif

	float3 vWorldNormal, vWorldPos;
	SkinPositionAndNormal( g_bSkinning, vObjPosition, vObjNormal, v.vBoneWeights, v.vBoneIndices, vWorldPos, vWorldNormal );

	float4 vProjPos = mul( float4( vWorldPos, 1 ), cViewProj );
	o.vProjPos = vProjPos;
	vProjPos.z = dot( float4( vWorldPos, 1 ), cViewProjZ );
	
	o.worldPos_projPosZ = float4( vWorldPos, vProjPos.z );

#if 0
	if ( !g_bSkinning )
	{
		vWorldNormal = vObjNormal;
	}
#endif
	vWorldNormal = normalize( vWorldNormal );
	o.vWorldNormal = vWorldNormal;
	
	o.vBaseAndSeamlessTexCoord.xy = v.vBaseTexCoord;
	float flZFactor = vWorldPos.z * g_vCanvasScale.z;
	o.vBaseAndSeamlessTexCoord.zw = float2( vWorldPos.x + flZFactor, vWorldPos.y - flZFactor ) * g_vCanvasScale.xy;

#if ( STRIPES == 1 )

	float3 vWorldStripeCoord = vWorldPos * g_vStripeScale;
	o.vStripeSeamlessTexCoord.xy = vWorldStripeCoord.yz + vWorldStripeCoord.xz + vWorldStripeCoord.xy;

#endif


#if VERTEX_LIT == 0

	o.vLightmapBlendTexCoord.xy = v.vLightmapTexCoord;

#endif

#if BASETEXTURE2 == 1

	o.vBlendFactor.x = dot( v.vBaseTexCoord, cBlendMaskTexCoordTransform[ 0 ] ) + cBlendMaskTexCoordTransform[ 0 ].w;
	o.vBlendFactor.y = dot( v.vBaseTexCoord, cBlendMaskTexCoordTransform[ 1 ] ) + cBlendMaskTexCoordTransform[ 1 ].w;
	o.vBlendFactor.z = v.vColor.a;

#endif

#if VERTEXCOLOR == 1 

	o.vVertexColor = v.vColor;

#elif VERTEX_LIT == 1 && FULLBRIGHT == 0

	bool bDynamicLight = DYNAMIC_LIGHT ? true : false;
	bool bStaticLight = STATIC_LIGHT ? true : false;

	#if ( ( USE_STATIC_CONTROL_FLOW ) ||  defined ( DX12_LEGACY_VS30 ) )
	{
		o.vVertexColor.xyz = DoLighting( vWorldPos, vWorldNormal, v.vSpecular, bStaticLight, bDynamicLight, g_bHalfLambert );
	}
	#else
	{
		o.vVertexColor.xyz = DoLightingUnrolled( vWorldPos, vWorldNormal, v.vSpecular, bStaticLight, bDynamicLight, g_bHalfLambert, NUM_LIGHTS );
	}
	#endif

	o.vVertexColor.a = 1.0f;

#else

	o.vVertexColor = 1.0f;

#endif

#else

	o.vProjPos = v.vPos;
	o.vBaseTexCoord = v.vBaseTexCoord;

#endif

	o.shadowBaseLightmapUV = v.vLightmapTexCoord.xy;
o.shadowVertexLightmapUV = v.vLightmapTexCoord.xy;
o.highresPosition = mul( float4( v.vPos.xyz, 1 ), cModel[0] );
o.highresNormal = normalize( mul( cross( v.vTangentS, v.vTangentT ), (float3x3)cModel[0] ) );
o.highresTangentS = normalize( mul( v.vTangentS, (float3x3)cModel[0] ) );
o.highresTangentT = normalize( mul( v.vTangentT, (float3x3)cModel[0] ) );
return DX12FinishVertex( o );
}
