// Native SM5.1 rewrite of materialsystem/stdshaders/cloud_vs20.fxc for logical cloud_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
#include "common_vs_fxc.h"


cbuffer cloud_vs20 : register( b2, space1 )
{
	float4 g_matBaseTexCoordTransform[2]; // @legacy vs:c48
	float4 g_matCloudTexCoordTransform[2]; // @legacy vs:c50
};


struct VS_INPUT
{
	float4 vPos;
	float4 vTexCoord0;
	float4 vTexCoord1;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
	float4 vTexCoord0 : TEXCOORD0;
	float4 vTexCoord1 : TEXCOORD1;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
	l.vTexCoord0 = i.vTexCoord0;
	l.vTexCoord1 = i.vTexCoord1;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position;
	float2 baseCoords : TEXCOORD0;
	float2 cloudAlphaCoords : TEXCOORD1;
	float fogFactor : TEXCOORD2;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = (VS_OUTPUT)0;
	o.projPos = mul( v.vPos, cModelViewProj );

	// Compute fog based on the position
	float3 vWorldPos = mul( v.vPos, cModel[0] );
	o.fogFactor = CalcFog( vWorldPos, o.projPos, FOGTYPE_RANGE );

	// Texture coordinate transforms
	o.baseCoords.x = dot( v.vTexCoord0.xyzw, g_matBaseTexCoordTransform[0] );
	o.baseCoords.y = dot( v.vTexCoord0.xyzw, g_matBaseTexCoordTransform[1] );
	o.cloudAlphaCoords.x = dot( v.vTexCoord1.xyzw, g_matCloudTexCoordTransform[0] );
	o.cloudAlphaCoords.y = dot( v.vTexCoord1.xyzw, g_matCloudTexCoordTransform[1] );

	return DX12FinishVertex( o );
}
