#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/cable_ps2x.fxc for logical cable_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// DYNAMIC: "PIXELFOGTYPE"				"0..2"
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"	"0..1"

// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#if defined( DX12_LEGACY_PS20 )
#	define WRITE_DEPTH_TO_DESTALPHA 0
#endif

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"

Texture2D NormalSampler_Texture : register( t0 );
SamplerState NormalSampler_Sampler : register( s0 );
static const DX12Sampler2D NormalSampler = { NormalSampler_Texture, NormalSampler_Sampler };
Texture2D BaseTextureSampler_Texture : register( t1 );
SamplerState BaseTextureSampler_Sampler : register( s1 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };


cbuffer cable_ps2x : register( b1, space1 )
{
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


struct PS_INPUT
{
	float2 vTexCoord0;
	float2 vTexCoord1;
	
	float4 worldPos_projPosZ;		// Necessary for pixel fog

	float4 directionalLightColor;
	float4 fogFactorW;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float2 vTexCoord0 : TEXCOORD0;
	float2 vTexCoord1 : TEXCOORD1;
	float4 worldPos_projPosZ : TEXCOORD7;
	float4 directionalLightColor : COLOR0;
	float4 fogFactorW : COLOR1;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float3 worldPos : TEXCOORD2;
	float3 worldNormal : TEXCOORD3;
	float2 shadowResponse : TEXCOORD4;
	float3 shadowTangentS : TEXCOORD5;
	float3 shadowTangentT : TEXCOORD6;

	uint shadowPrimitiveId : SV_PrimitiveID;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vTexCoord0 = dx12In.vTexCoord0;
	l.vTexCoord1 = dx12In.vTexCoord1;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	l.directionalLightColor = dx12In.directionalLightColor;
	l.fogFactorW = dx12In.fogFactorW;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
	// GatherDirect adds styled prop RGB for Lambert/half-Lambert, then resident deltas.
	ShadowMap_SetBakedProp( smr, dx12In.shadowPrimitiveId );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	float3 vNormalMapDir = NormalSampler.tex.Sample( NormalSampler.smp, i.vTexCoord0 ); // Get the 3-vector from the normal map
	float4 textureColor = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.vTexCoord1 ); // Interpret tcoord t1 as color data.

	//Expand compacted vectors
	//TODO: find if there's a better way to expand a color normal to a full vector ( _bx2 was used in the assembly code )
	vNormalMapDir = (vNormalMapDir - 0.5) * 2.0;
	float3 vLightDir = float3( 0.0f, 0.0f, 1.0f );
	
	float lightDirDotNormalMap = dot( vNormalMapDir, vLightDir ); //normalMap dot dirLightDir

	// do half-lambert on the dot
	lightDirDotNormalMap = lightDirDotNormalMap * 0.5 + 0.5;
	lightDirDotNormalMap = lightDirDotNormalMap * lightDirDotNormalMap;

	float4 resultColor;
	smd = ShadowMap_GatherDirect( smr, ShadowMap_ShadeHalfLambert( normalize( mul( vNormalMapDir, float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ) ), true ) );
	resultColor.xyz = textureColor.rgb * ( lightDirDotNormalMap * i.directionalLightColor.rgb + smd.diffuse );
	resultColor.a = textureColor.a * i.directionalLightColor.a;

	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );

	
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( resultColor, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, (WRITE_DEPTH_TO_DESTALPHA != 0), i.worldPos_projPosZ.w ), dx12In.fog );
	return ShadowMap_Debug( smr, smd, dx12Lit0_0 );
	}
#else
	return DX12FinishPixel( FinalOutput( resultColor, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, (WRITE_DEPTH_TO_DESTALPHA != 0), i.worldPos_projPosZ.w ), dx12In.fog );
#endif

}
