// Native SM5.1 rewrite of materialsystem/stdshaders/shadowmodel_vs20.fxc for logical shadowmodel_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//	DYNAMIC: "DOWATERFOG"			"0..1"
//	DYNAMIC: "SKINNING"				"0..1"

#include "common_vs_fxc.h"

static const bool g_bSkinning		= SKINNING ? true : false;
static const int  g_FogType			= DOWATERFOG;


cbuffer shadowmodel_vs20 : register( b2, space1 )
{
	float4 cModulationColor; // @legacy vs:c47
	float4 cShadowTextureMatrix[3]; // @legacy vs:c48
	float4 cTexOrigin; // @legacy vs:c51
	float4 cTexScale; // @legacy vs:c52
	float3 cShadowConstants; // @legacy vs:c53
};


// { Shadow falloff offset, 1/Shadow distance, Shadow scale, 0 }

#define flShadowFalloffOffset	cShadowConstants.x
#define flOneOverShadowDist		cShadowConstants.y
#define flShadowScale			cShadowConstants.z


struct VS_INPUT
{
	float4 vPos;
	float3 vNormal;
	float4 vBoneWeights;
	float4 vBoneIndices;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float3 vNormal : NORMAL;
#endif
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vNormal = ( (float4)i.vNormal ).xyz;
#else
	l.vNormal = i.vNormal;
#endif
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 			// Projection-space position	
	float3 T0 : TEXCOORD0; 		// PS wants this to be 4D but VS doesn't? (see original asm sources)
	float3 T1 : TEXCOORD1;
	float3 T2 : TEXCOORD2;
	float T3 : TEXCOORD3;
	float4 vColor : COLOR0;
	float fog : FOG;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	o.vColor = saturate( o.vColor );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = (VS_OUTPUT)0;
	
	// Perform skinning
	float3 worldNormal, worldPos;
	SkinPositionAndNormal( g_bSkinning, v.vPos, v.vNormal, v.vBoneWeights, v.vBoneIndices, worldPos, worldNormal );

	// Transform into projection space
	o.projPos = mul( float4( worldPos, 1 ), cViewProj );

	// Compute fog
	o.fog = CalcFog( worldPos, o.projPos, g_FogType );

	// Transform position into texture space (from 0 to 1)
	float3 vTexturePos;
	vTexturePos.x = dot( worldPos.xyz, cShadowTextureMatrix[0].xyz );
	vTexturePos.y = dot( worldPos.xyz, cShadowTextureMatrix[1].xyz );
	vTexturePos.z = dot( worldPos.xyz, cShadowTextureMatrix[2].xyz );

	// Figure out the shadow fade amount
	float flShadowFade = ( vTexturePos.z - flShadowFalloffOffset ) * flOneOverShadowDist;

	// Offset it into the texture
	o.T0 = vTexturePos * cTexScale + cTexOrigin;

	// We're doing clipping by using texkill
	o.T1.xyz = vTexturePos.xyz;		// Also clips when shadow z < 0 !
	o.T2.xyz = float3( 1.0f, 1.0f, 1.0f ) - vTexturePos.xyz;
	o.T2.z = 1.0f - flShadowFade;	// Clips when shadow z > shadow distance	

	// We're doing backface culling by using texkill also (wow yucky)
	// --------------------------------------------------------------
	// Transform z component of normal in texture space
	// If it's negative, then don't draw the pixel
	o.T3 = dot( worldNormal, -cShadowTextureMatrix[2] );

	// Shadow color, falloff
	o.vColor.xyz = cModulationColor.xyz;
	o.vColor.w = flShadowFade * flShadowScale;

	return DX12FinishVertex( o );
}
