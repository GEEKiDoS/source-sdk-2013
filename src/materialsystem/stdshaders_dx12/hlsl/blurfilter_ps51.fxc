// Native SM5.1 rewrite of materialsystem/stdshaders/BlurFilter_ps2x.fxc for logical blurfilter_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"		"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// STATIC: "APPROX_SRGB_ADAPTER"	"0..1"

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D TexSampler_Texture : register( t0 );
SamplerState TexSampler_Sampler : register( s0 );
static const DX12Sampler2D TexSampler = { TexSampler_Texture, TexSampler_Sampler };

struct PS_INPUT
{
	float2 coordTap0;
	float2 coordTap1;
	float2 coordTap2;
	float2 coordTap3;
	float2 coordTap1Neg;
	float2 coordTap2Neg;
	float2 coordTap3Neg;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 coordTap0 : TEXCOORD0;
	float2 coordTap1 : TEXCOORD1;
	float2 coordTap2 : TEXCOORD2;
	float2 coordTap3 : TEXCOORD3;
	float2 coordTap1Neg : TEXCOORD4;
	float2 coordTap2Neg : TEXCOORD5;
	float2 coordTap3Neg : TEXCOORD6;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.coordTap0 = dx12In.coordTap0;
	l.coordTap1 = dx12In.coordTap1;
	l.coordTap2 = dx12In.coordTap2;
	l.coordTap3 = dx12In.coordTap3;
	l.coordTap1Neg = dx12In.coordTap1Neg;
	l.coordTap2Neg = dx12In.coordTap2Neg;
	l.coordTap3Neg = dx12In.coordTap3Neg;
	return l;
}


cbuffer BlurFilter_ps2x : register( b1, space1 )
{
	float2 psTapOffs[3]; // @legacy ps:c0
	float3 scale_factor; // @legacy ps:c3
};


float4 SampleTexture( DX12Sampler2D texSampler, float2 uv )
{
	float4 cSample = texSampler.tex.Sample( texSampler.smp, uv );

	#if ( APPROX_SRGB_ADAPTER )
	{
		cSample.rgb = max( cSample.rgb, float3(  0.00001f, 0.00001f, 0.00001f ) ); // rsqrt doesn't like inputs of zero

		float3 ooSQRT;                  //
		ooSQRT.r = rsqrt( cSample.r );  //
		ooSQRT.g = rsqrt( cSample.g );  // Approximate linear-to-sRGB conversion
		ooSQRT.b = rsqrt( cSample.b );  //
		cSample.rgb *= ooSQRT.rgb;      //
	}
	#endif

	return cSample;
}

float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 s0, s1, s2, s3, s4, s5, s6, color;

	// Sample taps with coordinates from VS
	s0 = SampleTexture( TexSampler, i.coordTap0 );
	s1 = SampleTexture( TexSampler, i.coordTap1 );
	s2 = SampleTexture( TexSampler, i.coordTap2 );
	s3 = SampleTexture( TexSampler, i.coordTap3 );
	s4 = SampleTexture( TexSampler, i.coordTap1Neg );
	s5 = SampleTexture( TexSampler, i.coordTap2Neg );
	s6 = SampleTexture( TexSampler, i.coordTap3Neg );

	color = s0 * 0.2013f;
	color += ( s1 + s4 ) * 0.2185f;
	color += ( s2 + s5 ) * 0.0821f;
	color += ( s3 + s6 ) * 0.0461f;

	// Compute tex coords for other taps
	float2 coordTap4 = i.coordTap0 + psTapOffs[0];
	float2 coordTap5 = i.coordTap0 + psTapOffs[1];
	float2 coordTap6 = i.coordTap0 + psTapOffs[2];
	float2 coordTap4Neg = i.coordTap0 - psTapOffs[0];
	float2 coordTap5Neg = i.coordTap0 - psTapOffs[1];
	float2 coordTap6Neg = i.coordTap0 - psTapOffs[2];

	// Sample the taps
	s1 = SampleTexture( TexSampler, coordTap4 );
	s2 = SampleTexture( TexSampler, coordTap5 );
	s3 = SampleTexture( TexSampler, coordTap6 );
	s4 = SampleTexture( TexSampler, coordTap4Neg );
	s5 = SampleTexture( TexSampler, coordTap5Neg );
	s6 = SampleTexture( TexSampler, coordTap6Neg );

	color += ( s1 + s4 ) * 0.0262f;
	color += ( s2 + s5 ) * 0.0162f;
	color += ( s3 + s6 ) * 0.0102f;
	color.xyz*=scale_factor.xyz;

	#if ( APPROX_SRGB_ADAPTER )
	{
		color.xyz *= color.xyz; // Approximate sRGB-to-linear conversion
	}
	#endif

	return DX12FinishPixel( color, 0.0f );
	//return FinalOutput( color, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE );
}

