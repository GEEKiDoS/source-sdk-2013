// Native SM5.1 rewrite of materialsystem/stdshaders/eyeglint_vs20.fxc for logical eyeglint_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//===== Copyright © 1996-2007, Valve Corporation, All rights reserved. ======//
//
// Vertex shader to pass through texcoords needed to run the
// procedural glint generation inner loop in the pixel shader
//
// $Header: $
// $NoKeywords: $
//===========================================================================//

#include "common_vs_fxc.h"

struct VS_INPUT
{
	float3 vPos;
	float2 tc;	// Interpolated coordinate of current texel in 3x3 quad
	float2 glintCenter;	// Uniform value containing center of glint in local 3x3 quad
	float3 glintColor;	// Uniform value of color of glint
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float3 vPos : POSITION;
	float2 tc : TEXCOORD0;
	float2 glintCenter : TEXCOORD1;
	float3 glintColor : TEXCOORD2;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
	l.tc = i.tc;
	l.glintCenter = i.glintCenter;
	l.glintColor = i.glintColor;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
	float2 tc : TEXCOORD0; 	// Interpolated coordinate of current texel in 3x3 quad
	float2 glintCenter : TEXCOORD1; 	// Uniform value containing center of glint in local 3x3 quad
	float3 glintColor : TEXCOORD2; 	// Uniform value of color of glint
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;
	o.projPos = float4( v.vPos, 1.0f );
	o.tc = v.tc;
	o.glintCenter = v.glintCenter;
	o.glintColor = v.glintColor;
	return DX12FinishVertex( o );
}


