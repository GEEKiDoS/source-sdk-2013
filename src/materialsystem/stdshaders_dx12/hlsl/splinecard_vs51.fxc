// Native SM5.1 rewrite of materialsystem/stdshaders/splinecard_vsxx.fxc for logical splinecard_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
#include "common_vs_fxc.h"


cbuffer splinecard_vsxx : register( b2, space1 )
{
	float4x3 cModelView; // @legacy vs:c48
	float4x4 cProj; // @legacy vs:c51
};


// derivative of catmull rom spline courtesy of calc
float4 DCatmullRomSpline ( float4 a, float4 b, float4 c, float4 d, float t )
{
	return 0.5 *( c - a + t * ( 2 * a - 5 * b + 4 * c - d + t * (3 * b - a - 3 * c + d ) ) 
				 + t * ( 2 * a - 5 * b + 4 * c - d + 2 * ( t * ( 3 * b - a - 3 * c + d ) ) ) );
}

float3 DCatmullRomSpline3 ( float3 a, float3 b, float3 c, float3 d, float t )
{
	return 0.5 *( c - a + t * ( 2 * a - 5 * b + 4 * c - d + t * (3 * b - a - 3 * c + d ) ) 
				 + t * ( 2 * a - 5 * b + 4 * c - d + 2 * ( t * ( 3 * b - a - 3 * c + d ) ) ) );
}

    
float4 CatmullRomSpline( float4 a, float4 b, float4 c, float4 d, float t )
{
	return b + 0.5 * t * ( c - a + t * ( 2 * a - 5 * b + 4 * c - d + t * ( -a + 3 * b -3 * c + d ) ) );
}

struct VS_INPUT
{
	// This is all of the stuff that we ever use.
	float4 vTint;
	float4 vParms;						// T V side_id
	float4 vSplinePt0;					// x y z rad
	float4 vSplinePt1;					// x y z rad
	float4 vSplinePt2;					// x y z rad
	float4 vSplinePt3;					// x y z rad
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vTint : COLOR;
	float4 vParms : POSITION;
	float4 vSplinePt0 : TEXCOORD0;
	float4 vSplinePt1 : TEXCOORD1;
	float4 vSplinePt2 : TEXCOORD2;
	float4 vSplinePt3 : TEXCOORD3;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vTint = i.vTint;
	l.vParms = i.vParms;
	l.vSplinePt0 = i.vSplinePt0;
	l.vSplinePt1 = i.vSplinePt1;
	l.vSplinePt2 = i.vSplinePt2;
	l.vSplinePt3 = i.vSplinePt3;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
	float2 texCoord0 : TEXCOORD0;
	float2 texCoord1 : TEXCOORD1;
	float4 argbcolor : COLOR;
	float4 blendfactor0 : TEXCOORD2;
	float2 texCoord2 : TEXCOORD3;
#if !defined( SHADER_MODEL_VS_1_1 ) 
	float4 blendfactor1 : TEXCOORD4; 	// for extracting green/alpha
#endif
	float2 vSeq2TexCoord0 : TEXCOORD5;
	float2 vSeq2TexCoord1 : TEXCOORD6;
#if defined( _X360 )
	float4 vScreenPos_ReverseZ : TEXCOORD7;
#else
	float4 vScreenPos : TEXCOORD7;
#endif
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	o.argbcolor = saturate( o.argbcolor );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
#if !defined( SHADER_MODEL_VS_1_1 ) 
#endif
#if defined( _X360 )
#else
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = (VS_OUTPUT)0;
	o.blendfactor1 = float4( 0, 0, 0, 1 );

	float4 posrad =
		CatmullRomSpline( v.vSplinePt0, v.vSplinePt1, v.vSplinePt2, v.vSplinePt3, v.vParms.x );
	float3 v2p = ( posrad.xyz - cEyePos );
	float3 tangent=DCatmullRomSpline3( v.vSplinePt0, v.vSplinePt1, v.vSplinePt2, v.vSplinePt3, v.vParms.x );
	float3 ofs = normalize( cross(v2p, normalize( tangent) ) );
	posrad.xyz += ofs * ( posrad.w * ( v.vParms.z - .5 ) );
	o.projPos  = mul( float4(posrad.xyz, 1.0f), cViewProj );
	o.texCoord0 = o.texCoord1 = float2( (1-v.vParms.z), v.vParms.y);
	o.argbcolor = v.vTint;
	o.blendfactor0 = float4(0,0,0,0);
	o.vScreenPos = float4(0,0,0,0);
	return DX12FinishVertex( o );

}
