// Native SM5.1 rewrite of materialsystem/stdshaders/TreeLeaf_vs20.fxc for logical treeleaf_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//  STATIC: "HALFLAMBERT"				"0..1"
//  STATIC: "USE_STATIC_CONTROL_FLOW"	"0..1"

//	DYNAMIC: "DYNAMIC_LIGHT"			"0..1"
//	DYNAMIC: "STATIC_LIGHT"				"0..1"
//  DYNAMIC: "NUM_LIGHTS"				"0..2"

// If using static control flow on Direct3D, we should use the NUM_LIGHTS=0 combo
//  SKIP: $USE_STATIC_CONTROL_FLOW && ( $NUM_LIGHTS > 0 )

#include "common_vs_fxc.h"

static const bool g_bHalfLambert	= HALFLAMBERT ? true : false;


cbuffer TreeLeaf_vs20 : register( b2, space1 )
{
	float3 cLeafCenter; // @legacy vs:c48
};


struct VS_INPUT
{
	// This is all of the stuff that we ever use.
	float4 vPos;
	float4 vNormal;
	float2 vTexCoord;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
	float2 vTexCoord : TEXCOORD0;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
	l.vTexCoord = i.vTexCoord;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
	float2 texCoord : TEXCOORD0;
	float3 color : COLOR;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	o.color = saturate( o.color );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	bool bDynamicLight = DYNAMIC_LIGHT ? true : false;
	bool bStaticLight = STATIC_LIGHT ? true : false;

	float3 worldPos;
	worldPos = mul( v.vPos, cModel[0] );

	float3 normal = v.vPos.xyz - cLeafCenter.xyz;
	normal = normalize( normal );

	float3 worldNormal = mul( float4( normal, 0.0f ), cModel[0] );

#if ( USE_STATIC_CONTROL_FLOW ) || defined ( DX12_LEGACY_VS30 )
	float3 lighting = DoLighting( worldPos, worldNormal, float3(0,0,0), bStaticLight, bDynamicLight, g_bHalfLambert );
#else
	float3 lighting = DoLightingUnrolled( worldPos, worldNormal, float3(0,0,0), bStaticLight, bDynamicLight, g_bHalfLambert, NUM_LIGHTS );
#endif

	float3 xAxis = float3( cViewModel[0].x, cViewModel[1].x, cViewModel[2].x );
	float3 yAxis = float3( cViewModel[0].y, cViewModel[1].y, cViewModel[2].y );

	worldPos += xAxis * v.vTexCoord.x;
	worldPos += yAxis * (1.0f-v.vTexCoord.y);

	float4 projPos  = mul( float4(worldPos, 1.0f), cViewProj );

	float3 light_vec = float3( 1.0f, 0.0, 1.0 );
	light_vec = normalize( light_vec );

	o.projPos       = projPos;
	// FIXME: if this shader gets put back into use, be sure this usage of normals jives with compressed verts
	o.texCoord      = v.vNormal.xy;
	o.color         = lighting;

	return DX12FinishVertex( o );
}


