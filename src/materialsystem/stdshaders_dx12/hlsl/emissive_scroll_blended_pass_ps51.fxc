// Native SM5.1 rewrite of materialsystem/stdshaders/emissive_scroll_blended_pass_ps2x.fxc for logical emissive_scroll_blended_pass_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
//========= Copyright © 1996-2006, Valve Corporation, All rights reserved. ============//

// Includes =======================================================================================
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
#include "common_vertexlitgeneric_dx9.h"

// Texture Samplers ===============================================================================
Texture2D g_tBaseSampler_Texture : register( t0 );
SamplerState g_tBaseSampler_Sampler : register( s0 );
static const DX12Sampler2D g_tBaseSampler = { g_tBaseSampler_Texture, g_tBaseSampler_Sampler };
Texture2D g_tFlowSampler_Texture : register( t1 );
SamplerState g_tFlowSampler_Sampler : register( s1 );
static const DX12Sampler2D g_tFlowSampler = { g_tFlowSampler_Texture, g_tFlowSampler_Sampler };
Texture2D g_tSelfIllumSampler_Texture : register( t2 );
SamplerState g_tSelfIllumSampler_Sampler : register( s2 );
static const DX12Sampler2D g_tSelfIllumSampler = { g_tSelfIllumSampler_Texture, g_tSelfIllumSampler_Sampler };

// Shaders Constants and Globals ==================================================================

cbuffer emissive_scroll_blended_pass_ps2x : register( b1, space1 )
{
	float4 g_vPackedConst0; // @legacy ps:c0
	float2 g_vEmissiveScrollVector; // @legacy ps:c1
	float3 g_cSelfIllumTint; // @legacy ps:c2
};

#define g_flBlendStrength   g_vPackedConst0.x
#define g_flTime			g_vPackedConst0.y


// Interpolated values ============================================================================
struct PS_INPUT
{
	float2 vTexCoord0;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vProjPosition : SV_Position;
	float2 vTexCoord0 : TEXCOORD0;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vTexCoord0 = dx12In.vTexCoord0;
	return l;
}


// Main ===========================================================================================
//float4 main( PS_INPUT i ) : COLOR // Non-HDR for debugging
float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	// Color texture
	float4 cBaseColor = g_tBaseSampler.tex.Sample( g_tBaseSampler.smp, i.vTexCoord0.xy );

	// Fetch from dudv map and then fetch from emissive texture with new uv's & scroll
	float4 vFlowValue = g_tFlowSampler.tex.Sample( g_tFlowSampler.smp, i.vTexCoord0.xy );
	float2 vEmissiveTexCoord = vFlowValue.xy + ( g_vEmissiveScrollVector.xy * g_flTime );
	float4 cEmissiveColor = g_tSelfIllumSampler.tex.Sample( g_tSelfIllumSampler.smp, vEmissiveTexCoord.xy );

	//===============//
	// Combine terms //
	//===============//
	float4 result;
	result.rgb = cBaseColor.rgb * cEmissiveColor.rgb * g_cSelfIllumTint.rgb;
	result.rgb *= g_flBlendStrength;

	// Set alpha to 0.0f so it doesn't change dest alpha (I should probably disable dest alpha writes)
	result.a = 0.0f;

	return DX12FinishPixel( FinalOutput( result, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_LINEAR ), 0.0f );
}
