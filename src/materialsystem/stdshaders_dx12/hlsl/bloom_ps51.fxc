// Native SM5.1 rewrite of materialsystem/stdshaders/Bloom_ps2x.fxc for logical bloom_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D FBSampler_Texture : register( t0 );
SamplerState FBSampler_Sampler : register( s0 );
static const DX12Sampler2D FBSampler = { FBSampler_Texture, FBSampler_Sampler };
Texture2D BlurSampler_Texture : register( t1 );
SamplerState BlurSampler_Sampler : register( s1 );
static const DX12Sampler2D BlurSampler = { BlurSampler_Texture, BlurSampler_Sampler };

struct PS_INPUT
{
	float2 texCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord : TEXCOORD0;
	float2 ZeroTexCoord : TEXCOORD1;
	float2 bloomTexCoord : TEXCOORD2;
	float4 vColor : TEXCOORD3;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.texCoord = dx12In.baseTexCoord;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 fbSample = FBSampler.tex.Sample( FBSampler.smp, i.texCoord );
	float4 blurSample = BlurSampler.tex.Sample( BlurSampler.smp, i.texCoord );

	return DX12FinishPixel( FinalOutput( float4( fbSample + blurSample.rgb * blurSample.a * MAX_HDR_OVERBRIGHT, 1.0f ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}