"   float4 p;                           "
"   c.x = tex0.tex.Sample( tex0.smp, In.T0 ).x;       "
"   c.y = tex1.tex.Sample( tex1.smp, In.T0 ).x;       "
"   c.z = tex2.tex.Sample( tex2.smp, In.T0 ).x;       "
"   c.w = consts.x;                     "
"   p.w = tex3.tex.Sample( tex3.smp, In.T0 ).x;       "
"   p.x = dot( tor, c );                "
"   p.y = dot( tog, c );                "
"   p.z = dot( tob, c );                "
"   p.w *= consts.w;                    "
