// Native SM5.1 rewrite of materialsystem/stdshaders/shadowmodel_ps20.fxc for logical shadowmodel_ps20 (legacy profile ps20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20 set.
#define DX12_LEGACY_PS20 1
#include "dx12_preamble.h"

struct PS_INPUT
{
	float4 T0;
	float3 T1;
	float3 T2;
	float  T3;
	float3 vColor;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float3 T0 : TEXCOORD0;
	float3 T1 : TEXCOORD1;
	float3 T2 : TEXCOORD2;
	float T3 : TEXCOORD3;
	float4 vColor : COLOR0;
	float fog : FOG;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.T0.xyz = dx12In.T0;
	l.T1 = dx12In.T1;
	l.T2 = dx12In.T2;
	l.T3 = dx12In.T3;
	l.vColor = ( dx12In.vColor ).xyz;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	// Kill pixel against various fields computed in vertex shader
	clip ( i.T1 );
	clip ( i.T2 );
	clip ( i.T3 ); // Backface cull

	// i.T0.a is uninitialized by the vs, but this is how the original asm shader was written????
	return DX12FinishPixel( float4( lerp( float3(1,1,1), i.vColor.xyz, i.T0.a ), 1 ), dx12In.fog );
}