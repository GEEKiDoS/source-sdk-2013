// Native SM5.1 rewrite of materialsystem/stdshaders/teeth_vs20.fxc for logical teeth_vs30 (legacy profile vs30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs30 set.
#define DX12_LEGACY_VS30 1
#include "dx12_preamble.h"
//======= Copyright � 1996-2006, Valve Corporation, All rights reserved. ======

//	STATIC: "INTRO"						"0..1"

//	DYNAMIC: "COMPRESSED_VERTS"			"0..1"
//	DYNAMIC: "DOWATERFOG"				"0..1"
//	DYNAMIC: "SKINNING"					"0..1"
//	DYNAMIC: "DYNAMIC_LIGHT"			"0..1"
//	DYNAMIC: "STATIC_LIGHT"				"0..1"
//  DYNAMIC: "MORPHING"					"0..1"

// If using static control flow on Direct3D, we should use the NUM_LIGHTS=0 combo

#include "vortwarp_vs20_helper.h"

static const int g_FogType			= DOWATERFOG;
static const bool g_bSkinning		= SKINNING ? true : false;


cbuffer teeth_vs20 : register( b2, space1 )
{
	float4 cTeethLighting; // @legacy vs:c48
	float4 const4; // @legacy vs:c49
	float3 cMorphTargetTextureDim; // @legacy vs:c54
	float4 cMorphSubrect; // @legacy vs:c55
};

#if INTRO

#define g_Time const4.w
#define modelOrigin const4.xyz
#endif

#ifdef DX12_LEGACY_VS30
// NOTE: cMorphTargetTextureDim.xy = target dimensions,
//		 cMorphTargetTextureDim.z = 4tuples/morph


Texture2D morphSampler_Texture : register( t0 );
SamplerState morphSampler_Sampler : register( s0 );
static const DX12Sampler2D morphSampler = { morphSampler_Texture, morphSampler_Sampler };
#endif

struct VS_INPUT
{
	// This is all of the stuff that we ever use.
	float4 vPos;
	float4 vBoneWeights;
	float4 vBoneIndices;
	float4 vNormal;
	float2 vTexCoord0;

	// Position and normal/tangent deltas
	float3 vPosFlex;
	float3 vNormalFlex;
#ifdef DX12_LEGACY_VS30
	float vVertexID;
#endif
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
	float2 vTexCoord0 : TEXCOORD0;
	float3 vPosFlex : POSITION1;
	float3 vNormalFlex : NORMAL1;
#ifdef DX12_LEGACY_VS30
	float vVertexID : POSITION2;
#endif
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
	l.vTexCoord0 = i.vTexCoord0;
	l.vPosFlex = i.vPosFlex;
	l.vNormalFlex = i.vNormalFlex;
#ifdef DX12_LEGACY_VS30
	l.vVertexID = i.vVertexID;
#endif
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float2 baseTexCoord : TEXCOORD0;
	float3 vertAtten : TEXCOORD1;
	float4 worldPos_projPosZ : TEXCOORD7; 		// Necessary for pixel fog
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
#if !defined( _X360 )    
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	bool bDynamicLight = DYNAMIC_LIGHT ? true : false;
	bool bStaticLight = STATIC_LIGHT ? true : false;

	float4 vPosition = v.vPos;
	float3 vNormal;
	DecompressVertex_Normal( v.vNormal, vNormal );

#if !defined( DX12_LEGACY_VS30 ) || !MORPHING
	ApplyMorph( v.vPosFlex, v.vNormalFlex, vPosition.xyz, vNormal );
#else
	ApplyMorph( morphSampler, cMorphTargetTextureDim, cMorphSubrect, v.vVertexID, float3( 0, 0, 0 ), vPosition.xyz, vNormal );
#endif

	// Normalize the flexed normal
	vNormal.xyz = normalize( vNormal.xyz );

	// Transform the position
	float3 worldPos, worldNormal;
	SkinPositionAndNormal( g_bSkinning, vPosition, vNormal, v.vBoneWeights, v.vBoneIndices, worldPos, worldNormal );

#if INTRO
	float3 dummy = float3( 0.0f, 0.0f, 0.0f );
	WorldSpaceVertexProcess( g_Time, modelOrigin, worldPos, worldNormal, dummy, dummy );
#endif

	// Transform into projection space
	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.projPos = vProjPos;
	vProjPos.z = dot( float4( worldPos, 1 ), cViewProjZ );

	o.worldPos_projPosZ = float4( worldPos.xyz, vProjPos.z );
#if !defined( _X360 )
	// Set fixed-function fog factor
	o.fog = CalcFog( worldPos, vProjPos, g_FogType );
#endif

	// Compute lighting
#if ( USE_STATIC_CONTROL_FLOW ) || defined ( DX12_LEGACY_VS30 )
	float3 linearColor = DoLighting( worldPos, worldNormal, float3(0.0f, 0.0f, 0.0f), bStaticLight, bDynamicLight, false );
#else
	float3 linearColor = DoLightingUnrolled( worldPos, worldNormal, float3(0.0f, 0.0f, 0.0f), bStaticLight, bDynamicLight, false, NUM_LIGHTS );
#endif

	// Forward vector
	float3 vForward = cTeethLighting.xyz;
	float fIllumFactor = cTeethLighting.w;

	// Darken by forward dot normal and illumination factor
	linearColor *= fIllumFactor * saturate( dot( worldNormal, vForward ) );	

	o.vertAtten = linearColor;
	o.baseTexCoord = v.vTexCoord0;

	return DX12FinishVertex( o );
}


