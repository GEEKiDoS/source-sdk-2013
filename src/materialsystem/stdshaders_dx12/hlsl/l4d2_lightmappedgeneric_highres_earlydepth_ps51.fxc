struct PS_INPUT
{
#if SEAMLESS
	float4 base;
#else
	float3 base;
#endif
	float4 detailBumpMask;
	float4 lightmap12;
	float4 lightmap3;
	float4 world;
	float3 tangentX;
	float3 tangentY;
	float3 tangentZ;
	float4 color;
	float blend;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float fog : FOG;
#if SEAMLESS
	float4 base : TEXCOORD0;
#else
	float3 base : TEXCOORD0;
#endif
	float4 detailBumpMask : TEXCOORD1;
	float4 lightmap12 : TEXCOORD2;
	float4 lightmap3 : TEXCOORD3;
	float4 world : TEXCOORD4;
	float3 tangentX : TEXCOORD5;
	float3 tangentY : TEXCOORD6;
	float3 tangentZ : TEXCOORD7;
	float4 color : COLOR0;
	float blend : COLOR1;
	float3 worldPos : TEXCOORD8;
	float3 worldNormal : TEXCOORD9;
	float2 shadowResponse : TEXCOORD10;
	float3 shadowTangentS : TEXCOORD11;
	float3 shadowTangentT : TEXCOORD12;
	centroid float2 shadowBaseLightmapUV : TEXCOORD13;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD14;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
#if SEAMLESS
#if ( ( SEAMLESS ) )
	l.base = dx12In.base;
#endif
#if ( !( SEAMLESS ) )
	l.base.xyz = dx12In.base;
#endif
#else
#if ( ( SEAMLESS ) )
	l.base = ( dx12In.base ).xyz;
#endif
#if ( !( SEAMLESS ) )
	l.base = dx12In.base;
#endif
#endif
	l.detailBumpMask = dx12In.detailBumpMask;
	l.lightmap12 = dx12In.lightmap12;
	l.lightmap3 = dx12In.lightmap3;
	l.world = dx12In.world;
	l.tangentX = dx12In.tangentX;
	l.tangentY = dx12In.tangentY;
	l.tangentZ = dx12In.tangentZ;
	l.color = dx12In.color;
	l.blend = dx12In.blend;
	return l;
}


[earlydepthstencil]
float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	HlightReceiver hlr = HighresLightmap_Begin( dx12In.shadowBaseLightmapUV, dx12In.shadowVertexLightmapUV );
 ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
 ShadowMap_SetBakedSun( smr, hlr.sun, hlr.sunDilated );
 ShadowMap_SetBakedFace( smr, hlr.faceId, hlr.q, hlr.localVisibilityEligible, hlr.bakedDirectEligible, hlr.unbakedLocalRange );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	float4 base = L4D2WorldTexture( BaseSampler, i.base.xyz, i.color.rgb );
	float blendedAlpha = base.a;
	float blend = MASKEDBLENDING ? 0.5 : i.blend;
if ( BASETEXTURE2 )
{
	if ( FANCY_BLENDING && !SELFILLUM )
{
			float4 modulation = BlendSampler.tex.Sample( BlendSampler.smp, i.lightmap3.wz );
		if ( MASKEDBLENDING )
{
				blend = modulation.g;
		}
else
{
				blend = smoothstep( saturate( modulation.g - modulation.r ), saturate( modulation.g + modulation.r ), blend );
		}
	}
		float4 base2 = L4D2WorldTexture( Base2Sampler, i.base.xyz, i.color.rgb );
		base.rgb = lerp( base.rgb, base2.rgb, blend );
		blendedAlpha = lerp( base.a, base2.a, blend );
}
	float4 detail = 1;
if ( DETAIL_BLEND_MODE != 12 )
{
		detail = DetailSampler.tex.Sample( DetailSampler.smp, i.detailBumpMask.xy ) * float4( g_DetailTintAndBlend.rgb, 1 );
}
	float4 normal = float4( 0, 0, 1, 1 );
	float3 specularMask = 1;
if ( BUMPMAP || NORMALMAPALPHAENVMAPMASK )
{
#if SEAMLESS
		normal = L4D2WorldTexture( BumpSampler, i.base.xyz, i.color.rgb );
#else
		float2 bumpUV = DETAIL_BLEND_MODE == 12 ? i.detailBumpMask.xy :
			!SELFILLUM && !FANCY_BLENDING ? i.lightmap3.wz : i.base.xy;
		normal = BumpSampler.tex.Sample( BumpSampler.smp, bumpUV );
#endif
	if ( BUMPMAP == 1 )
{
			normal.xyz = normal.xyz * 2 - 1;
	}
else if ( BUMPMAP == 0 )
{
			normal.xyz = float3( 0, 0, 1 );
	}
	if ( BASETEXTURENOENVMAP )
{
			normal.a = 0;
	}
	if ( BUMPMAP2 )
{
		float4 normal2;
		if ( BUMPMASK )
{
				normal2 = Bump2OrEnvMaskSampler.tex.Sample( Bump2OrEnvMaskSampler.smp, i.detailBumpMask.wz );
		}
else
{
#if SEAMLESS
				normal2 = L4D2WorldTexture( Bump2OrEnvMaskSampler, i.base.xyz, i.color.rgb );
#else
				normal2 = Bump2OrEnvMaskSampler.tex.Sample( Bump2OrEnvMaskSampler.smp, bumpUV );
#endif
		}
		if ( BUMPMAP == 1 )
{
				normal2.xyz = normal2.xyz * 2 - 1;
		}
		if ( BASETEXTURE2NOENVMAP )
{
				normal2.a = 0;
		}
		if ( BUMPMASK )
{
				float4 mask = BumpMaskSampler.tex.Sample( BumpMaskSampler.smp, i.base.xy );
				normal.xyz = lerp( mask.xyz * 2 - 1, normalize( normal.xyz + normal2.xyz ), mask.a );
				specularMask = mask.a;
		}
else if ( FANCY_BLENDING && NORMALMAPALPHAENVMAPMASK )
{
				normal = lerp( normal, normal2, blend );
		}
else
{
				normal.xyz = lerp( normal.xyz, normal2.xyz, blend );
		}
	}
	if ( NORMALMAPALPHAENVMAPMASK )
{
			specularMask *= normal.a;
	}
}
if ( ENVMAPMASK && !BUMPMAP2 )
{
		specularMask *= Bump2OrEnvMaskSampler.tex.Sample( Bump2OrEnvMaskSampler.smp, i.detailBumpMask.wz ).rgb;
}
if ( BASEALPHAENVMAPMASK )
{
		specularMask *= 1 - blendedAlpha;
}
	float alpha = i.color.a;
if ( !BASEALPHAENVMAPMASK && !SELFILLUM )
{
		alpha *= base.a;
}
	float4 albedo = TextureCombine( base, detail, DETAIL_BLEND_MODE, g_DetailTintAndBlend.a );
#if !SEAMLESS
	albedo.rgb *= i.color.rgb;
#endif
	float3 lightmap = 1;
if ( LIGHTING_PREVIEW == 0 )
{
		lightmap = HighresLightmap_Plane( hlr, (BUMPMAP && DIFFUSEBUMPMAP ? 1 : 0), LightmapSampler.tex.Sample( LightmapSampler.smp, i.lightmap12.xy ) ).rgb;
	if ( BUMPMAP && DIFFUSEBUMPMAP )
{
			float3 lightmap2 = HighresLightmap_Plane( hlr, 2, LightmapSampler.tex.Sample( LightmapSampler.smp, i.lightmap12.wz ) ).rgb;
			float3 lightmap3 = HighresLightmap_Plane( hlr, 3, LightmapSampler.tex.Sample( LightmapSampler.smp, i.lightmap3.xy ) ).rgb;
		float3 weights;
		if ( BUMPMAP == 2 )
{
				weights = normal.xyz;
		}
else
{
				weights = saturate( float3( dot( normal.xyz, g_L4D2BumpBasis[0] ), dot( normal.xyz, g_L4D2BumpBasis[1] ), dot( normal.xyz, g_L4D2BumpBasis[2] ) ) );
				weights *= weights;
		}
		if ( DETAIL_BLEND_MODE == 10 )
{
				weights *= 2 * detail.rgb;
		}
			sms = ShadowMap_ShadeBumped(mul(g_L4D2BumpBasis[0], float3x3(dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal)), mul(g_L4D2BumpBasis[1], float3x3(dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal)), mul(g_L4D2BumpBasis[2], float3x3(dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal)), BUMPMAP == 2 ? weights * g_SsBumpMathFix : weights / dot(weights, float3(1,1,1)));
 lightmap = weights.x * lightmap + weights.y * lightmap2 + weights.z * lightmap3;
		if ( BUMPMAP == 2 )
{
				lightmap *= g_SsBumpMathFix;
		}
else
{
				lightmap /= dot( weights, float3( 1, 1, 1 ) );
		}
	}
	smd = ShadowMap_GatherDirect( smr, sms );
 if (cHlightRoute.x != 0 && hlr.nativeOnly == 0)
     lightmap = (lightmap + (smd.diffuse * hlr.valid)) / g_TintTimesLightmapScale.a;
 if ( BLENDTINTBYBASEALPHA )
{
			lightmap *= lerp( g_TintTimesLightmapScale.a, g_TintTimesLightmapScale.rgb, base.a );
	}
else
{
			lightmap *= g_TintTimesLightmapScale.rgb;
	}
#if !SEAMLESS
	if ( WARPLIGHTING )
{
			lightmap *= 2 * WarpSampler.tex.Sample( WarpSampler.smp, float2( 0.5 * length( lightmap ), 0 ) ).rgb;
	}
#endif
}
if ( BUMPMAP == 2 )
{
		normal.xyz = normal.x * g_L4D2BumpBasis[0] + normal.y * g_L4D2BumpBasis[1] + normal.z * g_L4D2BumpBasis[2];
}
	float3 worldNormal = float3( dot( normal.xyz, i.tangentX ), dot( normal.xyz, i.tangentY ), dot( normal.xyz, i.tangentZ ) );
if ( LIGHTING_PREVIEW == 1 )
{
		
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( float4( albedo.rgb * (0.7 + 0.25 * dot( worldNormal, float3( 0.436435789, 0.872871578, -0.218217894 ) )), alpha ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_0 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( float4( albedo.rgb * (0.7 + 0.25 * dot( worldNormal, float3( 0.436435789, 0.872871578, -0.218217894 ) )), alpha ), dx12In.fog ) );
#endif

}
else if ( LIGHTING_PREVIEW == 3 )
{
		
#if 1
	{
	float4 dx12Lit0_1 = DX12FinishPixel( float4( worldNormal, i.world.w ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_1 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( float4( worldNormal, i.world.w ), dx12In.fog ) );
#endif

}
else
{
		float3 color = albedo.rgb * lightmap;
	if ( SELFILLUM )
{
		if ( FASTPATH )
{
				color = lerp( color, albedo.rgb, base.a );
		}
else
{
				color = lerp( color, albedo.rgb * g_SelfIllumTint, base.a );
		}
	}
		color = TextureCombinePostLighting( color, detail, DETAIL_BLEND_MODE, g_DetailTintAndBlend.a );
	if ( CUBEMAP )
{
			float3 eye = g_EyePos - i.world.xyz;
			float3 reflection = 2 * worldNormal * dot( worldNormal, eye ) - eye * dot( worldNormal, worldNormal );
			float3 environment = Envmap_SampleLegacy( EnvmapSampler.tex, EnvmapSampler.smp, reflection ).rgb * ENV_MAP_SCALE;
			environment *= specularMask;
			environment *= g_EnvmapTint;
		if ( !FANCY_BLENDING )
{
			if ( FASTPATH )
{
				if ( FASTPATHENVMAPCONTRAST )
{
						environment *= environment;
				}
			}
else
{
					environment = lerp( environment, environment * environment, g_EnvmapContrast );
					environment = lerp( dot( environment, float3( 0.299, 0.587, 0.114 ) ), environment, g_EnvmapSaturation );
			}
		}
		if ( !FASTPATH )
{
				float fresnel = 1 - dot( worldNormal, normalize( eye ) );
				float fresnel2 = fresnel * fresnel;
				fresnel = fresnel * fresnel2 * fresnel2;
				environment *= fresnel * g_Fresnel.b + g_Fresnel.a;
		}
			color += environment;
	}
#if SEAMLESS
		float fog = i.base.w;
#else
		float fog = i.base.z;
#endif
	if ( PIXELFOG )
{
			fog = L4D2WorldFog( g_EyePos, i.world.xyz, g_FogParams );
	}
	if ( WRITEWATERFOGTODESTALPHA )
{
			alpha = saturate( (g_FogParams.y - i.world.z - 2) * g_WaterFogReciprocalRange );
	}
else if ( WRITE_DEPTH_TO_DESTALPHA )
{
			alpha = DepthToDestAlpha( i.world.w );
	}
		
#if 1
	{
	float4 dx12Lit0_2 = DX12FinishPixel( float4( L4D2WorldOutput( color, fog ), alpha ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_2 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( float4( L4D2WorldOutput( color, fog ), alpha ), dx12In.fog ) );
#endif

}
}
