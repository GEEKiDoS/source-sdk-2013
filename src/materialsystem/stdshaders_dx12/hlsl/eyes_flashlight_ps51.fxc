// Native SM5.1 rewrite of materialsystem/stdshaders/eyes_flashlight_ps2x.fxc for logical eyes_flashlight_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
//====== Copyright � 1996-2004, Valve Corporation, All rights reserved. =======
//
// Purpose: 
//
//=============================================================================

// STATIC: "FLASHLIGHTDEPTHFILTERMODE"	"0..2"

// DYNAMIC: "PIXELFOGTYPE"				"0..2"
// DYNAMIC: "FLASHLIGHTSHADOWS"			"0..1"

// ---- inlined eyes_flashlight_inc.fxc ----
//====== Copyright � 1996-2006, Valve Corporation, All rights reserved. =======
//
// Purpose: 
//
//=============================================================================

#include "common_flashlight_fxc.h"
#include "shader_constant_register_map.h"


cbuffer eyes_flashlight_ps2x : register( b1, space1 )
{
	float4 g_vShadowTweaks; // @legacy ps:c2
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
	float4 cFlashlightColor; // @legacy ps:c28
	float4 cFlashlightScreenScale; // @legacy ps:c31
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


Texture2D SpotSampler_Texture : register( t0 );
SamplerState SpotSampler_Sampler : register( s0 );
static const DX12Sampler2D SpotSampler = { SpotSampler_Texture, SpotSampler_Sampler };
Texture2D BaseTextureSampler_Texture : register( t1 );
SamplerState BaseTextureSampler_Sampler : register( s1 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D IrisSampler_Texture : register( t3 );
SamplerState IrisSampler_Sampler : register( s3 );
static const DX12Sampler2D IrisSampler = { IrisSampler_Texture, IrisSampler_Sampler };

#if FLASHLIGHTSHADOWS && (!SHADER_MODEL_PS_1_1) && (!SHADER_MODEL_PS_1_4) && (!DX12_LEGACY_PS20)
Texture2D FlashlightDepthSampler_Texture : register( t4 );
SamplerComparisonState FlashlightDepthSampler_Sampler : register( s4 );
static const DX12ShadowSampler FlashlightDepthSampler = { FlashlightDepthSampler_Texture, FlashlightDepthSampler_Sampler };
Texture2D RandomRotationSampler_Texture : register( t5 );
SamplerState RandomRotationSampler_Sampler : register( s5 );
static const DX12Sampler2D RandomRotationSampler = { RandomRotationSampler_Texture, RandomRotationSampler_Sampler };
#endif

#if defined( SHADER_MODEL_PS_1_1 ) || defined ( SHADER_MODEL_PS_1_4 )

#else


#endif

struct PS_INPUT
{
	float4 spotTexCoord;
	float2 baseTexCoord;
	float2 irisTexCoord;
#if defined( SHADER_MODEL_PS_1_1 ) || defined ( SHADER_MODEL_PS_1_4 )
	float3 vertAtten;
#else
	float3 vertAtten;
	float3 worldPos;
	float3 projPos;
#endif
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
#if !defined( _X360 )
	float fog : FOG;
#endif
	float4 spotTexCoord : TEXCOORD0;
	float2 baseTexCoord : TEXCOORD1;
	float2 irisTexCoord : TEXCOORD3;
	float3 vertAtten : TEXCOORD4;
	float3 worldPos : TEXCOORD5;
	float3 projPosXYZ : TEXCOORD7;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.spotTexCoord = dx12In.spotTexCoord;
	l.baseTexCoord = dx12In.baseTexCoord;
	l.irisTexCoord = dx12In.irisTexCoord;
#if defined( SHADER_MODEL_PS_1_1 ) || defined ( SHADER_MODEL_PS_1_4 )
	// vertAtten : COLOR0 is not written by the paired vertex shader (reads 0)
#else
	l.vertAtten = dx12In.vertAtten;
	l.worldPos = dx12In.worldPos;
	l.projPos = dx12In.projPosXYZ;
#endif
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if defined(DX12_LEGACY_PS20)
	float3 spotColor = SpotSampler.tex.Sample( SpotSampler.smp, ( i.spotTexCoord.xyzw ).xy / ( i.spotTexCoord.xyzw ).w ) * cFlashlightColor;
#elif ( defined(DX12_LEGACY_PS20B) || defined(DX12_LEGACY_PS30) )
	float3 vProjCoords = i.spotTexCoord.xyz / i.spotTexCoord.w;
	float3 spotColor = SpotSampler.tex.Sample( SpotSampler.smp, vProjCoords ) * cFlashlightColor;
#else
	float3 spotColor = SpotSampler.tex.Sample( SpotSampler.smp, i.spotTexCoord );
#endif

	float4 baseSample = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.baseTexCoord );
	float4 irisSample = IrisSampler.tex.Sample( IrisSampler.smp, i.irisTexCoord );

	float3 outcolor = float3(1,1,1);

#if !defined( SHADER_MODEL_PS_1_1 ) && !defined( SHADER_MODEL_PS_1_4 )
	if( i.spotTexCoord.w <= 0.0f )
	{
		outcolor = float3(0,0,0);
	}
#endif

	// Composite the iris and sclera together
#if defined( SHADER_MODEL_PS_1_1 ) || defined ( SHADER_MODEL_PS_1_4 )
	float3 albedo = lerp( baseSample.xyz, irisSample.xyz, irisSample.a );
#else
	float3 albedo = lerp( baseSample.xyz, irisSample.xyz * 0.5f, irisSample.a );	// dim down the iris in HDR
#endif

	// Do shadow depth mapping...
#if FLASHLIGHTSHADOWS && ( defined(DX12_LEGACY_PS20B) || defined(DX12_LEGACY_PS30) )
	float flShadow = DoFlashlightShadow( FlashlightDepthSampler, RandomRotationSampler, vProjCoords, i.projPos.xy / i.projPos.z, FLASHLIGHTDEPTHFILTERMODE, g_vShadowTweaks, true, cFlashlightScreenScale );
	float flAttenuated = lerp( flShadow, 1.0f, g_vShadowTweaks.y );								// Blend between fully attenuated and not attenuated
	flShadow = lerp( flAttenuated, flShadow, dot(i.vertAtten, float3(0.30f, 0.59f, 0.11f) ) );	// Blend between shadow and above, according to light attenuation
	outcolor *= flShadow * spotColor * albedo;
#else
	outcolor *= spotColor * albedo;
#endif

	// NOTE!!  This has to be last to avoid loss of range.
	outcolor *= i.vertAtten;
#if defined( SHADER_MODEL_PS_1_1 ) || defined ( SHADER_MODEL_PS_1_4 )
	return DX12FinishPixel( float4( outcolor, baseSample.a ), dx12In.fog );
#else
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos.xyz, i.projPos.z );
	return DX12FinishPixel( FinalOutput( float4( outcolor, 1.0f ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), dx12In.fog );
#endif

}

// ---- end eyes_flashlight_inc.fxc ----

