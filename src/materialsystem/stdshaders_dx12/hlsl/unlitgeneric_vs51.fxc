// Native SM5.1 rewrite of materialsystem/stdshaders/unlitgeneric_vs20.fxc for logical unlitgeneric_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
// STATIC: "VERTEXCOLOR"			"0..1"
// DYNAMIC: "COMPRESSED_VERTS"		"0..1"
// DYNAMIC: "DOWATERFOG"			"0..1"
// DYNAMIC: "SKINNING"				"0..1"

#include "common_vs_fxc.h"

static const int g_FogType			= DOWATERFOG;
static const bool g_bSkinning		= SKINNING ? true : false;


cbuffer unlitgeneric_vs20 : register( b2, space1 )
{
	float4 cModulationColor; // @legacy vs:c47
	float4 cBaseTextureTransform[2]; // @legacy vs:c48
	float4 cMaskTextureTransform[2]; // @legacy vs:c50
	float4 cDetailTextureTransform[2]; // @legacy vs:c52
	float4 g_vVertexColor; // @legacy vs:c54
};


struct VS_INPUT
{
	float4 vPos;
	float4 vBoneWeights;
	float4 vBoneIndices;
	float4 vNormal;

#if VERTEXCOLOR
	float4 vColor;
#endif	

	float4 vTexCoord0;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
#if VERTEXCOLOR
	float4 vColor : COLOR0;
#endif	
	float4 vTexCoord0 : TEXCOORD0;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
#if VERTEXCOLOR
	l.vColor = i.vColor;
#endif	
	l.vTexCoord0 = i.vTexCoord0;
	return l;
}


struct VS_OUTPUT
{
	float4 vProjPos : SV_Position;
	float2 vTexCoord0 : TEXCOORD0;
	float2 vTexCoord1 : TEXCOORD1;
	float2 vTexCoord2 : TEXCOORD2;
	float2 vTexCoord3 : TEXCOORD3;
	float4 vColor : COLOR0;
	float4 fogFactorW : COLOR1;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float4 worldPos_projPosZ : TEXCOORD7; 		// Necessary for pixel fog
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.vProjPos );
	o.vProjPos = DX12Position( o.vProjPos );
	o.vColor = saturate( o.vColor );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	o.fogFactorW = saturate( o.fogFactorW );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
#if !defined( _X360 )    
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float3 worldPos;
	float3 worldNormal;

	//------------------------------------------------------------------------------
	// Vertex blending
	//------------------------------------------------------------------------------
	SkinPosition( g_bSkinning, v.vPos, v.vBoneWeights, v.vBoneIndices, worldPos );

	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.vProjPos = vProjPos;
	vProjPos = dot( float4( worldPos, 1 ), cViewProjZ );
	o.worldPos_projPosZ = float4( worldPos.xyz, vProjPos.z );

	//------------------------------------------------------------------------------
	// Fog
	//------------------------------------------------------------------------------
	o.fogFactorW = CalcFog( worldPos, vProjPos, g_FogType );
#if !defined( _X360 )
	o.fog = o.fogFactorW;
#endif

	//------------------------------------------------------------------------------
	// Texture coord transforms
	//------------------------------------------------------------------------------
	o.vTexCoord0 = mul( v.vTexCoord0, (float2x4)cBaseTextureTransform );
	o.vTexCoord3 = mul( v.vTexCoord0, (float2x4)cDetailTextureTransform );

	o.vColor = cModulationColor;
	
#if VERTEXCOLOR	
	// 0 or 1 for g_vVertexColor.x, eliminating a bool
	o.vColor = lerp( o.vColor, o.vColor * v.vColor, g_vVertexColor.x );
#endif	

	return DX12FinishVertex( o );
}


