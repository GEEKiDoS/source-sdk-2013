// Native SM5.1 rewrite of materialsystem/stdshaders/morphaccumulate_ps30.fxc for logical morphaccumulate_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
//======= Copyright © 1996-2006, Valve Corporation, All rights reserved. ======

//  STATIC: "CONSTANTBASEDMORPH"	"0..1"

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

struct PS_INPUT
{
	float2 vSrcCoord;
	float2 vSideSpeedCoord;
#if CONSTANTBASEDMORPH
	float4 vMorphWeights;
#else
	float2 vMorphWeightCoord;
#endif
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vDestCoord : SV_Position;
	float2 vSrcCoord : TEXCOORD0;
	float2 vSideSpeedCoord : TEXCOORD1;
#if CONSTANTBASEDMORPH
	float4 vMorphWeights : TEXCOORD2;
#else
	float2 vMorphWeightCoord : TEXCOORD2;
#endif
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vSrcCoord = dx12In.vSrcCoord;
	l.vSideSpeedCoord = dx12In.vSideSpeedCoord;
#if CONSTANTBASEDMORPH
#if ( ( CONSTANTBASEDMORPH ) )
	l.vMorphWeights = dx12In.vMorphWeights;
#endif
#if ( !( CONSTANTBASEDMORPH ) )
	l.vMorphWeights.xy = dx12In.vMorphWeightCoord;
#endif
#else
#if ( ( CONSTANTBASEDMORPH ) )
	l.vMorphWeightCoord = ( dx12In.vMorphWeights ).xy;
#endif
#if ( !( CONSTANTBASEDMORPH ) )
	l.vMorphWeightCoord = dx12In.vMorphWeightCoord;
#endif
#endif
	return l;
}


Texture2D MorphTarget_Texture : register( t0 );
SamplerState MorphTarget_Sampler : register( s0 );
static const DX12Sampler2D MorphTarget = { MorphTarget_Texture, MorphTarget_Sampler };
Texture2D SideSpeedMap_Texture : register( t1 );
SamplerState SideSpeedMap_Sampler : register( s1 );
static const DX12Sampler2D SideSpeedMap = { SideSpeedMap_Texture, SideSpeedMap_Sampler };
#if !CONSTANTBASEDMORPH
Texture2D MorphWeights_Texture : register( t2 );
SamplerState MorphWeights_Sampler : register( s2 );
static const DX12Sampler2D MorphWeights = { MorphWeights_Texture, MorphWeights_Sampler };
#endif


cbuffer morphaccumulate_ps30 : register( b1, space1 )
{
	float4 vMorphScale; // @legacy ps:c0
};


HALF4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if CONSTANTBASEDMORPH
	float4 vMorphWeights = i.vMorphWeights;
#else
	float4 vMorphWeights = MorphWeights.tex.Sample( MorphWeights.smp, i.vMorphWeightCoord );
#endif
	
	float4 delta = MorphTarget.tex.Sample( MorphTarget.smp, i.vSrcCoord );
	float4 sideSpeed = SideSpeedMap.tex.Sample( SideSpeedMap.smp, i.vSideSpeedCoord );
	
	// NOTE: This is necessary to fixup slight errors in the delta.
	// On the cpu, only the range 0-65534 is used so we can encode -1, 0, and 1 exactly.
	delta *= 65535.0f / 65534.0f;

	// Compute total weight, taking into account side + speed
	float flWeight = lerp( vMorphWeights.y, vMorphWeights.x, sideSpeed.y );
	float flStereoWeight = lerp( vMorphWeights.w, vMorphWeights.z, sideSpeed.y ); 
	float w = lerp( flWeight, flStereoWeight, sideSpeed.x );
	
	// Convert 0-1 -> -1 to 1
	delta *= 2.0f;
	delta -= float4( 1.0f, 1.0f, 1.0f, 1.0f );
	
	// Apply the morph scale
	delta *= vMorphScale;
	
	// Apply weight	
	delta *= w;
	
	return DX12FinishPixel( delta, 0.0f );
}

