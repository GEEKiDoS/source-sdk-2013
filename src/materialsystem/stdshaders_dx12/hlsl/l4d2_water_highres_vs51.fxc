#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/l4d2_water_vs20.fxc for logical l4d2_water_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//========= Copyright Valve Corporation, All rights reserved. ============//
// Native Water VS20, with a shared entry point for the cheap cubemap pass.
// STATIC: "CHEAP" "0..1"
// STATIC: "BASETEXTURE" "0..1"
// STATIC: "MULTITEXTURE" "0..1"
// STATIC: "FLASHLIGHT" "0..1"
// STATIC: "LIGHTMAPWATERFOG" "0..1"
// SKIP: $CHEAP && ($BASETEXTURE || $FLASHLIGHT || $LIGHTMAPWATERFOG)
// SKIP: $BASETEXTURE && ($MULTITEXTURE || $FLASHLIGHT || $LIGHTMAPWATERFOG)
// SKIP: $MULTITEXTURE && ($FLASHLIGHT || $LIGHTMAPWATERFOG)

#include "common_vs_fxc.h"


cbuffer DX12GameRegistersVS : register( b4, space1 )
{
	float4 gameRegisters[64]; // @legacy none
};
static const float4 cBumpTransform[2] = { gameRegisters[49], gameRegisters[50] };
#define cScrollOffsets gameRegisters[51]
#define cFlashlightWorldToTexture transpose(float4x4(gameRegisters[52], gameRegisters[53], gameRegisters[54], gameRegisters[55]))


struct VS_INPUT
{
	float4 position;
	float3 normal;
	float4 texcoord;
	float2 lightmap;
	float2 lightmapOffset;
	float3 tangentS;
	float3 tangentT;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 position : POSITION;
#if COMPRESSED_VERTS
	uint4 normal : NORMAL;
#else
	float3 normal : NORMAL;
#endif
	float4 texcoord : TEXCOORD0;
	float2 lightmap : TEXCOORD1;
	float2 lightmapOffset : TEXCOORD2;
#if COMPRESSED_VERTS
	uint4 tangentS : TANGENT;
#else
	float3 tangentS : TANGENT;
#endif
	float3 tangentT : BINORMAL0;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.position = i.position;
#if COMPRESSED_VERTS
	l.normal = ( (float4)i.normal ).xyz;
#else
	l.normal = i.normal;
#endif
	l.texcoord = i.texcoord;
	l.lightmap = i.lightmap;
	l.lightmapOffset = i.lightmapOffset;
#if COMPRESSED_VERTS
	l.tangentS = ( (float4)i.tangentS ).xyz;
#else
	l.tangentS = i.tangentS;
#endif
	l.tangentT = i.tangentT;
	return l;
}


struct VS_OUTPUT
{
	float4 position : SV_Position;
	float fog : FOG;
	float2 bump : TEXCOORD0;
	float3 eye : TEXCOORD1;
#if CHEAP
	float3 tangentS : TEXCOORD2;
	float3 tangentT : TEXCOORD3;
	float3 normal : TEXCOORD4;
	float4 extraBump : TEXCOORD5;
	float3 world : TEXCOORD7;
#else
	float4 reflectRefract : TEXCOORD2;
	float4 projected : TEXCOORD3;
	float3 world : TEXCOORD4;
#if FLASHLIGHT
	float4 flashlight : TEXCOORD5;
#elif MULTITEXTURE
	float4 extraBump : TEXCOORD5;
#elif BASETEXTURE
	float4 lightmap12 : TEXCOORD5;
	float2 lightmap3 : TEXCOORD6;
#endif
#if LIGHTMAPWATERFOG
	float2 lightmap : TEXCOORD7;
#endif
#endif
	centroid float2 shadowBaseLightmapUV : TEXCOORD8;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD9;
	float3 highresPosition : TEXCOORD10;
	float3 highresNormal : TEXCOORD11;
	float3 highresTangentS : TEXCOORD12;
	float3 highresTangentT : TEXCOORD13;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.position );
	o.position = DX12Position( o.position );
#if CHEAP
#else
#if FLASHLIGHT
#elif MULTITEXTURE
#elif BASETEXTURE
#endif
#if LIGHTMAPWATERFOG
#endif
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = (VS_OUTPUT)0;
	o.position = mul( v.position, cModelViewProj );
	o.world = mul( v.position, cModel[0] );
	o.eye = cEyePos - o.world;
	// Native water fog is radial in the horizontal plane, not view-space Z.
	float distanceXY = length( o.eye.xy );
	o.fog = max( cFogParams.x - distanceXY * cFogParams.w, cFogParams.z );
#if CHEAP
	o.bump = v.texcoord.xy;
	o.tangentS = mul( v.tangentS, (float3x3)cModel[0] );
	o.tangentT = mul( v.tangentT, (float3x3)cModel[0] );
	o.normal = mul( v.normal, (float3x3)cModel[0] );
#else
	o.bump.x = dot( v.texcoord, cBumpTransform[0] );
	o.bump.y = dot( v.texcoord, cBumpTransform[1] );
	o.projected = o.position;
	o.reflectRefract = float4( o.position.x, o.position.y, -o.position.y, o.position.x );
	o.reflectRefract = (o.reflectRefract + o.position.w) * 0.5f;
#if FLASHLIGHT
	o.flashlight = mul( float4( o.world, 1.0f ), cFlashlightWorldToTexture );
#elif BASETEXTURE
	o.lightmap12.xy = v.lightmap + v.lightmapOffset;
	o.lightmap12.wz = o.lightmap12.xy + v.lightmapOffset;
	o.lightmap3 = o.lightmap12.wz + v.lightmapOffset;
#endif
#if LIGHTMAPWATERFOG
	o.lightmap = v.lightmap;
#endif
#endif
#if MULTITEXTURE
	o.extraBump.xy = float2( v.texcoord.x + v.texcoord.y, v.texcoord.y - v.texcoord.x ) * 0.1f + cScrollOffsets.xy;
	o.extraBump.zw = v.texcoord.yx * 0.45f + cScrollOffsets.zw;
#endif
	o.shadowBaseLightmapUV = v.lightmap.xy;
o.shadowVertexLightmapUV = v.lightmap.xy;
float3 hlightObjectNormal = v.normal;
o.highresPosition = mul( float4( v.position.xyz, 1 ), cModel[0] );
o.highresNormal = normalize( mul( hlightObjectNormal, (float3x3)cModel[0] ) );
o.highresTangentS = normalize( mul( v.tangentS, (float3x3)cModel[0] ) );
o.highresTangentT = normalize( mul( v.tangentT, (float3x3)cModel[0] ) );
return DX12FinishVertex( o );
}
