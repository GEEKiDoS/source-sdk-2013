// Native SM5.1 rewrite of materialsystem/stdshaders/HDRCombineTo16Bit_ps2x.fxc for logical hdrcombineto16bit_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D LowSampler_Texture : register( t0 );
SamplerState LowSampler_Sampler : register( s0 );
static const DX12Sampler2D LowSampler = { LowSampler_Texture, LowSampler_Sampler };
Texture2D HiSampler_Texture : register( t1 );
SamplerState HiSampler_Sampler : register( s1 );
static const DX12Sampler2D HiSampler = { HiSampler_Texture, HiSampler_Sampler };

struct PS_INPUT
{
	float2 texCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 texCoord : TEXCOORD0;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.texCoord = dx12In.texCoord;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 lowColor = LowSampler.tex.Sample( LowSampler.smp, i.texCoord );
	float3 hiColor = HiSampler.tex.Sample( HiSampler.smp, i.texCoord );

	lowColor.rgb = GammaToLinear( lowColor.rgb );
	hiColor.rgb = GammaToLinear( hiColor.rgb );

	float4 result = float4( ( 1.0f / MAX_HDR_OVERBRIGHT ) * max( lowColor.xyz, hiColor.xyz * MAX_HDR_OVERBRIGHT ), lowColor.a );
	return DX12FinishPixel( FinalOutput( result, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}
