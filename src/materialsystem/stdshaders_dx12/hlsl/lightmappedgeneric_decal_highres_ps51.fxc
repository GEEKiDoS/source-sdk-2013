// HIGHLIGHT_SAMPLERS: 14
#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/lightmappedgeneric_decal_ps2x.fxc for logical lightmappedgeneric_decal_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// DYNAMIC: "PIXELFOGTYPE"		"0..2"

// STATIC: "CONVERT_TO_SRGB"	"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D LightMap0Sampler_Texture : register( t1 );
SamplerState LightMap0Sampler_Sampler : register( s1 );
static const DX12Sampler2D LightMap0Sampler = { LightMap0Sampler_Texture, LightMap0Sampler_Sampler };
Texture2D LightMap1Sampler_Texture : register( t2 );
SamplerState LightMap1Sampler_Sampler : register( s2 );
static const DX12Sampler2D LightMap1Sampler = { LightMap1Sampler_Texture, LightMap1Sampler_Sampler };
Texture2D LightMap2Sampler_Texture : register( t3 );
SamplerState LightMap2Sampler_Sampler : register( s3 );
static const DX12Sampler2D LightMap2Sampler = { LightMap2Sampler_Texture, LightMap2Sampler_Sampler };


cbuffer lightmappedgeneric_decal_ps2x : register( b1, space1 )
{
	float4 g_LightMap0Color; // @legacy ps:c0
	float4 g_LightMap1Color; // @legacy ps:c1
	float4 g_LightMap2Color; // @legacy ps:c2
	float4 g_ModulationColor; // @legacy ps:c3
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


struct PS_INPUT
{
	float4 vProjPos;
	float2 vTexCoord0;
	float2 vTexCoord1;
	float2 vTexCoord2;
	float2 vTexCoord3;
	float4 worldPos_projPosZ;		// Necessary for pixel fog

	float4 vColor;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
	float2 vTexCoord0 : TEXCOORD0;
	float2 vTexCoord1 : TEXCOORD1;
	float2 vTexCoord2 : TEXCOORD2;
	float2 vTexCoord3 : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD4;
	float4 vColor : COLOR0;
	float4 fogFactorW : COLOR1;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float3 worldPos : TEXCOORD5;
	float3 worldNormal : TEXCOORD6;
	float2 shadowResponse : TEXCOORD7;
	float3 shadowTangentS : TEXCOORD8;
	float3 shadowTangentT : TEXCOORD9;
	centroid float2 shadowBaseLightmapUV : TEXCOORD10;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD11;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	// vProjPos : POSITION (ps2.x cannot read POSITION)
	l.vTexCoord0 = dx12In.vTexCoord0;
	l.vTexCoord1 = dx12In.vTexCoord1;
	l.vTexCoord2 = dx12In.vTexCoord2;
	l.vTexCoord3 = dx12In.vTexCoord3;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	l.vColor = dx12In.vColor;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	HlightReceiver hlr = HighresLightmap_Begin( dx12In.shadowBaseLightmapUV, dx12In.shadowVertexLightmapUV );
 ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
 smr.bakedSunVisibility = hlr.sun;
 ShadowMap_SetBakedFace( smr, hlr.faceId, hlr.q, hlr.localVisibilityEligible, hlr.bakedDirectEligible, hlr.unbakedLocalRange );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	float4 resultColor;
	
	// output = lightmapColor[0] * ( ( N dot basis[0] )^2 ) + 
	//	       lightmapColor[1] * ( ( N dot basis[1] )^2 ) +
	//	       lightmapColor[2] * ( ( N dot basis[2] )^2 ) +
	resultColor = HighresLightmap_Plane( hlr, 1, LightMap0Sampler.tex.Sample( LightMap0Sampler.smp, i.vTexCoord1 ) ) * g_LightMap0Color;
	resultColor = (HighresLightmap_Plane( hlr, 2, LightMap1Sampler.tex.Sample( LightMap1Sampler.smp, i.vTexCoord2 ) ) * g_LightMap1Color) + resultColor;
	resultColor = (HighresLightmap_Plane( hlr, 3, LightMap2Sampler.tex.Sample( LightMap2Sampler.smp, i.vTexCoord3 ) ) * g_LightMap2Color) + resultColor;
	// Selected direct: decoded linear units, before albedo/output.
#if 1
	smd = ShadowMap_GatherDirect( smr, ShadowMap_ShadeBumped( mul( bumpBasis[0], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[1], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[2], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), float3( g_LightMap0Color.x, g_LightMap1Color.x, g_LightMap2Color.x ) ) );
	resultColor.rgb += (smd.diffuse * hlr.valid);
#endif
	
	// Modulate by decal texture
	float4 decalColor = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.vTexCoord0 );
	resultColor.rgb = resultColor * decalColor;
	resultColor.a = decalColor.a;
	
	// Modulate by constant color
	resultColor = resultColor * g_ModulationColor;
	
	// Modulate by per-vertex factor
	resultColor = resultColor * i.vColor;
	
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );
	
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( resultColor, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_0 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( FinalOutput( resultColor, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), dx12In.fog ) );
#endif
	
}
