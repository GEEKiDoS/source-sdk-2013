// Native SM5.1 rewrite of materialsystem/stdshaders/lightmappedgeneric_decal_vs20.fxc for logical lightmappedgeneric_decal_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
// DYNAMIC: "DOWATERFOG"	"0..1"

#include "common_vs_fxc.h"

static const int g_FogType	= DOWATERFOG;


cbuffer lightmappedgeneric_decal_vs20 : register( b2, space1 )
{
	float4 cShaderConst0; // @legacy vs:c48
	float4 cShaderConst1; // @legacy vs:c49
};


struct VS_INPUT
{
	float4 vPos;
	float4 vTexCoord0;
	float4 vTexCoord1;
	float2 vTexCoord2;

	float4 vColor;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
	float4 vTexCoord0 : TEXCOORD0;
	float4 vTexCoord1 : TEXCOORD1;
	float2 vTexCoord2 : TEXCOORD2;
	float4 vColor : COLOR0;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
	l.vTexCoord0 = i.vTexCoord0;
	l.vTexCoord1 = i.vTexCoord1;
	l.vTexCoord2 = i.vTexCoord2;
	l.vColor = i.vColor;
	return l;
}


struct VS_OUTPUT
{
	float4 vProjPos : SV_Position;
	float2 vTexCoord0 : TEXCOORD0;
	float2 vTexCoord1 : TEXCOORD1;
	float2 vTexCoord2 : TEXCOORD2;
	float2 vTexCoord3 : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD4; 		// Necessary for pixel fog
	float4 vColor : COLOR0;
	float4 fogFactorW : COLOR1;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.vProjPos );
	o.vProjPos = DX12Position( o.vProjPos );
	o.vColor = saturate( o.vColor );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	o.fogFactorW = saturate( o.fogFactorW );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
#if !defined( _X360 )    
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float3 worldPos;
	worldPos = mul( v.vPos, cModel[0] );
	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.vProjPos = vProjPos;
	vProjPos.z = dot( float4( worldPos, 1 ), cViewProjZ );

	o.worldPos_projPosZ = float4( worldPos.xyz, vProjPos.z );

	o.fogFactorW = CalcFog( worldPos, vProjPos, g_FogType );
#if !defined( _X360 )
	o.fog = o.fogFactorW;
#endif


	// Compute the texture coordinates given the offset between
	// each bumped lightmap
	float2 offset;
	offset.x = v.vTexCoord2.x;
	offset.y = 0.0f;
	
	o.vTexCoord0.x = dot( v.vTexCoord0, cShaderConst0 );
	o.vTexCoord0.y = dot( v.vTexCoord0, cShaderConst1 );
	
	o.vTexCoord1 = offset + v.vTexCoord1.xy;
	o.vTexCoord2 = (offset * 2.0) + v.vTexCoord1.xy;	
	o.vTexCoord3 = (offset * 3.0) + v.vTexCoord1.xy;
	
	o.vColor = v.vColor;

	return DX12FinishVertex( o );
}