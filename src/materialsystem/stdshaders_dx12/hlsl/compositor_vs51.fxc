// Native SM5.1 rewrite of materialsystem/stdshaders/compositor_vs20.fxc for logical compositor_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//======= Copyright © 1996-2007, Valve Corporation, All rights reserved. ======

#include "common_vs_fxc.h"

// This could be packed more efficiently if needed.

cbuffer compositor_vs20 : register( b2, space1 )
{
	float4x2 cXformTexCoord0; // @legacy vs:c2
	float4x2 cXformTexCoord1; // @legacy vs:c4
	float4x2 cXformTexCoord2; // @legacy vs:c6
	float4x2 cXformTexCoord3; // @legacy vs:c8
};


struct VS_INPUT
{
	float3 vPos;
	float2 vBaseTexCoord;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float3 vPos : POSITION;
	float2 vBaseTexCoord : TEXCOORD0;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
	l.vBaseTexCoord = i.vBaseTexCoord;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
	float4 texCoord01 : TEXCOORD0;
	float4 texCoord23 : TEXCOORD1;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
	return o;
}


#define texCoord0	texCoord01.xy
#define texCoord1	texCoord01.zw
#define texCoord2	texCoord23.xy
#define texCoord3	texCoord23.zw

VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	o.projPos		= float4( v.vPos, 1.0f );

	o.texCoord0		= mul( float3( v.vBaseTexCoord, 1 ), (float3x2)cXformTexCoord0 );
	o.texCoord1		= mul( float3( v.vBaseTexCoord, 1 ), (float3x2)cXformTexCoord1 );
	o.texCoord2		= mul( float3( v.vBaseTexCoord, 1 ), (float3x2)cXformTexCoord2 );
	o.texCoord3		= mul( float3( v.vBaseTexCoord, 1 ), (float3x2)cXformTexCoord3 );

	return DX12FinishVertex( o );
}
