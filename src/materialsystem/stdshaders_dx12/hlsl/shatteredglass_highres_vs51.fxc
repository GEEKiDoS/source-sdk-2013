#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/ShatteredGlass_vs20.fxc for logical shatteredglass_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//	DYNAMIC: "DOWATERFOG"				"0..1"
//	STATIC: "ENVMAP_MASK"			"0..1"
#include "common_vs_fxc.h"

static const int g_FogType					= DOWATERFOG;
static const bool g_UseSeparateEnvmapMask	= ENVMAP_MASK;


cbuffer ShatteredGlass_vs20 : register( b2, space1 )
{
	float4 cModulationColor; // @legacy vs:c47
	float4 cBaseTexCoordTransform[2]; // @legacy vs:c48
	float4 cDetailTexCoordTransform[2]; // @legacy vs:c50
};


struct VS_INPUT
{
	float3 vPos;
	float4 vNormal;
	float2 vBaseTexCoord;
	float2 vLightmapTexCoord;
	float2 vDetailTexCoord;
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float3 vPos : POSITION;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
	float2 vBaseTexCoord : TEXCOORD0;
	float2 vLightmapTexCoord : TEXCOORD1;
	float2 vDetailTexCoord : TEXCOORD2;
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
	l.vBaseTexCoord = i.vBaseTexCoord;
	l.vLightmapTexCoord = i.vLightmapTexCoord;
	l.vDetailTexCoord = i.vDetailTexCoord;
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 	
#if !defined( _X360 )
	float fog : FOG;
#endif
	float2 baseTexCoord : TEXCOORD0;
	float2 detailTexCoord : TEXCOORD1;
	centroid  float2 lightmapTexCoord : TEXCOORD2;
	float2 envmapMaskTexCoord : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD4;
	float3 worldNormal : TEXCOORD5;
	float4 vertexColor : COLOR;
	float4 fogFactorW : COLOR1;
	centroid float2 shadowBaseLightmapUV : TEXCOORD6;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD7;
	float3 highresPosition : TEXCOORD8;
	float3 highresNormal : TEXCOORD9;
	float3 highresTangentS : TEXCOORD10;
	float3 highresTangentT : TEXCOORD11;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
#if !defined( _X360 )
#endif
	o.vertexColor = saturate( o.vertexColor );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	o.fogFactorW = saturate( o.fogFactorW );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float3 vObjNormal;
	DecompressVertex_Normal( v.vNormal, vObjNormal );

	float4 projPos;
	projPos = mul( float4( v.vPos, 1 ), cModelViewProj );
	o.projPos = projPos;
	projPos.z = dot( float4( v.vPos, 1 ), cModelViewProjZ );
	
	o.worldPos_projPosZ.w = projPos.z;
	o.worldPos_projPosZ.xyz = mul( float4( v.vPos, 1 ), cModel[0] );
	o.worldNormal = mul( vObjNormal, ( float3x3 )cModel[0] );
	o.baseTexCoord.x = dot( v.vBaseTexCoord, cBaseTexCoordTransform[0] ) + cBaseTexCoordTransform[0].w;
	o.baseTexCoord.y = dot( v.vBaseTexCoord, cBaseTexCoordTransform[1] ) + cBaseTexCoordTransform[1].w;
	o.detailTexCoord.x = dot( v.vDetailTexCoord, cDetailTexCoordTransform[0] ) + cDetailTexCoordTransform[0].w;
	o.detailTexCoord.y = dot( v.vDetailTexCoord, cDetailTexCoordTransform[1] ) + cDetailTexCoordTransform[1].w;
	o.envmapMaskTexCoord.x = dot( v.vDetailTexCoord, cDetailTexCoordTransform[0] ) + cDetailTexCoordTransform[0].w;
	o.envmapMaskTexCoord.y = dot( v.vDetailTexCoord, cDetailTexCoordTransform[1] ) + cDetailTexCoordTransform[1].w;
	o.lightmapTexCoord = v.vLightmapTexCoord;
	
	

	o.fogFactorW = CalcFog( o.worldPos_projPosZ.xyz, projPos, g_FogType );
#if !defined( _X360 )
	o.fog = o.fogFactorW;
#endif	
	o.vertexColor = cModulationColor;

	o.shadowBaseLightmapUV = v.vLightmapTexCoord.xy;
o.shadowVertexLightmapUV = v.vLightmapTexCoord.xy;
float3 hlightObjectNormal; DecompressVertex_Normal( v.vNormal, hlightObjectNormal );
o.highresPosition = mul( float4( v.vPos.xyz, 1 ), cModel[0] );
o.highresNormal = normalize( mul( hlightObjectNormal, (float3x3)cModel[0] ) );
o.highresTangentS = 0; o.highresTangentT = 0;
return DX12FinishVertex( o );
}


