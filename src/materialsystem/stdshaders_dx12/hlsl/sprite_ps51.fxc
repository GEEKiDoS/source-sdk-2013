// Native SM5.1 rewrite of materialsystem/stdshaders/sprite_ps2x.fxc for logical sprite_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"		"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// STATIC: "VERTEXCOLOR"			"0..1"
// STATIC: "CONSTANTCOLOR"			"0..1"
// STATIC: "HDRTYPE"				"0..2"
// STATIC: "SRGB"					"0..1"
// STATIC: "SRGB_OUTPUT_ADAPTER"	"0..1"

// DYNAMIC: "HDRENABLED"			"0..1"
// DYNAMIC: "PIXELFOGTYPE"			"0..2"

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"


cbuffer sprite_ps2x : register( b1, space1 )
{
	HALF4 g_Color; // @legacy ps:c0
	float g_HDRColorScale; // @legacy ps:c1
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


Texture2D TexSampler_Texture : register( t0 );
SamplerState TexSampler_Sampler : register( s0 );
static const DX12Sampler2D TexSampler = { TexSampler_Texture, TexSampler_Sampler };

struct PS_INPUT
{
	HALF2 baseTexCoord;		// Base texture coordinate
	float4 color;		// Vertex color (from lighting or unlit)
	
	float4 worldPos_projPosZ;		// Necessary for pixel fog
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	HALF2 baseTexCoord : TEXCOORD0;
	float4 color : TEXCOORD2;
	float4 worldPos_projPosZ : TEXCOORD7;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoord = dx12In.baseTexCoord;
	l.color = dx12In.color;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 result, sample = TexSampler.tex.Sample( TexSampler.smp, i.baseTexCoord );

#if VERTEXCOLOR
	sample *= i.color;
#endif

#if CONSTANTCOLOR
	sample *= g_Color;
#endif
	
#if HDRTYPE && HDRENABLED
	sample.xyz *= g_HDRColorScale;
#endif

	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );
#if SRGB
	result = FinalOutput( sample, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR );
#else
	result = FinalOutput( sample, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_GAMMA );
#endif

	// On Posix, we're being forced through a linear-to-gamma curve but don't want it, so we do the opposite here first
#if SRGB_OUTPUT_ADAPTER
	result = GammaToLinear( result );
#endif

	return DX12FinishPixel( result, dx12In.fog );
}

