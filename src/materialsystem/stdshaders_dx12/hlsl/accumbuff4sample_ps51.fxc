// Native SM5.1 rewrite of materialsystem/stdshaders/AccumBuff4Sample_ps2x.fxc for logical accumbuff4sample_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB" "0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D TexSampler0_Texture : register( t0 );
SamplerState TexSampler0_Sampler : register( s0 );
static const DX12Sampler2D TexSampler0 = { TexSampler0_Texture, TexSampler0_Sampler };
Texture2D TexSampler1_Texture : register( t1 );
SamplerState TexSampler1_Sampler : register( s1 );
static const DX12Sampler2D TexSampler1 = { TexSampler1_Texture, TexSampler1_Sampler };
Texture2D TexSampler2_Texture : register( t2 );
SamplerState TexSampler2_Sampler : register( s2 );
static const DX12Sampler2D TexSampler2 = { TexSampler2_Texture, TexSampler2_Sampler };
Texture2D TexSampler3_Texture : register( t3 );
SamplerState TexSampler3_Sampler : register( s3 );
static const DX12Sampler2D TexSampler3 = { TexSampler3_Texture, TexSampler3_Sampler };

struct PS_INPUT
{
	float2 texCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord : TEXCOORD0;
	float2 ZeroTexCoord : TEXCOORD1;
	float2 bloomTexCoord : TEXCOORD2;
	float4 vColor : TEXCOORD3;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.texCoord = dx12In.baseTexCoord;
	return l;
}


cbuffer AccumBuff4Sample_ps2x : register( b1, space1 )
{
	float4 weights; // @legacy ps:c0
};


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	// Just sample the four input textures
	float4 sample0 = TexSampler0.tex.Sample( TexSampler0.smp, i.texCoord );
	float4 sample1 = TexSampler1.tex.Sample( TexSampler1.smp, i.texCoord );
	float4 sample2 = TexSampler2.tex.Sample( TexSampler2.smp, i.texCoord );
	float4 sample3 = TexSampler3.tex.Sample( TexSampler3.smp, i.texCoord );

	// Compute weighted average and return
	return DX12FinishPixel( FinalOutput( weights.x * sample0 +
						   weights.y * sample1 +
						   weights.z * sample2 +
						   weights.w * sample3, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}
