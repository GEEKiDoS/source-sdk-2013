// Native SM5.1 rewrite of materialsystem/stdshaders/debugmorphaccumulator_ps30.fxc for logical debugmorphaccumulator_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

struct PS_INPUT
{
	float2 vTexCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vProjPos : SV_Position;
	float2 vTexCoord : TEXCOORD0;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.vTexCoord = dx12In.vTexCoord;
	return l;
}


Texture2D MorphAccumulator_Texture : register( t0 );
SamplerState MorphAccumulator_Sampler : register( s0 );
static const DX12Sampler2D MorphAccumulator = { MorphAccumulator_Texture, MorphAccumulator_Sampler };

HALF4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 vDeltas = MorphAccumulator.tex.Sample( MorphAccumulator.smp, i.vTexCoord );
	return DX12FinishPixel( float4( abs( vDeltas.x ), abs( vDeltas.z ), abs( vDeltas.y ) + abs( vDeltas.w ), 1.0f ), 0.0f );
}

