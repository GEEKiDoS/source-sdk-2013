// Native SM5.1 rewrite of materialsystem/stdshaders/Eyes_vs20.fxc for logical eyes_vs30 (legacy profile vs30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs30 set.
#define DX12_LEGACY_VS30 1
#include "dx12_preamble.h"
//======= Copyright � 1996-2006, Valve Corporation, All rights reserved. ======
// $SHADER_SPECIFIC_CONST_0	 = eyeball origin			
// $SHADER_SPECIFIC_CONST_1	 = eyeball up * 0.5			
// $SHADER_SPECIFIC_CONST_2	 = iris projection U		
// $SHADER_SPECIFIC_CONST_3	 = iris projection V		
// $SHADER_SPECIFIC_CONST_4	 = glint projection U		
// $SHADER_SPECIFIC_CONST_5	 = glint projection V		
//=============================================================================

//	STATIC: "INTRO"						"0..1"
//  STATIC: "HALFLAMBERT"				"0..1"

//	DYNAMIC: "COMPRESSED_VERTS"			"0..1"
//	DYNAMIC: "SKINNING"					"0..1"
//	DYNAMIC: "DOWATERFOG"				"0..1"
//	DYNAMIC: "DYNAMIC_LIGHT"			"0..1"
//	DYNAMIC: "STATIC_LIGHT"				"0..1"
//  DYNAMIC: "MORPHING"					"0..1"

// If using static control flow on Direct3D, we should use the NUM_LIGHTS=0 combo

#include "vortwarp_vs20_helper.h"

static const int  g_bSkinning		= SKINNING ? true : false;
static const int  g_FogType			= DOWATERFOG;
static const bool g_bHalfLambert	= HALFLAMBERT ? true : false;


cbuffer Eyes_vs20 : register( b2, space1 )
{
	float3 cEyeOrigin; // @legacy vs:c48
	float3 cHalfEyeballUp; // @legacy vs:c49
	float4 cIrisProjectionU; // @legacy vs:c50
	float4 cIrisProjectionV; // @legacy vs:c51
	float4 cGlintProjectionU; // @legacy vs:c52
	float4 cGlintProjectionV; // @legacy vs:c53
	float4 const4; // @legacy vs:c54
	float3 cMorphTargetTextureDim; // @legacy vs:c55
	float4 cMorphSubrect; // @legacy vs:c56
};


#if INTRO

#define g_Time const4.w
#define modelOrigin const4.xyz
#endif

#ifdef DX12_LEGACY_VS30
// NOTE: cMorphTargetTextureDim.xy = target dimensions,
//		 cMorphTargetTextureDim.z = 4tuples/morph


Texture2D morphSampler_Texture : register( t0 );
SamplerState morphSampler_Sampler : register( s0 );
static const DX12Sampler2D morphSampler = { morphSampler_Texture, morphSampler_Sampler };
#endif

struct VS_INPUT
{
	float4 vPos;			// Position
	float4 vBoneWeights;		// Skin weights
	float4 vBoneIndices;		// Skin indices
	float4 vTexCoord0;		// Base (sclera) texture coordinates

	float3 vPosFlex;		// Delta positions for flexing
#ifdef DX12_LEGACY_VS30
	float vVertexID;
#endif
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
	float4 vTexCoord0 : TEXCOORD0;
	float3 vPosFlex : POSITION1;
#ifdef DX12_LEGACY_VS30
	float vVertexID : POSITION2;
#endif
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
	l.vTexCoord0 = i.vTexCoord0;
	l.vPosFlex = i.vPosFlex;
#ifdef DX12_LEGACY_VS30
	l.vVertexID = i.vVertexID;
#endif
	return l;
}


struct VS_OUTPUT
{
	float4 projPos : SV_Position; 			// Projection-space position
#if !defined( _X360 )
	float fog : FOG; 				// Fixed-function fog factor
#endif
	float2 baseTC : TEXCOORD0; 		// Base texture coordinate
	float2 irisTC : TEXCOORD1; 		// Iris texture coordinates
	float2 glintTC : TEXCOORD2; 		// Glint texture coordinates
	float3 vColor : TEXCOORD3; 		// Vertex-lit color
	float4 worldPos_projPosZ : TEXCOORD7; 		// Necessary for pixel fog
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.projPos );
	o.projPos = DX12Position( o.projPos );
#if !defined( _X360 )
#endif
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = (VS_OUTPUT)0;

	bool bDynamicLight = DYNAMIC_LIGHT ? true : false;
	bool bStaticLight = STATIC_LIGHT ? true : false;

	float4 vPosition = v.vPos;
	float3 dummy = v.vPos.xyz;		// dummy values that can't be optimized out

#if !defined( DX12_LEGACY_VS30 ) || !MORPHING
	ApplyMorph( v.vPosFlex, vPosition.xyz );
#else
	ApplyMorph( morphSampler, cMorphTargetTextureDim, cMorphSubrect, v.vVertexID, dummy, vPosition.xyz );
#endif

	// Transform the position and dummy normal (not doing the dummy normal causes invariance issues with the flashlight!)
	float3 worldNormal, worldPos;
	SkinPositionAndNormal( 
		g_bSkinning, 
		vPosition, dummy,
		v.vBoneWeights, v.vBoneIndices,
		worldPos, worldNormal );

#if INTRO
	WorldSpaceVertexProcess( g_Time, modelOrigin, worldPos, dummy, dummy, dummy );
#endif

	// Transform into projection space
	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.projPos = vProjPos;
	vProjPos.z = dot( float4( worldPos, 1 ), cViewProjZ );
	o.worldPos_projPosZ = float4( worldPos.xyz, vProjPos.z );

#if !defined( _X360 )
	// Set fixed-function fog factor
	o.fog = CalcFog( worldPos, vProjPos, g_FogType );
#endif

	// Normal = (Pos - Eye origin) - just step on dummy normal created above
	worldNormal = worldPos - cEyeOrigin;

	// Normal -= 0.5f * (Normal dot Eye Up) * Eye Up
	float normalDotUp = -dot( worldNormal, cHalfEyeballUp) * 0.5f;
	worldNormal = normalize(normalDotUp * cHalfEyeballUp + worldNormal);

	// Vertex lighting
#if ( USE_STATIC_CONTROL_FLOW || defined ( DX12_LEGACY_VS30 ) )
	o.vColor = DoLighting( worldPos, worldNormal, float3(0.0f, 0.0f, 0.0f), bStaticLight, bDynamicLight, g_bHalfLambert );
#else
	o.vColor = DoLightingUnrolled( worldPos, worldNormal, float3(0.0f, 0.0f, 0.0f), bStaticLight, bDynamicLight, g_bHalfLambert, NUM_LIGHTS );
#endif

	// Texture 0 is the base texture
	// Texture 1 is a planar projection used for the iris
	// Texture 2 is a planar projection used for the glint
	o.baseTC    = v.vTexCoord0;
	o.irisTC.x  = dot( cIrisProjectionU,  float4(worldPos, 1) );
	o.irisTC.y  = dot( cIrisProjectionV,  float4(worldPos, 1) );
	o.glintTC.x = dot( cGlintProjectionU, float4(worldPos, 1) );
	o.glintTC.y = dot( cGlintProjectionV, float4(worldPos, 1) );

	return DX12FinishVertex( o );
}


