// Purpose: 
//
//=============================================================================

// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"  "0..1"
// DYNAMIC: "PIXELFOGTYPE"				"0..2"

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D IrisSampler_Texture : register( t1 );
SamplerState IrisSampler_Sampler : register( s1 );
static const DX12Sampler2D IrisSampler = { IrisSampler_Texture, IrisSampler_Sampler };
Texture2D GlintSampler_Texture : register( t2 );
SamplerState GlintSampler_Sampler : register( s2 );
static const DX12Sampler2D GlintSampler = { GlintSampler_Texture, GlintSampler_Sampler };

cbuffer eyes_ps2x : register( b1, space1 )
{
	float4 cEyeScalars; // @legacy ps:c0
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


struct PS_INPUT
{
	float2 baseTexCoord;
	float2 irisTexCoord;
	float2 glintTexCoord;
	float3 vertAtten;
	
	float4 worldPos_projPosZ;		// Necessary for pixel fog
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
#if !defined( _X360 )
	float fog : FOG;
#endif
	float2 baseTC : TEXCOORD0;
	float2 irisTC : TEXCOORD1;
	float2 glintTC : TEXCOORD2;
	float3 vColor : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD7;
	float3 worldPos : TEXCOORD4;
	float3 worldNormal : TEXCOORD5;
	float2 shadowResponse : TEXCOORD6;

	uint shadowPrimitiveId : SV_PrimitiveID;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoord = dx12In.baseTC;
	l.irisTexCoord = dx12In.irisTC;
	l.glintTexCoord = dx12In.glintTC;
	l.vertAtten = dx12In.vColor;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	return l;
}


#define fDilationFactor	cEyeScalars.x
#define fGlintDamping	cEyeScalars.y

float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
	// GatherDirect adds styled prop RGB for Lambert/half-Lambert, then resident deltas.
	ShadowMap_SetBakedProp( smr, dx12In.shadowPrimitiveId );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	float4 baseSample  = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.baseTexCoord );
	float4 glintSample = GlintSampler.tex.Sample( GlintSampler.smp, i.glintTexCoord );
/*
	// Dilate the pupil/iris texture (1 is max dilation, 0 is none)
	float2 biasedCoords = i.irisTexCoord * 2.0f - 1.0f;								// -1 to +1 range
	float fDilatability = saturate(0.8f - sqrt(dot(biasedCoords, biasedCoords) ));	// 1 in the center, fading out to 0 at 0.8 from center, since irises are inset into maps
	float2 scaledCoords = biasedCoords * (1 + fDilatability);						// Maximal dilation
	
	// Blend undilated and maximally dilated based upon dilation factor
	float2 dilatedCoords = lerp( scaledCoords, biasedCoords, 1.0f-saturate(cDilationFactor.x));	
	dilatedCoords = dilatedCoords * 0.5f + 0.5f;									// Back to 0..1 range
*/

	float4 irisSample = IrisSampler.tex.Sample( IrisSampler.smp, i.irisTexCoord );						// Sample the iris map using dilated coordinates

	float4 result;
	result.rgb = lerp( baseSample.rgb, irisSample.rgb, irisSample.a );
	smd = ShadowMap_GatherDirect( smr, ShadowMap_ShadeHalfLambert( dx12In.worldNormal, dx12In.shadowResponse.x != 0 ) );
	result.rgb *= i.vertAtten + smd.diffuse;
	result.rgb += glintSample.rgb * fGlintDamping;
	result.a = baseSample.a;
	
	bool bWriteDepthToAlpha = false;

	// ps_2_b and beyond
#if !(defined(SHADER_MODEL_PS_1_1) || defined(SHADER_MODEL_PS_1_4) || defined(DX12_LEGACY_PS20))
	bWriteDepthToAlpha = WRITE_DEPTH_TO_DESTALPHA != 0;
#endif

	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );
	
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, i.worldPos_projPosZ.w  ), dx12In.fog );
	return ShadowMap_Debug( smr, smd, dx12Lit0_0 );
	}
#else
	return DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, i.worldPos_projPosZ.w  ), dx12In.fog );
#endif

}
