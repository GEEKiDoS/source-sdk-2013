// Native SM5.1 rewrite of materialsystem/stdshaders/sky_hdr_compressed_ps2x.fxc for logical sky_hdr_compressed_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"			"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"	"0..1"
#include "common_ps_fxc.h"

#if defined( DX12_LEGACY_PS20 )
#	define WRITE_DEPTH_TO_DESTALPHA 0
#endif

Texture2D ExposureTextureSampler0_Texture : register( t0 );
SamplerState ExposureTextureSampler0_Sampler : register( s0 );
static const DX12Sampler2D ExposureTextureSampler0 = { ExposureTextureSampler0_Texture, ExposureTextureSampler0_Sampler };
Texture2D ExposureTextureSampler1_Texture : register( t1 );
SamplerState ExposureTextureSampler1_Sampler : register( s1 );
static const DX12Sampler2D ExposureTextureSampler1 = { ExposureTextureSampler1_Texture, ExposureTextureSampler1_Sampler };
Texture2D ExposureTextureSampler2_Texture : register( t2 );
SamplerState ExposureTextureSampler2_Sampler : register( s2 );
static const DX12Sampler2D ExposureTextureSampler2 = { ExposureTextureSampler2_Texture, ExposureTextureSampler2_Sampler };

struct PS_INPUT
{
	float2 baseTexCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord00 : TEXCOORD0;
	float2 baseTexCoord01 : TEXCOORD1;
	float2 baseTexCoord10 : TEXCOORD2;
	float2 baseTexCoord11 : TEXCOORD3;
	float2 baseTexCoord_In_Pixels : TEXCOORD4;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoord = dx12In.baseTexCoord00;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	HALF3 color0 = 0.25*ExposureTextureSampler0.tex.Sample( ExposureTextureSampler0.smp, i.baseTexCoord );
	HALF3 color1 = 2.0*ExposureTextureSampler1.tex.Sample( ExposureTextureSampler1.smp, i.baseTexCoord );
	HALF3 color2 = 16.0*ExposureTextureSampler2.tex.Sample( ExposureTextureSampler2.smp, i.baseTexCoord );

	// This is never fogged.
//	return FinalOutput( float4( max(max(color0,color1),color2), 1.0f ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_LINEAR, WRITE_DEPTH_TO_DESTALPHA, 1e20 ); //when writing depth to dest alpha, write a value guaranteed to saturate
	return DX12FinishPixel( FinalOutput( float4(1,0,0,1 ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_LINEAR, WRITE_DEPTH_TO_DESTALPHA, 1e20 ), 0.0f ); //when writing depth to dest alpha, write a value guaranteed to saturate
}
