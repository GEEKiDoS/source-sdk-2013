// Native SM5.1 rewrite of materialsystem/stdshaders/debugmrttexture_ps2x.fxc for logical debugmrttexture_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"	"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// STATIC: "MRTINDEX"			"0..1"

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

struct PS_INPUT
{
	float2 baseTexCoord;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseTexCoord : TEXCOORD0;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoord = dx12In.baseTexCoord;
	return l;
}


Texture2D BaseTextureSampler1_Texture : register( t0 );
SamplerState BaseTextureSampler1_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler1 = { BaseTextureSampler1_Texture, BaseTextureSampler1_Sampler };
Texture2D BaseTextureSampler2_Texture : register( t1 );
SamplerState BaseTextureSampler2_Sampler : register( s1 );
static const DX12Sampler2D BaseTextureSampler2 = { BaseTextureSampler2_Texture, BaseTextureSampler2_Sampler };

float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if MRTINDEX == 0
	float4 result = BaseTextureSampler1.tex.Sample( BaseTextureSampler1.smp, i.baseTexCoord );
#else
	float4 result = BaseTextureSampler2.tex.Sample( BaseTextureSampler2.smp, i.baseTexCoord );
#endif

	return DX12FinishPixel( FinalOutput( result, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), 0.0f );
}

