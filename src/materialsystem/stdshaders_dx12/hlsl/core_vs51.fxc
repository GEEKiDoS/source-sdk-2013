// Native SM5.1 rewrite of materialsystem/stdshaders/core_vs20.fxc for logical core_vs20 (legacy profile vs20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the vs20 set.
#define DX12_LEGACY_VS20 1
#include "dx12_preamble.h"
//	STATIC: "MODEL"					"0..1"

//	DYNAMIC: "COMPRESSED_VERTS"		"0..1"
//	DYNAMIC: "SKINNING"				"0..1"

#include "common_vs_fxc.h"

static const bool g_bSkinning		= SKINNING ? true : false;
static const bool g_bModel			= MODEL ? true : false;


cbuffer core_vs20 : register( b2, space1 )
{
	float4 cBumpTexCoordTransform[2]; // @legacy vs:c49
};


struct VS_INPUT
{
	float4 vPos;
	float4 vBoneWeights;
	float4 vBoneIndices;
	float4 vNormal;
	float4 vBaseTexCoord;
#if !MODEL
	float3 vTangentS;
	float3 vTangentT;
#else
	float4 vUserData;
#endif
};
// Entry input as the DX12 input layout delivers it (vertex_layout_dx12.cpp): integer compressed
// streams and D3DCOLOR byte order are converted exactly like the D3D9 declaration types.
struct DX12_VS_INPUT
{
#if COMPRESSED_VERTS
	uint4 vTangentS : TANGENT;
#else
	float4 vTangentS : TANGENT;
#endif
	float4 vPos : POSITION;
#if COMPRESSED_VERTS
	int2 vBoneWeights : BLENDWEIGHT;
#else
	float4 vBoneWeights : BLENDWEIGHT;
#endif
	float4 vBoneIndices : BLENDINDICES;
#if COMPRESSED_VERTS
	uint4 vNormal : NORMAL;
#else
	float4 vNormal : NORMAL;
#endif
	float4 vBaseTexCoord : TEXCOORD0;
#if !MODEL
	float3 vTangentT : BINORMAL0;
#else
#endif
};
VS_INPUT DX12ConvertInput( DX12_VS_INPUT i )
{
	VS_INPUT l = (VS_INPUT)0;
	l.vPos = i.vPos;
#if COMPRESSED_VERTS
	l.vBoneWeights = float4( (float2)i.vBoneWeights, 0, 1 );
#else
	l.vBoneWeights = i.vBoneWeights;
#endif
	l.vBoneIndices = i.vBoneIndices;
#if COMPRESSED_VERTS
	l.vNormal = (float4)i.vNormal;
#else
	l.vNormal = i.vNormal;
#endif
	l.vBaseTexCoord = i.vBaseTexCoord;
#if !MODEL
#if COMPRESSED_VERTS
	l.vTangentS = ( (float4)i.vTangentS ).xyz;
#else
	l.vTangentS = ( i.vTangentS ).xyz;
#endif
	l.vTangentT = i.vTangentT;
#else
#if COMPRESSED_VERTS
	l.vUserData = (float4)i.vTangentS;
#else
	l.vUserData = i.vTangentS;
#endif
#endif
	return l;
}


struct VS_OUTPUT
{
	float4 vProjPos_POSITION : SV_Position; 	
	float vFog : FOG;
	float2 vBumpTexCoord : TEXCOORD0;
	float3 vTangentEyeVect : TEXCOORD1;
	float3x3 tangentSpaceTranspose : TEXCOORD2;
	float3 vRefractXYW : TEXCOORD5;
	float4 projNormal_screenCoordW : TEXCOORD6;
	float4 worldPos_projPosZ : TEXCOORD7;
	float4 fogFactorW : COLOR1;
	DX12ClipDistances dx12Clip;	// SV_ClipDistance0/1 (trailing; pixel inputs omit it)
};
VS_OUTPUT DX12FinishVertex( VS_OUTPUT o )
{
	o.dx12Clip = DX12UserClipDistances( o.vProjPos_POSITION );
	o.vProjPos_POSITION = DX12Position( o.vProjPos_POSITION );
	o.fogFactorW = saturate( o.fogFactorW );	// vs_2_0 oD# clamp (vsconv.cpp:1033-1035)
	return o;
}


VS_OUTPUT main( const DX12_VS_INPUT dx12In )
{
	const VS_INPUT v = DX12ConvertInput( dx12In );
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float3 worldNormal, worldPos, worldTangentS, worldTangentT;

	float3 vObjNormal;
#if MODEL
	float4 vObjTangent;
	DecompressVertex_NormalTangent( v.vNormal, v.vUserData, vObjNormal, vObjTangent );

	SkinPositionNormalAndTangentSpace( 
			g_bSkinning, 
			v.vPos, vObjNormal, vObjTangent,
			v.vBoneWeights, v.vBoneIndices,
			worldPos, worldNormal, worldTangentS, worldTangentT );
#else
	DecompressVertex_Normal( v.vNormal, vObjNormal );

	worldPos = mul( v.vPos, cModel[0] );
	worldTangentS = mul( v.vTangentS, ( const float3x3 )cModel[0] );
	worldTangentT = mul( v.vTangentT, ( const float3x3 )cModel[0] );
	worldNormal = mul( vObjNormal, ( float3x3 )cModel[0] );
#endif


	// Projected position
	float4 vProjPos = mul( float4( worldPos, 1 ), cViewProj );
	o.vProjPos_POSITION = vProjPos;
	o.projNormal_screenCoordW.xyz = mul( worldNormal, cViewProj );
	
	o.worldPos_projPosZ = float4( worldPos.xyz, vProjPos.z );

	// Map projected position to the refraction texture
	float2 vRefractPos;
	vRefractPos.x = vProjPos.x;
	vRefractPos.y = -vProjPos.y; // invert Y
	vRefractPos = (vRefractPos + vProjPos.w) * 0.5f;

	// Refraction transform
	o.vRefractXYW = float3(vRefractPos.x, vRefractPos.y, vProjPos.w);

	// Compute fog based on the position
	float3 vWorldPos = mul( v.vPos, cModel[0] );
	o.fogFactorW = o.vFog = CalcFog( vWorldPos, vProjPos, FOGTYPE_RANGE );

	// Eye vector
	float3 vWorldEyeVect = cEyePos - vWorldPos;
	// Transform to the tangent space
	o.vTangentEyeVect.x = dot( vWorldEyeVect, worldTangentS );
	o.vTangentEyeVect.y = dot( vWorldEyeVect, worldTangentT );
	o.vTangentEyeVect.z = dot( vWorldEyeVect, worldNormal );

	// Tranform bump coordinates
	o.vBumpTexCoord.x = dot( v.vBaseTexCoord, cBumpTexCoordTransform[0] );
	o.vBumpTexCoord.y = dot( v.vBaseTexCoord, cBumpTexCoordTransform[1] );

	o.tangentSpaceTranspose[0] = worldTangentS;
	o.tangentSpaceTranspose[1] = worldTangentT;
	o.tangentSpaceTranspose[2] = worldNormal;

	return DX12FinishVertex( o );
}
