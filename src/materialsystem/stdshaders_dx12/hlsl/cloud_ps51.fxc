// Native SM5.1 rewrite of materialsystem/stdshaders/cloud_ps20.fxc for logical cloud_ps20 (legacy profile ps20);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20 set.
#define DX12_LEGACY_PS20 1
#include "dx12_preamble.h"
#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D CloudAlphaSampler_Texture : register( t1 );
SamplerState CloudAlphaSampler_Sampler : register( s1 );
static const DX12Sampler2D CloudAlphaSampler = { CloudAlphaSampler_Texture, CloudAlphaSampler_Sampler };

struct PS_INPUT
{
	float2 baseCoords;
	float2 cloudAlphaCoords;
	float  fogFactor;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
	float2 baseCoords : TEXCOORD0;
	float2 cloudAlphaCoords : TEXCOORD1;
	float fogFactor : TEXCOORD2;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseCoords = dx12In.baseCoords;
	l.cloudAlphaCoords = dx12In.cloudAlphaCoords;
	l.fogFactor = dx12In.fogFactor;
	return l;
}

 
float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	float4 vBase = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.baseCoords );
	float4 vCloudAlpha = CloudAlphaSampler.tex.Sample( CloudAlphaSampler.smp, i.cloudAlphaCoords );

	float fogFactor = 2.0f * smoothstep( 0.3f, 0.6f, i.fogFactor );

	float4 result = vBase * vCloudAlpha;
	result.a *= fogFactor;

	// No actual fog.  Use the "fog factor" to modulate alpha (after some smoothstep mojo)
	return DX12FinishPixel( FinalOutput( result, 1.0f, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_LINEAR ), 0.0f );
}
