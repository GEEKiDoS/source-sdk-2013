#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/teeth_ps2x.fxc for logical teeth_ps30 (legacy profile ps30);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps30 set.
#define DX12_LEGACY_PS30 1
#include "dx12_preamble.h"
//====== Copyright � 1996-2004, Valve Corporation, All rights reserved. =======
//
// Purpose: 
//
//=============================================================================

// STATIC: "CONVERT_TO_SRGB"				"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

// DYNAMIC: "PIXELFOGTYPE"					"0..2"
// DYNAMIC: "WRITE_DEPTH_TO_DESTALPHA"		"0..1"


#if defined( DX12_LEGACY_PS20 )
#	define WRITE_DEPTH_TO_DESTALPHA 0
#endif

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };


cbuffer teeth_ps2x : register( b1, space1 )
{
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


struct PS_INPUT
{
	float2 baseTexCoord;
	float3 vertAtten;
	
	float4 worldPos_projPosZ;		// Necessary for pixel fog
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
#if !defined( _X360 )    
	float fog : FOG;
#endif
	float2 baseTexCoord : TEXCOORD0;
	float3 vertAtten : TEXCOORD1;
	float4 worldPos_projPosZ : TEXCOORD7;
	float3 worldPos : TEXCOORD2;
	float3 worldNormal : TEXCOORD3;
	float2 shadowResponse : TEXCOORD4;

	uint shadowPrimitiveId : SV_PrimitiveID;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	l.baseTexCoord = dx12In.baseTexCoord;
	l.vertAtten = dx12In.vertAtten;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
	// GatherDirect adds styled prop RGB for Lambert/half-Lambert, then resident deltas.
	ShadowMap_SetBakedProp( smr, dx12In.shadowPrimitiveId );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	float4 baseSample = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.baseTexCoord );
	
	float4 result;
	smd = ShadowMap_GatherDirect( smr, ShadowMap_ShadeLambert( dx12In.worldNormal ) );
	result.xyz = baseSample.xyz * ( i.vertAtten + smd.diffuse * dx12In.shadowResponse.y );
	result.a = baseSample.a;
	
	
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );
	
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, (WRITE_DEPTH_TO_DESTALPHA != 0), i.worldPos_projPosZ.w ), dx12In.fog );
	return ShadowMap_Debug( smr, smd, dx12Lit0_0 );
	}
#else
	return DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, (WRITE_DEPTH_TO_DESTALPHA != 0), i.worldPos_projPosZ.w ), dx12In.fog );
#endif

}
