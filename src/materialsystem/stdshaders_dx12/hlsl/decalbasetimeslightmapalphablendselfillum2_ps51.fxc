// Native SM5.1 rewrite of materialsystem/stdshaders/decalbasetimeslightmapalphablendselfillum2_ps2x.fxc for logical decalbasetimeslightmapalphablendselfillum2_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// DYNAMIC: "PIXELFOGTYPE"		"0..1"

// STATIC: "CONVERT_TO_SRGB"	"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]

#include "shader_constant_register_map.h"
#include "common_ps_fxc.h"

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };


cbuffer decalbasetimeslightmapalphablendselfillum2_ps2x : register( b1, space1 )
{
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


struct PS_INPUT
{
	float2 vTexCoord0;
	float4 worldPos_projPosZ;		// Necessary for pixel fog
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
#define FLASHLIGHT 0	// value the material always gives the paired vertex shader
#define LIGHTING_PREVIEW 0	// value the material always gives the paired vertex shader
#define RELIEF_MAPPING 0	// value the material always gives the paired vertex shader
#define SEAMLESS 0	// value the material always gives the paired vertex shader
#define TANGENTSPACE 0	// value the material always gives the paired vertex shader
struct DX12_PS_INPUT
{
	float4 projPos : SV_Position;
#if !defined( _X360 )    
	float fog : FOG;
#endif
#if SEAMLESS
	float3 SeamlessTexCoord : TEXCOORD0;
	float4 detailOrBumpAndEnvmapMaskTexCoord : TEXCOORD1;
#else
	float2 baseTexCoord : TEXCOORD0;
#if RELIEF_MAPPING
	float3 TangentSpaceViewRay : TEXCOORD1;
#else
	float4 detailOrBumpAndEnvmapMaskTexCoord : TEXCOORD1;
#endif
#endif
	centroid  float4 lightmapTexCoord1And2 : TEXCOORD2;
	centroid  float4 lightmapTexCoord3 : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD4;
	float3x3 tangentSpaceTranspose : TEXCOORD5;
	float4 vertexColor : COLOR;
	float4 vertexBlendX_fogFactorW : COLOR1;
#if defined( _X360 )
	float4 flashlightSpacePos : TEXCOORD8;
	float4 vProjPos : TEXCOORD9;
#endif
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
#if ( !( SEAMLESS ) )
	l.vTexCoord0 = dx12In.baseTexCoord;
#endif
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	return l;
}
#undef FLASHLIGHT
#undef LIGHTING_PREVIEW
#undef RELIEF_MAPPING
#undef SEAMLESS
#undef TANGENTSPACE


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	HALF4 result = BaseTextureSampler.tex.Sample( BaseTextureSampler.smp, i.vTexCoord0 );
	
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.z, i.worldPos_projPosZ.z, i.worldPos_projPosZ.w );
	return DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), dx12In.fog );
}
