// Native SM5.1 rewrite of materialsystem/stdshaders/portalstaticoverlay_ps2x.fxc for logical portalstaticoverlay_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#include "dx12_preamble.h"
// STATIC: "CONVERT_TO_SRGB"	"0..1"	[= g_pHardwareConfig->NeedsShaderSRGBConversion()]
// STATIC: "HASALPHAMASK"		"0..1"
// STATIC: "HASSTATICTEXTURE"	"0..1"

// DYNAMIC: "HDRENABLED"		"0..1"
// DYNAMIC: "PIXELFOGTYPE"		"0..1"

#include "common_ps_fxc.h"
#include "shader_constant_register_map.h"


cbuffer portalstaticoverlay_ps2x : register( b1, space1 )
{
	HALF3 g_StaticAmount; // @legacy ps:c0
	float4 g_EyePos_SpecExponent; // @legacy ps:c11
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


#if( HASSTATICTEXTURE )
	Texture2D StaticTextureSampler_Texture : register( t0 );
	SamplerState StaticTextureSampler_Sampler : register( s0 );
	static const DX12Sampler2D StaticTextureSampler = { StaticTextureSampler_Texture, StaticTextureSampler_Sampler };
#	if( HASALPHAMASK )
		Texture2D AlphaMaskSampler_Texture : register( t1 );
		SamplerState AlphaMaskSampler_Sampler : register( s1 );
		static const DX12Sampler2D AlphaMaskSampler = { AlphaMaskSampler_Texture, AlphaMaskSampler_Sampler };
#	endif
#else
#	if( HASALPHAMASK )
		Texture2D AlphaMaskSampler_Texture : register( t0 );
		SamplerState AlphaMaskSampler_Sampler : register( s0 );
		static const DX12Sampler2D AlphaMaskSampler = { AlphaMaskSampler_Texture, AlphaMaskSampler_Sampler };
#	endif
#endif

struct PS_INPUT
{
	float4 vProjPos;
	
	//vStaticTexCoord and vAlphaMaskTexCoord are the same numbers, but we need to map TEXCOORD0 to sampler 0, and TEXCOORD1 to sampler1. ps11 compatibility issue
#if( HASSTATICTEXTURE )
	float2 vStaticTexCoord;
#	if( HASALPHAMASK )
		float2 vAlphaMaskTexCoord;
#	endif
#else
#	if( HASALPHAMASK )
		float2 vAlphaMaskTexCoord;
#	else
		float2 vUnusedTexCoord1;
#	endif
	float2 vUnusedTexCoord2;
#endif

	float4 worldPos_projPosZ;		// Necessary for pixel fog
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 vProjPos : SV_Position;
	float2 vTexCoord1 : TEXCOORD0;
	float2 vTexCoord2 : TEXCOORD1;
	float vFog : FOG;
	float4 worldPos_projPosZ : TEXCOORD7;
};
PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
	// vProjPos : POSITION (ps2.x cannot read POSITION)
#if( HASSTATICTEXTURE )
	l.vStaticTexCoord = dx12In.vTexCoord1;
#	if( HASALPHAMASK )
	l.vAlphaMaskTexCoord = dx12In.vTexCoord2;
#	endif
#else
#	if( HASALPHAMASK )
	l.vAlphaMaskTexCoord = dx12In.vTexCoord1;
#	else
	l.vUnusedTexCoord1 = dx12In.vTexCoord1;
#	endif
	l.vUnusedTexCoord2 = dx12In.vTexCoord2;
#endif
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	return l;
}


float4 main( DX12_PS_INPUT dx12In ) : SV_Target0
{
	PS_INPUT i = DX12ConvertInput( dx12In );
	HALF4 result;
	
#	if( HASSTATICTEXTURE )
		result.rgb = StaticTextureSampler.tex.Sample( StaticTextureSampler.smp, i.vStaticTexCoord ).rgb;
#	else
		result.rgb = 0.25; //without a static texture, just be gray
#	endif


#	if( HASALPHAMASK )
		result.a = min( g_StaticAmount.x, AlphaMaskSampler.tex.Sample( AlphaMaskSampler.smp, i.vAlphaMaskTexCoord ).a ); //when static reaches 0, fades away completely, also never exceeds the mask's alpha
#	else
		result.a = g_StaticAmount.x; //when static reaches 0, fades away completely
#	endif


	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos_SpecExponent.z, i.worldPos_projPosZ.z, i.worldPos_projPosZ.w );
	return DX12FinishPixel( FinalOutput( result, fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR ), dx12In.vFog );
}