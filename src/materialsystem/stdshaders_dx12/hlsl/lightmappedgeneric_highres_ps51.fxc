// HIGHLIGHT_SAMPLERS: 2
#define DX12_HIGHRES_LIGHTMAPS 1
#define DX12_SHADOWMAPS 1
// Native SM5.1 rewrite of materialsystem/stdshaders/lightmappedgeneric_ps2x.fxc for logical lightmappedgeneric_ps20b (legacy profile ps20b);
// generated mechanically by gensource.py, then reviewed. Combo directives are the ps20b set.
#define DX12_LEGACY_PS20B 1
#define DX12_COMBO_FOLD 1
#include "dx12_preamble.h"
// Feature receivers are lit, non-flashlight, non-preview passes only.
// SKIP: $LIGHTING_PREVIEW != 0
//========= Copyright Valve Corporation, All rights reserved. ============//
// STATIC: "RELIEF_MAPPING" "0..0"
// STATIC: "SEAMLESS" "0..1"
// STATIC: "NORMAL_DECODE_MODE" "0..0"
// STATIC: "NORMALMASK_DECODE_MODE" "0..0"
// DYNAMIC: "LIGHTING_PREVIEW" "0..2"
// FOLD: "MASKEDBLENDING" "0..1" STATIC slot=0
// FOLD: "BASETEXTURE2" "0..1" STATIC slot=1
// FOLD: "DETAILTEXTURE" "0..1" STATIC slot=2
// FOLD: "BUMPMAP" "0..2" STATIC slot=3
// FOLD: "BUMPMAP2" "0..1" STATIC slot=4
// FOLD: "CUBEMAP" "0..1" STATIC slot=5
// FOLD: "ENVMAPMASK" "0..1" STATIC slot=6
// FOLD: "BASEALPHAENVMAPMASK" "0..1" STATIC slot=7
// FOLD: "SELFILLUM" "0..1" STATIC slot=8
// FOLD: "NORMALMAPALPHAENVMAPMASK" "0..1" STATIC slot=9
// FOLD: "DIFFUSEBUMPMAP" "0..1" STATIC slot=10
// FOLD: "BASETEXTURENOENVMAP" "0..1" STATIC slot=11
// FOLD: "BASETEXTURE2NOENVMAP" "0..1" STATIC slot=12
// FOLD: "WARPLIGHTING" "0..1" STATIC slot=13
// FOLD: "FANCY_BLENDING" "0..1" STATIC slot=14
// FOLD: "OUTLINE" "0..1" STATIC slot=15
// FOLD: "SOFTEDGES" "0..1" STATIC slot=16
// FOLD: "BUMPMASK" "0..1" STATIC slot=17
// FOLD: "DETAIL_BLEND_MODE" "0..11" STATIC slot=18
// FOLD: "FASTPATHENVMAPCONTRAST" "0..1" DYNAMIC slot=19
// FOLD: "FASTPATH" "0..1" DYNAMIC slot=20
// FOLD: "WRITEWATERFOGTODESTALPHA" "0..1" DYNAMIC slot=21
// FOLD: "PIXELFOGTYPE" "0..2" DYNAMIC slot=22
// FOLD: "WRITE_DEPTH_TO_DESTALPHA" "0..1" DYNAMIC slot=23
// FOLD: "BICUBIC_LIGHTMAP" "0..1" DYNAMIC slot=24
// SKIP: $SEAMLESS && $RELIEF_MAPPING

// PC ps20b implementation of lightmappedgeneric_ps2_3_x.h. Interface selectors
// stay compile-time; all material and fast-path selectors are uniform values.
#define USE_32BIT_LIGHTMAPS_ON_360
#include "common_ps_fxc.h"
#include "common_lightmappedgeneric_fxc.h"

cbuffer lightmappedgeneric_ps2x_shadowmap : register( b1, space1 )
{
	HALF4 g_EnvmapTint; // @legacy ps:c0
	HALF3 g_EnvmapContrast; // @legacy ps:c2
	float4 g_OutlineParams; // @legacy ps:c2
	HALF3 g_EnvmapSaturation; // @legacy ps:c3
	float4 g_OutlineColor; // @legacy ps:c3
	HALF4 g_FresnelReflectionReg; // @legacy ps:c4
	float4 g_EdgeSoftnessParms; // @legacy ps:c4
	HALF4 g_SelfIllumTint; // @legacy ps:c7
	float4 g_DetailTint_and_BlendFactor; // @legacy ps:c8
	HALF3 g_EyePos; // @legacy ps:c10
	float4 g_TintValuesAndLightmapScale; // @legacy ps:c12
	float3 g_ShadowDirectTint; // @legacy ps:c223
};
#define g_FogParams cPixelFogParams	// engine-owned (DX12PSEngine)


#if SEAMLESS
#define USE_FAST_PATH 1
#else
#define USE_FAST_PATH FASTPATH
#endif


#define OUTLINE_MIN_VALUE0 g_OutlineParams.x
#define OUTLINE_MIN_VALUE1 g_OutlineParams.y
#define OUTLINE_MAX_VALUE0 g_OutlineParams.z
#define OUTLINE_MAX_VALUE1 g_OutlineParams.w

#define OUTLINE_COLOR g_OutlineColor

#define SOFT_MASK_MIN g_EdgeSoftnessParms.x
#define SOFT_MASK_MAX g_EdgeSoftnessParms.y

#define g_DetailTint (g_DetailTint_and_BlendFactor.rgb)
#define g_DetailBlendFactor (g_DetailTint_and_BlendFactor.w)


#define g_flAlpha2 g_TintValuesAndLightmapScale.w

Texture2D BaseTextureSampler_Texture : register( t0 );
SamplerState BaseTextureSampler_Sampler : register( s0 );
static const DX12Sampler2D BaseTextureSampler = { BaseTextureSampler_Texture, BaseTextureSampler_Sampler };
Texture2D LightmapSampler_Texture : register( t1 );
SamplerState LightmapSampler_Sampler : register( s1 );
static const DX12Sampler2D LightmapSampler = { LightmapSampler_Texture, LightmapSampler_Sampler };
TextureCube EnvmapSampler_Texture : register( t2 );
SamplerState EnvmapSampler_Sampler : register( s2 );
static const DX12SamplerCube EnvmapSampler = { EnvmapSampler_Texture, EnvmapSampler_Sampler };
Texture2D BlendModulationSampler_Texture : register( t3 );
SamplerState BlendModulationSampler_Sampler : register( s3 );
static const DX12Sampler2D BlendModulationSampler = { BlendModulationSampler_Texture, BlendModulationSampler_Sampler };
Texture2D BumpmapSampler_Texture : register( t4 );
SamplerState BumpmapSampler_Sampler : register( s4 );
static const DX12Sampler2D BumpmapSampler = { BumpmapSampler_Texture, BumpmapSampler_Sampler };
// Bumpmap2 and the environment mask are both 2D textures at the same register.
Texture2D BumpmapSampler2_Texture : register( t5 );
SamplerState BumpmapSampler2_Sampler : register( s5 );
static const DX12Sampler2D BumpmapSampler2 = { BumpmapSampler2_Texture, BumpmapSampler2_Sampler };
Texture2D WarpLightingSampler_Texture : register( t6 );
SamplerState WarpLightingSampler_Sampler : register( s6 );
static const DX12Sampler2D WarpLightingSampler = { WarpLightingSampler_Texture, WarpLightingSampler_Sampler };
Texture2D BaseTextureSampler2_Texture : register( t7 );
SamplerState BaseTextureSampler2_Sampler : register( s7 );
static const DX12Sampler2D BaseTextureSampler2 = { BaseTextureSampler2_Texture, BaseTextureSampler2_Sampler };
Texture2D BumpMaskSampler_Texture : register( t8 );
SamplerState BumpMaskSampler_Sampler : register( s8 );
static const DX12Sampler2D BumpMaskSampler = { BumpMaskSampler_Texture, BumpMaskSampler_Sampler };
Texture2D AlphaMapSampler_Texture : register( t9 );
SamplerState AlphaMapSampler_Sampler : register( s9 );
static const DX12Sampler2D AlphaMapSampler = { AlphaMapSampler_Texture, AlphaMapSampler_Sampler };
Texture2D AlphaMapSampler2_Texture : register( t10 );
SamplerState AlphaMapSampler2_Sampler : register( s10 );
static const DX12Sampler2D AlphaMapSampler2 = { AlphaMapSampler2_Texture, AlphaMapSampler2_Sampler };
Texture2D AlphaMaskSampler_Texture : register( t11 );
SamplerState AlphaMaskSampler_Sampler : register( s11 );
static const DX12Sampler2D AlphaMaskSampler = { AlphaMaskSampler_Texture, AlphaMaskSampler_Sampler };
Texture2D DetailSampler_Texture : register( t12 );
SamplerState DetailSampler_Sampler : register( s12 );
static const DX12Sampler2D DetailSampler = { DetailSampler_Texture, DetailSampler_Sampler };

struct PS_INPUT
{
#if SEAMLESS
	float3 SeamlessTexCoord;
	float4 detailOrBumpAndEnvmapMaskTexCoord;
#else
	HALF2 baseTexCoord;
#if ( RELIEF_MAPPING == 0 )
	HALF4 detailOrBumpAndEnvmapMaskTexCoord;
#endif
#endif
// CENTROID: TEXCOORD2
	HALF4 lightmapTexCoord1And2;
// CENTROID: TEXCOORD3

#define MASKEDBLENDING ( cComboFold[0].x )
#define BASETEXTURE2 ( cComboFold[0].y )
#define DETAILTEXTURE ( cComboFold[0].z )
#define BUMPMAP ( cComboFold[0].w )
#define BUMPMAP2 ( cComboFold[1].x )
#define CUBEMAP ( cComboFold[1].y )
#define ENVMAPMASK ( cComboFold[1].z )
#define BASEALPHAENVMAPMASK ( cComboFold[1].w )
#define SELFILLUM ( cComboFold[2].x )
#define NORMALMAPALPHAENVMAPMASK ( cComboFold[2].y )
#define DIFFUSEBUMPMAP ( cComboFold[2].z )
#define BASETEXTURENOENVMAP ( cComboFold[2].w )
#define BASETEXTURE2NOENVMAP ( cComboFold[3].x )
#define WARPLIGHTING ( cComboFold[3].y )
#define FANCY_BLENDING ( cComboFold[3].z )
#define OUTLINE ( cComboFold[3].w )
#define SOFTEDGES ( cComboFold[4].x )
#define BUMPMASK ( cComboFold[4].y )
#define DETAIL_BLEND_MODE ( cComboFold[4].z )
#define FASTPATHENVMAPCONTRAST ( cComboFold[4].w )
#define FASTPATH ( cComboFold[5].x )
#define WRITEWATERFOGTODESTALPHA ( cComboFold[5].y )
#define PIXELFOGTYPE ( cComboFold[5].z )
#define WRITE_DEPTH_TO_DESTALPHA ( cComboFold[5].w )
#define BICUBIC_LIGHTMAP ( cComboFold[6].x )

	HALF4 lightmapTexCoord3;
	HALF4 worldPos_projPosZ;
	HALF3x3 tangentSpaceTranspose;
	HALF4 vertexColor;
	float4 vertexBlendX_fogFactorW;
};
// Exact mirror of the paired vertex output (same types, order and interpolation) so the signatures
// link register-for-register.
struct DX12_PS_INPUT
{
	float4 svPos : SV_Position;
#if !defined( _X360 )    
	float fog : FOG;
#endif
#if SEAMLESS
	float3 SeamlessTexCoord : TEXCOORD0;
	float4 detailOrBumpAndEnvmapMaskTexCoord : TEXCOORD1;
#else
	float2 baseTexCoord : TEXCOORD0;
#if RELIEF_MAPPING
	float3 TangentSpaceViewRay : TEXCOORD1;
#else
	float4 detailOrBumpAndEnvmapMaskTexCoord : TEXCOORD1;
#endif
#endif
	centroid  float4 lightmapTexCoord1And2 : TEXCOORD2;
	centroid  float4 lightmapTexCoord3 : TEXCOORD3;
	float4 worldPos_projPosZ : TEXCOORD4;
	float3x3 tangentSpaceTranspose : TEXCOORD5;
	float4 vertexColor : COLOR;
	float4 vertexBlendX_fogFactorW : COLOR1;
#if defined( _X360 )
	float4 flashlightSpacePos : TEXCOORD8;
	float4 vProjPos : TEXCOORD9;
#endif
	float3 worldPos : TEXCOORD10;
	float3 worldNormal : TEXCOORD11;
	float2 shadowResponse : TEXCOORD12;
	float3 shadowTangentS : TEXCOORD13;
	float3 shadowTangentT : TEXCOORD14;
	centroid float2 shadowBaseLightmapUV : TEXCOORD15;
	nointerpolation float2 shadowVertexLightmapUV : TEXCOORD16;
};
LPREVIEW_PS_OUT HighresLightmap_Finish(LPREVIEW_PS_OUT color)
{ HighresLightmap_Report(); return color; }

LPREVIEW_PS_OUT ShadowMap_Debug( ShadowMapReceiver r, ShadowMapDirect d, LPREVIEW_PS_OUT o )
{
	o.color = ShadowMap_Debug( r, d, o.color );
	return o;
}

PS_INPUT DX12ConvertInput( DX12_PS_INPUT dx12In )
{
	PS_INPUT l = (PS_INPUT)0;
#if SEAMLESS
#if ( ( SEAMLESS ) )
	l.SeamlessTexCoord = dx12In.SeamlessTexCoord;
#endif
#if ( !( SEAMLESS ) )
	l.SeamlessTexCoord.xy = dx12In.baseTexCoord;
#endif
#if ( ( SEAMLESS ) ) || ( !( SEAMLESS ) && !( RELIEF_MAPPING ) )
	l.detailOrBumpAndEnvmapMaskTexCoord = dx12In.detailOrBumpAndEnvmapMaskTexCoord;
#endif
#if ( !( SEAMLESS ) && ( RELIEF_MAPPING ) )
	l.detailOrBumpAndEnvmapMaskTexCoord.xyz = dx12In.TangentSpaceViewRay;
#endif
#else
#if ( ( SEAMLESS ) )
	l.baseTexCoord = ( dx12In.SeamlessTexCoord ).xy;
#endif
#if ( !( SEAMLESS ) )
	l.baseTexCoord = dx12In.baseTexCoord;
#endif
#if ( RELIEF_MAPPING == 0 )
#if ( ( SEAMLESS ) ) || ( !( SEAMLESS ) && !( RELIEF_MAPPING ) )
	l.detailOrBumpAndEnvmapMaskTexCoord = dx12In.detailOrBumpAndEnvmapMaskTexCoord;
#endif
#if ( !( SEAMLESS ) && ( RELIEF_MAPPING ) )
	l.detailOrBumpAndEnvmapMaskTexCoord.xyz = dx12In.TangentSpaceViewRay;
#endif
#endif
#endif
	l.lightmapTexCoord1And2 = dx12In.lightmapTexCoord1And2;
#define MASKEDBLENDING ( cComboFold[0].x )
#define BASETEXTURE2 ( cComboFold[0].y )
#define DETAILTEXTURE ( cComboFold[0].z )
#define BUMPMAP ( cComboFold[0].w )
#define BUMPMAP2 ( cComboFold[1].x )
#define CUBEMAP ( cComboFold[1].y )
#define ENVMAPMASK ( cComboFold[1].z )
#define BASEALPHAENVMAPMASK ( cComboFold[1].w )
#define SELFILLUM ( cComboFold[2].x )
#define NORMALMAPALPHAENVMAPMASK ( cComboFold[2].y )
#define DIFFUSEBUMPMAP ( cComboFold[2].z )
#define BASETEXTURENOENVMAP ( cComboFold[2].w )
#define BASETEXTURE2NOENVMAP ( cComboFold[3].x )
#define WARPLIGHTING ( cComboFold[3].y )
#define FANCY_BLENDING ( cComboFold[3].z )
#define OUTLINE ( cComboFold[3].w )
#define SOFTEDGES ( cComboFold[4].x )
#define BUMPMASK ( cComboFold[4].y )
#define DETAIL_BLEND_MODE ( cComboFold[4].z )
#define FASTPATHENVMAPCONTRAST ( cComboFold[4].w )
#define FASTPATH ( cComboFold[5].x )
#define WRITEWATERFOGTODESTALPHA ( cComboFold[5].y )
#define PIXELFOGTYPE ( cComboFold[5].z )
#define WRITE_DEPTH_TO_DESTALPHA ( cComboFold[5].w )
#define BICUBIC_LIGHTMAP ( cComboFold[6].x )
	l.lightmapTexCoord3 = dx12In.lightmapTexCoord3;
	l.worldPos_projPosZ = dx12In.worldPos_projPosZ;
	l.tangentSpaceTranspose = dx12In.tangentSpaceTranspose;
	l.vertexColor = dx12In.vertexColor;
	l.vertexBlendX_fogFactorW = dx12In.vertexBlendX_fogFactorW;
	return l;
}


#if LIGHTING_PREVIEW == 2
LPREVIEW_PS_OUT main( DX12_PS_INPUT dx12In )
#else
HALF4 main( DX12_PS_INPUT dx12In ) : SV_Target0
#endif
{
	PS_INPUT i = DX12ConvertInput( dx12In );
#if 1
	HlightReceiver hlr = HighresLightmap_Begin( dx12In.shadowBaseLightmapUV, dx12In.shadowVertexLightmapUV );
 ShadowMapReceiver smr = ShadowMap_BeginReceiver( dx12In.worldPos, dx12In.worldNormal, dx12In.svPos.xy );
 smr.bakedSunVisibility = hlr.sun;
 ShadowMap_SetBakedFace( smr, hlr.faceId, hlr.q, hlr.localVisibilityEligible, hlr.bakedDirectEligible, hlr.unbakedLocalRange );
	ShadowMapDirect smd = ShadowMap_NoDirect();
	ShadowMapShading sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
#endif

	bool bBaseTexture2 = BASETEXTURE2 != 0;
	bool bDetailTexture = DETAILTEXTURE != 0;
	bool bBumpmap = BUMPMAP != 0;
	bool bDiffuseBumpmap = DIFFUSEBUMPMAP != 0;
	bool bCubemap = CUBEMAP != 0;
	bool bEnvmapMask = ENVMAPMASK != 0;
	bool bBaseAlphaEnvmapMask = BASEALPHAENVMAPMASK != 0;
	bool bSelfIllum = SELFILLUM != 0;
	bool bNormalMapAlphaEnvmapMask = NORMALMAPALPHAENVMAPMASK != 0;
	bool bBaseTextureNoEnvmap = BASETEXTURENOENVMAP != 0;
	bool bBaseTexture2NoEnvmap = BASETEXTURE2NOENVMAP != 0;
	HALF3 envmapContrast = USE_FAST_PATH ? HALF3( FASTPATHENVMAPCONTRAST, FASTPATHENVMAPCONTRAST, FASTPATHENVMAPCONTRAST ) : g_EnvmapContrast;
	HALF3 envmapSaturation = USE_FAST_PATH ? HALF3( 1.0f, 1.0f, 1.0f ) : g_EnvmapSaturation;
	HALF fresnelReflection = USE_FAST_PATH ? 1.0f : g_FresnelReflectionReg.a;
	HALF oneMinusFresnelReflection = USE_FAST_PATH ? 0.0f : g_FresnelReflectionReg.b;
	HALF4 selfIllumTint = USE_FAST_PATH ? HALF4( 1.0f, 1.0f, 1.0f, 1.0f ) : g_SelfIllumTint;

	float4 baseColor = 0.0f;
	float4 baseColor2 = 0.0f;
	float4 vNormal = float4( 0, 0, 1, 1 );
	float3 baseTexCoords = float3( 0, 0, 0 );
#if SEAMLESS
	baseTexCoords = i.SeamlessTexCoord.xyz;
#else
	baseTexCoords.xy = i.baseTexCoord.xy;
#endif
	GetBaseTextureAndNormal( BaseTextureSampler, BaseTextureSampler2, BumpmapSampler, bBaseTexture2, bBumpmap || bNormalMapAlphaEnvmapMask,
		baseTexCoords, i.vertexColor.rgb, baseColor, baseColor2, vNormal );
	if ( BUMPMAP == 1 )
	{
		vNormal.xyz = vNormal.xyz * 2.0f - 1.0f;
	}

	HALF3 lightmapColor1 = HALF3( 1.0f, 1.0f, 1.0f );
	HALF3 lightmapColor2 = HALF3( 1.0f, 1.0f, 1.0f );
	HALF3 lightmapColor3 = HALF3( 1.0f, 1.0f, 1.0f );
#if LIGHTING_PREVIEW == 0
	if( bBumpmap && bDiffuseBumpmap )
	{
		HALF2 bumpCoord1;
		HALF2 bumpCoord2;
		HALF2 bumpCoord3;
		ComputeBumpedLightmapCoordinates( i.lightmapTexCoord1And2, i.lightmapTexCoord3.xy,
			bumpCoord1, bumpCoord2, bumpCoord3 );
		lightmapColor1 = HighresLightmap_Plane( hlr, 1, LightmapSampler.tex.Sample( LightmapSampler.smp, bumpCoord1 ) ).rgb;
		lightmapColor2 = HighresLightmap_Plane( hlr, 2, LightmapSampler.tex.Sample( LightmapSampler.smp, bumpCoord2 ) ).rgb;
		lightmapColor3 = HighresLightmap_Plane( hlr, 3, LightmapSampler.tex.Sample( LightmapSampler.smp, bumpCoord3 ) ).rgb;
	}
	else
	{
		HALF2 bumpCoord1 = ComputeLightmapCoordinates( i.lightmapTexCoord1And2, i.lightmapTexCoord3.xy );
		lightmapColor1 = HighresLightmap_Plane( hlr, 0, LightmapSampler.tex.Sample( LightmapSampler.smp, bumpCoord1 ) ).rgb;
	}
#endif

#if RELIEF_MAPPING
	HALF2 detailTexCoord = baseTexCoords.xy;
	HALF2 bumpmapTexCoord = baseTexCoords.xy;
	HALF2 bumpmap2TexCoord = baseTexCoords.xy;
	HALF2 envmapMaskTexCoord = baseTexCoords.xy;
#else
	HALF2 detailTexCoord = 0.0f;
	HALF2 bumpmapTexCoord = i.detailOrBumpAndEnvmapMaskTexCoord.xy;
	HALF2 bumpmap2TexCoord = i.detailOrBumpAndEnvmapMaskTexCoord.wz;
	HALF2 envmapMaskTexCoord = i.detailOrBumpAndEnvmapMaskTexCoord.wz;
	if ( DETAILTEXTURE == 1 )
	{
		detailTexCoord = i.detailOrBumpAndEnvmapMaskTexCoord.xy;
		bumpmapTexCoord = baseTexCoords.xy;
	}
#endif

	HALF4 detailColor = HALF4( 1.0f, 1.0f, 1.0f, 1.0f );
	if ( DETAILTEXTURE )
	{
		detailColor = float4( g_DetailTint, 1.0f ) * DetailSampler.tex.Sample( DetailSampler.smp, detailTexCoord );
	}
	if ( OUTLINE || SOFTEDGES )
	{
		float distAlphaMask = baseColor.a;
		if ( OUTLINE )
		{
			if ( ( distAlphaMask >= OUTLINE_MIN_VALUE0 ) && ( distAlphaMask <= OUTLINE_MAX_VALUE1 ) )
			{
				float oFactor = 1.0f;
				if ( distAlphaMask <= OUTLINE_MIN_VALUE1 )
				{
					oFactor = smoothstep( OUTLINE_MIN_VALUE0, OUTLINE_MIN_VALUE1, distAlphaMask );
				}
				else
				{
					oFactor = smoothstep( OUTLINE_MAX_VALUE1, OUTLINE_MAX_VALUE0, distAlphaMask );
				}
				baseColor = lerp( baseColor, OUTLINE_COLOR, oFactor );
			}
		}
		if ( SOFTEDGES )
		{
			baseColor.a *= smoothstep( SOFT_MASK_MAX, SOFT_MASK_MIN, distAlphaMask );
		}
		else
		{
			baseColor.a *= distAlphaMask >= 0.5f;
		}
	}
#if LIGHTING_PREVIEW == 2
	baseColor.xyz = GammaToLinear( baseColor.xyz );
#endif
	float blendedAlpha = baseColor.a;
	float blendfactor = MASKEDBLENDING ? 0.5f : i.vertexBlendX_fogFactorW.r;
	if( bBaseTexture2 )
	{
		if ( ( SELFILLUM == 0 ) && ( PIXELFOGTYPE != PIXEL_FOG_TYPE_HEIGHT ) && FANCY_BLENDING )
		{
			float4 modt = BlendModulationSampler.tex.Sample( BlendModulationSampler.smp, i.lightmapTexCoord3.zw );
			if ( MASKEDBLENDING )
			{
				blendfactor = modt.g;
			}
			else
			{
				float minb = saturate( modt.g - modt.r );
				float maxb = saturate( modt.g + modt.r );
				blendfactor = smoothstep( minb, maxb, blendfactor );
			}
		}
		baseColor.rgb = lerp( baseColor.rgb, baseColor2.rgb, blendfactor );
		blendedAlpha = lerp( baseColor.a, baseColor2.a, blendfactor );
	}

	HALF3 specularFactor = 1.0f;
	float4 vNormalMask = float4( 0, 0, 1, 1 );
	if( bBumpmap )
	{
		if( bBaseTextureNoEnvmap )
		{
			vNormal.a = 0.0f;
		}
		if ( BUMPMAP2 == 1 )
		{
			HALF2 b2TexCoord = BUMPMASK ? bumpmap2TexCoord : bumpmapTexCoord;
			HALF4 vNormal2;
			if ( BUMPMAP == 2 )
			{
				vNormal2 = BumpmapSampler2.tex.Sample( BumpmapSampler2.smp, b2TexCoord );
			}
			else
			{
				vNormal2 = DecompressNormal( BumpmapSampler2, b2TexCoord, NORMAL_DECODE_MODE, AlphaMapSampler2 );
			}
			if( bBaseTexture2NoEnvmap )
			{
				vNormal2.a = 0.0f;
			}
			if ( BUMPMASK == 1 )
			{
				float3 vNormal1 = DecompressNormal( BumpmapSampler, i.detailOrBumpAndEnvmapMaskTexCoord.xy, NORMALMASK_DECODE_MODE, AlphaMapSampler );
				vNormal.xyz = normalize( vNormal1.xyz + vNormal2.xyz );
				vNormalMask = DecompressNormal( BumpMaskSampler, baseTexCoords.xy, NORMALMASK_DECODE_MODE, AlphaMaskSampler );
				vNormal.xyz = lerp( vNormalMask.xyz, vNormal.xyz, vNormalMask.a );
				specularFactor = vNormalMask.a;
			}
			else if ( FANCY_BLENDING && bNormalMapAlphaEnvmapMask )
			{
				vNormal = lerp( vNormal, vNormal2, blendfactor );
			}
			else
			{
				vNormal.xyz = lerp( vNormal.xyz, vNormal2.xyz, blendfactor );
			}
		}
		if( bNormalMapAlphaEnvmapMask )
		{
			specularFactor *= vNormal.a;
		}
	}
	else if ( bNormalMapAlphaEnvmapMask )
	{
		specularFactor *= vNormal.a;
	}
	if ( BUMPMAP2 == 0 && bEnvmapMask )
	{
		specularFactor *= BumpmapSampler2.tex.Sample( BumpmapSampler2.smp, envmapMaskTexCoord ).xyz;
	}
	if( bBaseAlphaEnvmapMask )
	{
		specularFactor *= 1.0f - blendedAlpha;
	}
	float4 albedo = baseColor;
	float alpha = 1.0f;
	if( !bBaseAlphaEnvmapMask && !bSelfIllum )
	{
		alpha *= baseColor.a;
	}
	if( bDetailTexture )
	{
		albedo = TextureCombine( albedo, detailColor, DETAIL_BLEND_MODE, g_DetailBlendFactor );
	}
#if ( SEAMLESS == 0 )
	albedo.xyz *= i.vertexColor;
#endif
	alpha *= i.vertexColor.a * g_flAlpha2;

	HALF3 diffuseLighting;
	if( bBumpmap && bDiffuseBumpmap )
	{
		if ( BUMPMAP == 2 )
		{
			diffuseLighting = vNormal.x * lightmapColor1 +
				vNormal.y * lightmapColor2 + vNormal.z * lightmapColor3;
			diffuseLighting *= (cHlightRoute.x != 0 ? g_ShadowDirectTint : g_TintValuesAndLightmapScale.rgb);
	// Selected direct: decoded linear units, before albedo/output.
	sms = ShadowMap_ShadeBumped( mul( bumpBasis[0], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[1], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[2], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), vNormal.xyz );
			vNormal.xyz = normalize( bumpBasis[0] * vNormal.x + bumpBasis[1] * vNormal.y + bumpBasis[2] * vNormal.z );
		}
		else
		{
			float3 dp;
			dp.x = saturate( dot( vNormal, bumpBasis[0] ) );
			dp.y = saturate( dot( vNormal, bumpBasis[1] ) );
			dp.z = saturate( dot( vNormal, bumpBasis[2] ) );
			dp *= dp;
			if ( DETAIL_BLEND_MODE == TCOMBINE_SSBUMP_BUMP )
			{
				dp *= 2 * detailColor;
			}
			diffuseLighting = dp.x * lightmapColor1 + dp.y * lightmapColor2 + dp.z * lightmapColor3;
			float sum = dot( dp, float3( 1.0f, 1.0f, 1.0f ) );
			diffuseLighting *= (cHlightRoute.x != 0 ? g_ShadowDirectTint : g_TintValuesAndLightmapScale.rgb) / sum;
	// Selected direct: decoded linear units, before albedo/output.
	sms = ShadowMap_ShadeBumped( mul( bumpBasis[0], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[1], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), mul( bumpBasis[2], float3x3( dx12In.shadowTangentS, dx12In.shadowTangentT, dx12In.worldNormal ) ), dp / sum );
		}
	}
	else
	{
		diffuseLighting = lightmapColor1 * (cHlightRoute.x != 0 ? g_ShadowDirectTint : g_TintValuesAndLightmapScale.rgb);
	// Selected direct: decoded linear units, before albedo/output.
	sms = ShadowMap_ShadeLambert( dx12In.worldNormal );
	}
	// Selected direct: decoded linear units, before albedo/output.
#if 1
	smd = ShadowMap_GatherDirect( smr, sms );
	diffuseLighting += (smd.diffuse * hlr.valid) * g_ShadowDirectTint;
#endif
#if ( SEAMLESS == 0 )
	if ( WARPLIGHTING )
	{
		float len = 0.5f * length( diffuseLighting );
		diffuseLighting *= 2.0f * WarpLightingSampler.tex.Sample( WarpLightingSampler.smp, float2( len, 0 ) );
	}
#endif
	float3 worldSpaceNormal = mul( vNormal, i.tangentSpaceTranspose );
	float3 diffuseComponent = albedo.xyz * diffuseLighting;
	if( bSelfIllum )
	{
		float3 selfIllumComponent = selfIllumTint.rgb * albedo.xyz;
		diffuseComponent = lerp( diffuseComponent, selfIllumComponent, baseColor.a );
	}
	HALF3 specularLighting = HALF3( 0.0f, 0.0f, 0.0f );
	if( bCubemap )
	{
		float3 worldVertToEyeVector = g_EyePos - i.worldPos_projPosZ.xyz;
		float3 reflectVect = CalcReflectionVectorUnnormalized( worldSpaceNormal, worldVertToEyeVector );
		half3 eyeVect = normalize( worldVertToEyeVector );
		HALF fresnel = 1.0f - dot( worldSpaceNormal, eyeVect );
		fresnel = pow( fresnel, 5.0f );
		fresnel = fresnel * oneMinusFresnelReflection + fresnelReflection;
		specularLighting = ENV_MAP_SCALE * EnvmapSampler.tex.Sample( EnvmapSampler.smp, reflectVect );
		specularLighting *= specularFactor;
		specularLighting *= g_EnvmapTint;
		if ( FANCY_BLENDING == 0 )
		{
			HALF3 specularLightingSquared = specularLighting * specularLighting;
			specularLighting = lerp( specularLighting, specularLightingSquared, envmapContrast );
			HALF3 greyScale = dot( specularLighting, HALF3( 0.299f, 0.587f, 0.114f ) );
			specularLighting = lerp( greyScale, specularLighting, envmapSaturation );
		}
		specularLighting *= fresnel;
	}
	HALF3 result = diffuseComponent + specularLighting;
#if LIGHTING_PREVIEW
	worldSpaceNormal = mul( vNormal, i.tangentSpaceTranspose );
#if LIGHTING_PREVIEW == 1
	float dotprod = 0.7f + 0.25f * dot( worldSpaceNormal, normalize( float3( 1, 2, -.5f ) ) );
	
#if 1
	{
	float4 dx12Lit0_0 = DX12FinishPixel( FinalOutput( HALF4( dotprod * albedo.xyz, alpha ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_0 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( FinalOutput( HALF4( dotprod * albedo.xyz, alpha ), 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), dx12In.fog ) );
#endif

#else
	LPREVIEW_PS_OUT ret;
	ret.color = float4( albedo.xyz, alpha );
	ret.normal = float4( worldSpaceNormal, alpha );
	ret.position = float4( i.worldPos_projPosZ.xyz, alpha );
	ret.flags = float4( 1, 1, 1, alpha );
	
#if 1
	{
	LPREVIEW_PS_OUT dx12Lit0_1 = DX12FinishPixel( FinalOutput( ret, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_1 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( FinalOutput( ret, 0, PIXEL_FOG_TYPE_NONE, TONEMAP_SCALE_NONE ), dx12In.fog ) );
#endif

#endif
#else
	bool bWriteDepthToAlpha = ( WRITE_DEPTH_TO_DESTALPHA != 0 ) && ( WRITEWATERFOGTODESTALPHA == 0 );
	float fogFactor = CalcPixelFogFactor( PIXELFOGTYPE, g_FogParams, g_EyePos.xyz, i.worldPos_projPosZ.xyz, i.worldPos_projPosZ.w );
	if ( WRITEWATERFOGTODESTALPHA && ( PIXELFOGTYPE == PIXEL_FOG_TYPE_HEIGHT ) )
	{
		alpha = fogFactor;
	}
	
#if 1
	{
	float4 dx12Lit0_2 = DX12FinishPixel( FinalOutput( float4( result.rgb, alpha ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, i.worldPos_projPosZ.w ), dx12In.fog );
	return HighresLightmap_Finish( ShadowMap_Debug( smr, smd, dx12Lit0_2 ) );
	}
#else
	return HighresLightmap_Finish( DX12FinishPixel( FinalOutput( float4( result.rgb, alpha ), fogFactor, PIXELFOGTYPE, TONEMAP_SCALE_LINEAR, bWriteDepthToAlpha, i.worldPos_projPosZ.w ), dx12In.fog ) );
#endif

#endif
}
