//-----------------------------------------------------------------------------
// L4D2 game shader module. Uses the native SDK shader extension pipeline.
//-----------------------------------------------------------------------------
$Macro SRCDIR "..\.."
$Macro OUTBINNAME "game_shader_generic_l4d2"
$Macro GAMENAME "mod_l4d2"
$Macro OUTBINDIR "$SRCDIR\..\game\$GAMENAME\bin"
$Macro L4D2_SHADER_GAME_DIR "$([MSBuild]::ValueOrDefault(`$(L4D2ShaderGameDir)`, `$(ProjectDir)..\..\..\game\mod_l4d2`))"

$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration "Debug"
{
	$General
	{
		$OutputDirectory "Debug_dx9_$GAMENAME" [$WINDOWS]
		$IntermediateDirectory "Debug_dx9_$GAMENAME" [$WINDOWS]
	}
}

$Configuration "Release"
{
	$General
	{
		$OutputDirectory "Release_dx9_$GAMENAME" [$WINDOWS]
		$IntermediateDirectory "Release_dx9_$GAMENAME" [$WINDOWS]
	}
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories "$BASE;include"
		// The SDK generic helper needs BaseVSShader's standard HW-morph helpers.
		$PreprocessorDefinitions "$BASE;STDSHADER_DX9_DLL_EXPORT;FAST_MATERIALVAR_ACCESS;L4D2"
		$PreprocessorDefinitions "$BASE;USE_ACTUAL_DX" [$WINDOWS && !$GL]
	}
	$Linker
	{
		$AdditionalDependencies "$BASE version.lib winmm.lib" [$WINDOWS]
	}
}

$Project "Game Shaders (L4D2)"
{
	$Folder "Source Files"
	{
		$File "BaseVSShader.cpp"
		$File "l4d2_vertexlitgeneric.cpp"
		$File "l4d2_vertexlitgeneric_dx9_helper.cpp"
		$File "l4d2_unlitgeneric.cpp"
		$File "l4d2_unlitgeneric_dx9_helper.cpp"
		$File "l4d2_unlittwotexture.cpp"
		$File "cloak_blended_pass_helper.cpp"
		$File "skin_dx9_helper.cpp"
		$File "l4d2_phong_dx9_helper.cpp"
		$File "l4d2_water.cpp"
		$File "l4d2_lightmappedgeneric.cpp"
		$File "l4d2_worldvertextransition.cpp"
		$File "l4d2_lightmappedgeneric_dx9_helper.cpp"
		$File "infected.cpp"
		$File "infected_dx9.cpp"
		$File "terror_spritecard.cpp"
		$File "l4d2_glow.cpp"
		$File "terror_engine_post.cpp"
		$File "terror_post_prepare.cpp"
		$File "terror_fade_blur.cpp"
		$File "splinerope.cpp"
		$File "terror_depth_of_field.cpp"
	}
	$Folder "Header Files"
	{
		$File "BaseVSShader.h"
		$File "l4d2_vertexlitgeneric_dx9_helper.h"
		$File "l4d2_phong_dx9_helper.h"
		$File "l4d2_lightmappedgeneric_dx9_helper.h"
		$File "l4d2_lightmappedgeneric_fxc.h"
		$File "l4d2_model_flashlight_fxc.h"
		$File "l4d2_tree_sway.h"
		$File "common_fxc.h"
		$File "common_ps_fxc.h"
		$File "common_vs_fxc.h"
	}
	$Folder "Link Libraries"
	{
		$Lib mathlib
		$Lib shaderlib
		$Lib tier2
	}
	$File "buildshaders.bat"
	$File "l4d2_shaders_dx9_20.txt"
	$File "build_l4d2_ps20.py"
	$File "buildl4d2shaders.bat" [$WINDOWS]
	{
		$Configuration
		{
			$CustomBuildStep
			{
				$Description "Building game-owned L4D2 VS20, PS20 and PS20b shader programs"
				$CommandLine "call $QUOTE$(ProjectDir)buildl4d2shaders.bat$QUOTE $QUOTE$L4D2_SHADER_GAME_DIR$QUOTE"
				$Outputs "$L4D2_SHADER_GAME_DIR\shaders\fxc\infected_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\infected_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_spritecard_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_spritecard_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_blurfilter_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_blurfilter_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_downsample_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_downsample_nohdr_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_haloadd_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_haloadd_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_engine_post_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_post_prepare_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\fade_blur_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_splinerope_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_splinerope_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_depth_of_field_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_dof_clearalpha_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\blurgaussian_3x3_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_blurfilter_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_downsample_nohdr_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_glow_haloadd_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_engine_post_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\terror_post_prepare_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\fade_blur_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_splinerope_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\blurgaussian_3x3_ps20.vcs;$(ProjectDir)include\infected_vs20.inc;$(ProjectDir)include\infected_ps20b.inc;$(ProjectDir)include\terror_spritecard_vs20.inc;$(ProjectDir)include\terror_spritecard_ps20b.inc;$(ProjectDir)include\l4d2_glow_blurfilter_vs20.inc;$(ProjectDir)include\l4d2_glow_blurfilter_ps20b.inc;$(ProjectDir)include\l4d2_glow_downsample_vs20.inc;$(ProjectDir)include\l4d2_glow_downsample_nohdr_ps20b.inc;$(ProjectDir)include\l4d2_glow_haloadd_vs20.inc;$(ProjectDir)include\l4d2_glow_haloadd_ps20b.inc;$(ProjectDir)include\terror_engine_post_ps20b.inc;$(ProjectDir)include\terror_post_prepare_ps20b.inc;$(ProjectDir)include\fade_blur_ps20b.inc;$(ProjectDir)include\l4d2_splinerope_vs20.inc;$(ProjectDir)include\l4d2_splinerope_ps20b.inc;$(ProjectDir)include\terror_depth_of_field_ps20b.inc;$(ProjectDir)include\terror_dof_clearalpha_ps20b.inc;$(ProjectDir)include\blurgaussian_3x3_ps20b.inc;$(ProjectDir)include\l4d2_glow_blurfilter_ps20.inc;$(ProjectDir)include\l4d2_glow_downsample_nohdr_ps20.inc;$(ProjectDir)include\l4d2_glow_haloadd_ps20.inc;$(ProjectDir)include\terror_engine_post_ps20.inc;$(ProjectDir)include\terror_post_prepare_ps20.inc;$(ProjectDir)include\fade_blur_ps20.inc;$(ProjectDir)include\l4d2_splinerope_ps20.inc;$(ProjectDir)include\blurgaussian_3x3_ps20.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_phong_vs20.vcs;$(ProjectDir)include\l4d2_phong_vs20.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_phong_ps20b.vcs;$(ProjectDir)include\l4d2_phong_ps20b.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_vertexlit_and_unlit_generic_vs20.vcs;$(ProjectDir)include\l4d2_vertexlit_and_unlit_generic_vs20.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_vertexlit_and_unlit_generic_ps20b.vcs;$(ProjectDir)include\l4d2_vertexlit_and_unlit_generic_ps20b.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_vertexlit_and_unlit_generic_bump_vs20.vcs;$(ProjectDir)include\l4d2_vertexlit_and_unlit_generic_bump_vs20.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_vertexlit_and_unlit_generic_bump_ps20b.vcs;$(ProjectDir)include\l4d2_vertexlit_and_unlit_generic_bump_ps20b.inc;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_black_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_black_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_black_ps20b.vcs;$(ProjectDir)include\l4d2_black_vs20.inc;$(ProjectDir)include\l4d2_black_ps20.inc;$(ProjectDir)include\l4d2_black_ps20b.inc"
				$AdditionalDependencies "$(ProjectDir)infected_vs20.fxc;$(ProjectDir)infected_ps20b.fxc;$(ProjectDir)terror_spritecard_vs20.fxc;$(ProjectDir)terror_spritecard_ps20b.fxc;$(ProjectDir)l4d2_glow_blurfilter_vs20.fxc;$(ProjectDir)l4d2_glow_blurfilter_ps2x.fxc;$(ProjectDir)l4d2_glow_downsample_vs20.fxc;$(ProjectDir)l4d2_glow_downsample_nohdr_ps2x.fxc;$(ProjectDir)l4d2_glow_haloadd_vs20.fxc;$(ProjectDir)l4d2_glow_haloadd_ps2x.fxc;$(ProjectDir)terror_engine_post_ps2x.fxc;$(ProjectDir)terror_post_prepare_ps2x.fxc;$(ProjectDir)fade_blur_ps2x.fxc;$(ProjectDir)l4d2_splinerope_vs20.fxc;$(ProjectDir)l4d2_splinerope_ps2x.fxc;$(ProjectDir)terror_depth_of_field_ps2x.fxc;$(ProjectDir)terror_dof_clearalpha_ps2x.fxc;$(ProjectDir)blurgaussian_3x3_ps2x.fxc;$(ProjectDir)common_vs_fxc.h;$(ProjectDir)common_fxc.h;$(ProjectDir)common_pragmas.h;$(ProjectDir)common_hlsl_cpp_consts.h;$(ProjectDir)common_ps_fxc.h;$(ProjectDir)l4d2_shaders_dx9_20b.txt;$(ProjectDir)l4d2_shaders_dx9_20.txt;$(ProjectDir)build_l4d2_ps20.py;$(ProjectDir)..\..\devtools\bin\ShaderCompile2.exe;$(SystemRoot)\System32\d3dcompiler_47.dll;%(AdditionalInputs);$(ProjectDir)l4d2_phong_vs20.fxc;$(ProjectDir)l4d2_phong_ps20b.fxc;$(ProjectDir)l4d2_vertexlit_and_unlit_generic_vs20.fxc;$(ProjectDir)l4d2_vertexlit_and_unlit_generic_ps2x.fxc;$(ProjectDir)l4d2_vertexlit_and_unlit_generic_bump_vs20.fxc;$(ProjectDir)l4d2_vertexlit_and_unlit_generic_bump_ps2x.fxc;$(ProjectDir)l4d2_model_flashlight_fxc.h;$(ProjectDir)l4d2_tree_sway.h;$(ProjectDir)common_vertexlitgeneric_dx9.h;$(ProjectDir)l4d2_black_vs20.fxc;$(ProjectDir)l4d2_black_ps2x.fxc"
				$Outputs "$BASE;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_water_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_water_ps20b.vcs;$(ProjectDir)include\l4d2_water_vs20.inc;$(ProjectDir)include\l4d2_water_ps20b.inc"
				$AdditionalDependencies "$BASE;$(ProjectDir)l4d2_water_vs20.fxc;$(ProjectDir)l4d2_water_ps20b.fxc"
				$Outputs "$BASE;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_lightmappedgeneric_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_lightmappedgeneric_ps20b.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_lightmappedgeneric_flashlight_vs20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_lightmappedgeneric_flashlight_ps20b.vcs;$(ProjectDir)include\l4d2_lightmappedgeneric_vs20.inc;$(ProjectDir)include\l4d2_lightmappedgeneric_ps20b.inc;$(ProjectDir)include\l4d2_lightmappedgeneric_flashlight_vs20.inc;$(ProjectDir)include\l4d2_lightmappedgeneric_flashlight_ps20b.inc"
				$AdditionalDependencies "$BASE;$(ProjectDir)l4d2_lightmappedgeneric_vs20.fxc;$(ProjectDir)l4d2_lightmappedgeneric_ps20b.fxc;$(ProjectDir)l4d2_lightmappedgeneric_flashlight_vs20.fxc;$(ProjectDir)l4d2_lightmappedgeneric_flashlight_ps20b.fxc;$(ProjectDir)l4d2_lightmappedgeneric_fxc.h;$(ProjectDir)l4d2_model_flashlight_fxc.h"
				$Outputs "$BASE;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_unlittwotexture_ps20.vcs;$L4D2_SHADER_GAME_DIR\shaders\fxc\l4d2_unlittwotexture_ps20b.vcs;$(ProjectDir)include\l4d2_unlittwotexture_ps20.inc;$(ProjectDir)include\l4d2_unlittwotexture_ps20b.inc"
				$AdditionalDependencies "$BASE;$(ProjectDir)l4d2_unlittwotexture_ps2x.fxc"
			}
		}
	}
	$Shaders "l4d2_shaders_dx9_20b.txt"
}
