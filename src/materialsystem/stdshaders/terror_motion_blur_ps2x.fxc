// Original motion_blur_ps20/ps20b cache SHA256 6a5ddd9d5591118d, source CRC80B569C1.
// Both native caches are identical: QUALITY0..14 uses one through fifteen taps.
// DYNAMIC: "QUALITY" "0..14"
sampler2D FrameBuffer : register( s0 );
float MaximumMotionBlur : register( c0 );
float4 MotionBlur : register( c1 );
float4 MotionBlurViewport : register( c2 );

float4 main( float2 uv : TEXCOORD0 ) : COLOR
{
#if QUALITY == 0
	return float4( tex2D( FrameBuffer, uv ).rgb, 1.0f );
#else
	float2 radial = uv * 2.0f - 1.0f;
	float2 roll = float2( radial.y, -radial.x );
	float2 falling = radial * dot( radial, radial ) * -abs( MotionBlur.z );
	float2 blur = roll * MotionBlur.w + ( float2( MotionBlur.x, -MotionBlur.y ) + falling );
	if ( length( blur ) > MaximumMotionBlur ) blur = normalize( blur ) * MaximumMotionBlur;
	// Clamp the final endpoint ONCE, then distribute samples along that shortened
	// segment. Clamping every original-length tap produces different edge weights.
	float2 endpoint = min( max( uv + blur, MotionBlurViewport.xy ), MotionBlurViewport.wz );
#if QUALITY == 1
	float3 color = tex2D( FrameBuffer, endpoint ).rgb * 0.5f;
	color = tex2D( FrameBuffer, uv ).rgb * 0.5f + color;
#else
	const float weight = 1.0f / ( QUALITY + 1 );
	const float inverseQuality = 1.0f / QUALITY;
	float2 segment = endpoint - uv;
	float3 color = tex2D( FrameBuffer, uv + segment * inverseQuality ).rgb * weight;
	color = tex2D( FrameBuffer, uv ).rgb * weight + color;
	[unroll]
	for ( int tap = 2; tap < QUALITY; ++tap )
		color = tex2D( FrameBuffer, uv + segment * ( (float)tap / QUALITY ) ).rgb * weight + color;
	color = tex2D( FrameBuffer, endpoint ).rgb * weight + color;
#endif
	// The native bytecode has no FinalOutput, output-sRGB or second tonemap.
	return float4( color, 1.0f );
#endif
}
