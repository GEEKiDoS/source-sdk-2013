// Native downsample_vs20; c48-c51 are back-buffer-relative tap offsets.
float2 g_vVsTapOffset[4] : register( c48 );

struct VS_INPUT
{
	float3 position : POSITION;
	float2 texCoord : TEXCOORD0;
};

struct VS_OUTPUT
{
	float4 position : POSITION;
	float2 coordTap0 : TEXCOORD0;
	float2 coordTap1 : TEXCOORD1;
	float2 coordTap2 : TEXCOORD2;
	float2 coordTap3 : TEXCOORD3;
};

VS_OUTPUT main( VS_INPUT i )
{
	VS_OUTPUT o;
	o.position = float4( i.position, 1.0f );
	o.coordTap0 = i.texCoord + g_vVsTapOffset[0];
	o.coordTap1 = i.texCoord + g_vVsTapOffset[1];
	o.coordTap2 = i.texCoord + g_vVsTapOffset[2];
	o.coordTap3 = i.texCoord + g_vVsTapOffset[3];
	return o;
}
