// DLSS-NR snippet forwarder. The output name must contain "nvngx.dll": nvngx_dlssnr.dll only accepts calls whose
// return address lies in such a module. No engine libraries: the DLL only forwards the snippet's D3D12 calls.
$Macro SRCDIR "..\..\.."
$Macro OUTBINNAME "nvngx.dll_dlssnr_dx12"
$Macro OUTBINDIR "$SRCDIR\..\game\bin"
$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
    $Compiler
    {
        $Create/UsePrecompiledHeader "Not Using Precompiled Headers"
        $ForceIncludes " "
        $AdditionalOptions "$BASE /std:c++17"
    }
}

$Project "nvngx_forwarder_dx12"
{
    $Folder "Source Files"
    {
        -$File "$SRCDIR\public\tier0\memoverride.cpp"
        -$File "$SRCDIR\public\tier0\pointeroverride.asm"
        $File "nvngx_forwarder_dx12.cpp"
    }
    $Folder "Link Libraries"
    {
        -$Implib "$LIBPUBLIC\tier0"
        -$Lib "$LIBPUBLIC\tier1"
        -$Implib "$LIBPUBLIC\vstdlib"
    }
}
