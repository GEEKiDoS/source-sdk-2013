// Native DirectX 12 backend. Registered only for Windows x64.
$Macro SRCDIR "..\.."
$Macro OUTBINNAME "shaderapidx12"
$Macro OUTBINDIR "$SRCDIR\..\game\bin"
$Include "$SRCDIR\vpc_scripts\source_dll_base.vpc"

$Configuration
{
    $General
    {
        $AdditionalProjectDependencies "tier1;mathlib;dx12_shaderconv"
    }
    $Compiler
    {
        $AdditionalIncludeDirectories "$BASE;$SRCDIR;$SRCDIR\thirdparty\tracy\public;$SRCDIR\thirdparty\upscalers\xess\inc;$SRCDIR\thirdparty\upscalers\fidelityfx2\include;$SRCDIR\thirdparty\upscalers\ngx\include;$SRCDIR\thirdparty\upscalers\streamline\include"
        $AdditionalOptions "$BASE /std:c++17"
        $EnableC++Exceptions "Yes (/EHsc)"
        $Create/UsePrecompiledHeader "Not Using Precompiled Headers"
        $ForceIncludes " "
        $PreprocessorDefinitions "$BASE;NOMINMAX;SHADERAPIDX12_EXPORTS;TRACY_ENABLE;TRACY_ON_DEMAND;TRACY_DELAYED_INIT;TRACY_MANUAL_LIFETIME"
    }
    $Linker
    {
        $AdditionalDependencies "$BASE d3d12.lib dxgi.lib dxguid.lib d3dcompiler.lib version.lib bcrypt.lib"
    }
    // Runtime DLLs the renderer loads beside itself. dxbcSigner.dll is required and in the tree; the upscaler
    // runtimes are supplied locally (thirdparty\upscalers\README.txt) and copied only when present.
    $PostBuildEvent
    {
        $CommandLine "$BASE" "\n" \
            "copy /y $QUOTE$SRCDIR\thirdparty\dx12_shaderconv\dxbcsigner\dxbcSigner.dll$QUOTE $QUOTE$OUTBINDIR$QUOTE" "\n" \
            "if errorlevel 1 exit /b 1" "\n" \
            "for %%D in (xess fidelityfx2 ngx dlssnr streamline) do for %%F in ($QUOTE$SRCDIR\thirdparty\upscalers\%%D\redist\*.dll$QUOTE) do (" "\n" \
            "    copy /y $QUOTE%%F$QUOTE $QUOTE$OUTBINDIR$QUOTE" "\n" \
            "    if errorlevel 1 exit /b 1" "\n" \
            ")" "\n"
    }
}
$Project "shaderapidx12"
{
    $Folder "Source Files"
    {
        $File "$SRCDIR\thirdparty\tracy\public\TracyClient.cpp"
        $File "shaderapidx12.cpp"
        $File "shaderdevice_dx12.cpp"
        $File "hardwareconfig_dx12.cpp"
        $File "dxsupport_dx12.cpp"
        $File "resources_dx12.cpp"
        $File "bindings_dx12.cpp"
        $File "pipeline_dx12.cpp"
        $File "textures_dx12.cpp"
        $File "shaderapi_dx12.cpp"
        $File "shadershadow_dx12.cpp"
        $File "fixed_function_dx12.cpp"
        $File "shader_state_dx12.cpp"
        $File "shader_vcs_dx12.cpp"
        $File "shader_precache_dx12.cpp"
        $File "motion_vectors_dx12.cpp"
        $File "lighting_dx12.cpp"
        $File "highres_lightmaps_dx12.cpp"
        $File "hlight_engine_bridge.cpp"
        $File "$SRCDIR\public\zip_utils.cpp"
        $File "upscaler_dx12.cpp"
        $File "compute_dx12.cpp"
        $File "framegen_dx12.cpp"
        $File "framegen_sl_dx12.cpp"
        $File "mesh_dx12.cpp"
        $File "vertex_layout_dx12.cpp"
        $File "vballoctracker_dx12.cpp"
    }
    $Folder "Native Entry Hooks"
    {
        $File "$SRCDIR\thirdparty\minhook\src\hook.c"
        {
            $Configuration
            {
                $Compiler
                {
                    $AdditionalOptions "/std:c17"
                }
            }
        }
        $File "$SRCDIR\thirdparty\minhook\src\buffer.c"
        {
            $Configuration
            {
                $Compiler
                {
                    $AdditionalOptions "/std:c17"
                }
            }
        }
        $File "$SRCDIR\thirdparty\minhook\src\trampoline.c"
        {
            $Configuration
            {
                $Compiler
                {
                    $AdditionalOptions "/std:c17"
                }
            }
        }
        $File "$SRCDIR\thirdparty\minhook\src\hde\hde64.c"
        {
            $Configuration
            {
                $Compiler
                {
                    $AdditionalOptions "/std:c17"
                }
            }
        }
    }
    $Folder "Header Files"
    {
        $File "shaderdevice_dx12.h"
        $File "hardwareconfig_dx12.h"
        $File "dxsupport_dx12.h"
        $File "resources_dx12.h"
        $File "bindings_dx12.h"
        $File "pipeline_dx12.h"
        $File "textures_dx12.h"
        $File "shaderapi_dx12.h"
        $File "shadershadow_dx12.h"
        $File "fixed_function_dx12.h"
        $File "shader_state_dx12.h"
        $File "shader_vcs_dx12.h"
        $File "native_cbuffer_dx12.h"
        $File "native_engine_cbuffers_dx12.h"
        $File "shader_translate_dx12.h"
        $File "mesh_dx12.h"
        $File "vertex_layout_dx12.h"
        $File "vballoctracker_dx12.h"
        $File "motion_vectors_dx12.h"
        $File "lighting_dx12.h"
        $File "staticprop_visibility_dx12.h"
        $File "highres_lightmaps_dx12.h"
        $File "hlight_engine_bridge.h"
        $File "$SRCDIR\public\hlight_bsp.h"
        $File "$SRCDIR\public\shaderapi\ishaderapidx12highres.h"
        $File "$SRCDIR\public\shaderapi\ishaderapidx12lighting.h"
        $File "upscaler_dx12.h"
        $File "framegen_dx12.h"
        $File "provider_module_dx12.h"
        $File "upscaler_nr_shaders_dx12.h"
    }
    $Folder "Link Libraries"
    {
        $Lib mathlib
        $Lib tier2
        $Lib dx12_shaderconv
        $Lib "$LIBCOMMON\bzip2"
    }
}
