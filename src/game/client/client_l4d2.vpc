//-----------------------------------------------------------------------------
//	CLIENT_L4D2.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"mod_l4d2"

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$PreprocessorDefinitions			"$BASE;L4D2;NEXT_BOT"
	}
	$Linker
	{
		$AdditionalDependencies		"$BASE;Gdi32.lib;Bcrypt.lib"
	}
}

$Project "Client (L4D2)"
{
	$Folder	"Source Files"
	{
		// Use native L4D2 ConVar callback semantics without changing stock tier1.
		$File	"$SRCDIR\tier1\convar.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}

		// L4D2 owns its native SectionedListPanel/CSectionHeader implementation.
		// The shared vgui_controls archive continues to compile the stock variant.
		$File	"$SRCDIR\vgui2\vgui_controls\SectionedListPanel.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$Create/UsePrecompiledHeader	"Not Using Precompiled Headers"
				}
			}
		}

		$File	"$SRCDIR\game\shared\predicted_viewmodel.cpp"
		$File	"$SRCDIR\game\shared\predicted_viewmodel.h"

		$Folder	"NextBot"
		{
			$File	"NextBot\C_NextBot.cpp"
			$File	"NextBot\C_NextBot.h"
		}

		$Folder	"L4D2"
		{
