				{
					$CustomBuildStep
					{
						$CommandLine "$QUOTE$(VCToolsInstallDir)bin\Hostx64\x64\ml64.exe$QUOTE /nologo /c /Cp /Zi /Fo$QUOTE$(IntDir)\$(InputName).obj$QUOTE $QUOTE$(InputPath)$QUOTE"
						$Description "Compiling native client arithmetic"
						$Outputs "$(IntDir)\$(InputName).obj"
					}
				}
			}
